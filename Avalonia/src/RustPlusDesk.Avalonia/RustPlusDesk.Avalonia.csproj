<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The preview's own version: the packaging scripts and the installers read it from here. -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-preview</InformationalVersion>
    <Product>Rust+ Desktop</Product>
    <Company>Rust+ Desktop</Company>
    <Copyright>Copyright (c) Rust+ Desktop contributors</Copyright>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64;osx-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RustPlusDesk.CrossPlatform.Tests" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="../RustPlusDesk.Core/RustPlusDesk.Core.csproj" />
    <ProjectReference Include="../RustPlusDesk.Infrastructure/RustPlusDesk.Infrastructure.csproj" />
    <AvaloniaResource Include="Assets/**" />
    <None Include="../../licenses/FluentAvalonia.LICENSE" Link="licenses/FluentAvalonia.LICENSE"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
