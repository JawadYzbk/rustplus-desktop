<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:servers="using:RustPlusDesk.Avalonia.Features.Servers"
        xmlns:devices="using:RustPlusDesk.Avalonia.Features.Devices"
        xmlns:accounts="using:RustPlusDesk.Avalonia.Features.Accounts"
        xmlns:recycling="using:RustPlusDesk.Avalonia.Features.Recycling" xmlns:raid="using:RustPlusDesk.Avalonia.Features.Raid"
        xmlns:console="using:RustPlusDesk.Avalonia.Features.Console"
        xmlns:notifications="using:RustPlusDesk.Avalonia.Features.Notifications"
        xmlns:toasts="using:RustPlusDesk.Avalonia.Features.Toasts"
        xmlns:settings="using:RustPlusDesk.Avalonia.Features.Settings"
        xmlns:deaths="using:RustPlusDesk.Avalonia.Features.Deaths"
        xmlns:clans="using:RustPlusDesk.Avalonia.Features.Clans"
        xmlns:achievements="using:RustPlusDesk.Avalonia.Features.Achievements"
        xmlns:shell="using:RustPlusDesk.Avalonia.Shell"
        xmlns:cloud="using:RustPlusDesk.Avalonia.Features.Cloud"
        xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
        x:Class="RustPlusDesk.Avalonia.Shell.MainWindow"
        x:DataType="servers:ServersViewModel"
        Title="Rust+ Desktop — Cross-platform preview"
        Icon="/Assets/app.ico" Width="1380" Height="950" MinWidth="1000" MinHeight="700"
        WindowDecorations="Full">
  <Window.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding CloseToolCommand}" /></Window.KeyBindings>
  <Grid RowDefinitions="42,*,26">
    <Grid ColumnDefinitions="*,Auto" Margin="14,0" IsEnabled="{Binding !HasOverlay}">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="/Assets/app.ico" Width="20" Height="20" />
        <TextBlock Text="{DynamicResource AppTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="Avalonia preview" FontSize="11" Classes="muted" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="subtle" Command="{Binding OpenTrafficCommand}" IsVisible="{Binding Traffic, FallbackValue=False}"
                ToolTip.Tip="Show the network traffic of this app" AutomationProperties.Name="Network traffic">
          <Border Classes="pill">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <icons:Icon Symbol="DataTrending24" FontSize="13" />
              <TextBlock Text="{Binding Traffic.Summary, FallbackValue=''}" FontSize="12" />
            </StackPanel>
          </Border>
        </Button>
        <Button Classes="subtle" Command="{Binding OpenAccountCommand}" IsVisible="{Binding RequiresSignIn}" ToolTip.Tip="Open account and pairing">
          <Border Classes="pill" BorderBrush="{DynamicResource ConnectionPending}">
            <TextBlock Text="Sign in for Rust+ pairing" FontSize="12" Foreground="{DynamicResource ConnectionPending}" />
          </Border>
        </Button>
        <Border Classes="pill" IsVisible="{Binding Listener.IsRunning, FallbackValue=False}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource ConnectionSuccess}" VerticalAlignment="Center" />
            <TextBlock Text="Pairing active" FontSize="12" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" IsEnabled="{Binding !HasOverlay}">
      <shell:NavigationRail />
      <SplitView Grid.Column="1" x:Name="WorkspaceSplit" DisplayMode="Inline" IsPaneOpen="{Binding IsSidebarOpen, Mode=TwoWay}" OpenPaneLength="400">
        <SplitView.Pane>
          <Grid ColumnDefinitions="*,4">
            <shell:ServerDevicePane />
            <Thumb Grid.Column="1" DragDelta="ResizeSidebar" KeyDown="ResizeSidebarKeyDown" Focusable="True" Background="{DynamicResource CardBorder}"
                   Cursor="SizeWestEast" AutomationProperties.Name="Resize server and device panel" />
          </Grid>
        </SplitView.Pane>
        <Grid>
          <shell:MapWorkspace x:Name="MapArea" IsVisible="{Binding !IsToolSelected}" />
          <Grid RowDefinitions="Auto,*" Background="{DynamicResource Surface}" IsVisible="{Binding IsRecyclerSelected}">
            <Border Classes="toolbar">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <icons:Icon Symbol="Recycle32" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{DynamicResource AppRecyclingCalculator}" Classes="title" />
                <Button Grid.Column="2" Classes="icon" Command="{Binding CloseToolCommand}" ToolTip.Tip="Close (Esc)"
                        AutomationProperties.Name="Close recycling calculator"><icons:Icon Symbol="Dismiss24" /></Button>
              </Grid>
            </Border>
            <recycling:RecyclerView Grid.Row="1" Margin="16,12,16,16" DataContext="{Binding Recycler}" />
          </Grid>
          <Grid RowDefinitions="Auto,*" Background="{DynamicResource Surface}" IsVisible="{Binding IsRaidSelected}">
            <Border Classes="toolbar">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <icons:Icon Symbol="Rocket24" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{DynamicResource AppRaidCalculator}" Classes="title" />
                <Button Grid.Column="2" Classes="icon" Command="{Binding CloseToolCommand}" ToolTip.Tip="Close (Esc)"
                        AutomationProperties.Name="Close raid calculator"><icons:Icon Symbol="Dismiss24" /></Button>
              </Grid>
            </Border>
            <raid:RaidCalculatorView Grid.Row="1" Margin="16,12,16,16" DataContext="{Binding Raid}" />
          </Grid>
          <Grid RowDefinitions="Auto,*" Background="{DynamicResource Surface}" IsVisible="{Binding IsConsoleSelected}">
            <Border Classes="toolbar">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <icons:Icon Symbol="WindowConsole20" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{DynamicResource AppConsoleHelper}" Classes="title" />
                <Button Grid.Column="2" Classes="icon" Command="{Binding CloseToolCommand}" ToolTip.Tip="Close (Esc)"
                        AutomationProperties.Name="Close console helper"><icons:Icon Symbol="Dismiss24" /></Button>
              </Grid>
            </Border>
            <console:ConsoleHelperView Grid.Row="1" Margin="16,12,16,16" DataContext="{Binding ConsoleHelper}" />
          </Grid>
          <Grid RowDefinitions="Auto,*" Background="{DynamicResource Surface}" IsVisible="{Binding IsNotificationsSelected}">
            <Border Classes="toolbar">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <icons:Icon Symbol="Alert24" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{DynamicResource AppNotifications}" Classes="title" />
                <Button Grid.Column="2" Classes="icon" Command="{Binding CloseToolCommand}" ToolTip.Tip="Close (Esc)"
                        AutomationProperties.Name="Close notifications"><icons:Icon Symbol="Dismiss24" /></Button>
              </Grid>
            </Border>
            <notifications:NotificationsView Grid.Row="1" Margin="16,12,16,16" DataContext="{Binding Notifications}" />
          </Grid>
          <Grid RowDefinitions="Auto,*" Background="{DynamicResource Surface}" IsVisible="{Binding IsSettingsSelected}">
            <Border Classes="toolbar">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <icons:Icon Symbol="Settings24" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{DynamicResource AppSettings}" Classes="title" />
                <Button Grid.Column="2" Classes="icon" Command="{Binding CloseToolCommand}" ToolTip.Tip="Close (Esc)"
                        AutomationProperties.Name="Close settings"><icons:Icon Symbol="Dismiss24" /></Button>
              </Grid>
            </Border>
            <settings:SettingsView Grid.Row="1" Margin="16,12,16,16" DataContext="{Binding SettingsPage}" />
          </Grid>
          <Grid RowDefinitions="Auto,*" Background="{DynamicResource Surface}" IsVisible="{Binding IsDeathStatsSelected}">
            <Border Classes="toolbar">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <icons:Icon Symbol="HeartBroken24" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{DynamicResource AppDeathStats}" Classes="title" />
                <Button Grid.Column="2" Classes="icon" Command="{Binding CloseToolCommand}" ToolTip.Tip="Close (Esc)"
                        AutomationProperties.Name="Close death stats"><icons:Icon Symbol="Dismiss24" /></Button>
              </Grid>
            </Border>
            <deaths:DeathStatsView Grid.Row="1" Margin="16,12,16,16" DataContext="{Binding DeathStats}" />
          </Grid>
          <Grid RowDefinitions="Auto,*" Background="{DynamicResource Surface}" IsVisible="{Binding IsClanSelected}">
            <Border Classes="toolbar">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <icons:Icon Symbol="Shield24" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{DynamicResource AppClan}" Classes="title" />
                <Button Grid.Column="2" Classes="icon" Command="{Binding CloseToolCommand}" ToolTip.Tip="Close (Esc)"
                        AutomationProperties.Name="Close clan"><icons:Icon Symbol="Dismiss24" /></Button>
              </Grid>
            </Border>
            <clans:ClanView Grid.Row="1" Margin="16,12,16,16" DataContext="{Binding Clan}" />
          </Grid>
          <Grid RowDefinitions="Auto,*" Background="{DynamicResource Surface}" IsVisible="{Binding IsAchievementsSelected}">
            <Border Classes="toolbar">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <icons:Icon Symbol="Trophy24" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{DynamicResource AppAchievements}" Classes="title" />
                <Button Grid.Column="2" Classes="icon" Command="{Binding CloseToolCommand}" ToolTip.Tip="Close (Esc)"
                        AutomationProperties.Name="Close achievements"><icons:Icon Symbol="Dismiss24" /></Button>
              </Grid>
            </Border>
            <achievements:AchievementsView Grid.Row="1" Margin="16,12,16,16" DataContext="{Binding Achievements}" />
          </Grid>
        </Grid>
      </SplitView>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="10,3">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <TextBlock Text="{Binding Connection.StatusMessage}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" MaxWidth="300" />
        <TextBlock Grid.Column="1" Text="{Binding ToolMessage}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="Migration preview" FontSize="11" Classes="muted" />
      </Grid>
    </Border>
    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding HasDeleteConfirmation}">
      <Border Classes="card" Width="420" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:Icon Symbol="Delete24" FontSize="22" Foreground="{DynamicResource ConnectionDanger}" />
            <TextBlock Text="{DynamicResource DeleteServerHeader}" Classes="title" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding DeleteConfirmationText}" TextWrapping="Wrap" />
          <TextBlock Text="Its local map cache, chat history, death log and drawings are removed too, unless another saved profile uses the same server."
                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="subtle" Content="{DynamicResource Cancel}" Command="{Binding CancelDeleteServerCommand}" IsCancel="True" AutomationProperties.Name="Cancel delete server" />
            <Button Classes="primary" Background="{DynamicResource ConnectionDanger}" Content="{DynamicResource Delete}" Command="{Binding ConfirmDeleteServerCommand}"
                    AutomationProperties.Name="Confirm delete server" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding HasEditor}">
      <servers:ServerEditorView DataContext="{Binding Editor}" />
    </Border>
    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding HasOrganizer}">
      <devices:DeviceOrganizerView DataContext="{Binding Organizer}" />
    </Border>
    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding HasCloudRecovery}">
      <devices:CloudDeviceRestoreView DataContext="{Binding CloudRecovery}" />
    </Border>
    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding HasDeviceImport}">
      <devices:DeviceImportView DataContext="{Binding DeviceImport}" />
    </Border>
    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding IsAccountOpen}">
      <Border Classes="card" Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="16" KeyboardNavigation.TabNavigation="Cycle">
        <ScrollViewer MaxHeight="500" HorizontalScrollBarVisibility="Disabled">
        <TabControl SelectedIndex="{Binding AccountSectionIndex, Mode=TwoWay}">
        <TabItem Header="Rust+" IsVisible="{Binding HasCompanionAccount}" IsEnabled="{Binding !Cloud.IsBusy, FallbackValue=True}">
        <StackPanel Spacing="16" Margin="0,12,0,0">
          <accounts:CompanionAccountView DataContext="{Binding Account}" IsVisible="{Binding $parent[Window].((servers:ServersViewModel)DataContext).IsAccountOpen}" />
          <accounts:CompanionListenerView DataContext="{Binding Listener}"
              IsVisible="{Binding $parent[Window].((servers:ServersViewModel)DataContext).HasListener}"
              IsEnabled="{Binding !$parent[Window].((servers:ServersViewModel)DataContext).Account.IsBusy}" />
        </StackPanel>
        </TabItem>
        <TabItem Header="Cloud" IsVisible="{Binding HasCloudAccount}" IsEnabled="{Binding !Account.IsBusy, FallbackValue=True}">
          <StackPanel Spacing="18" Margin="0,12,0,0">
            <cloud:CloudAccountView DataContext="{Binding Cloud}" />
            <Border IsVisible="{Binding HasDeviceSync}">
              <cloud:CloudDeviceSyncView DataContext="{Binding DeviceSync}" />
            </Border>
          </StackPanel>
        </TabItem>
        </TabControl>
        </ScrollViewer>
          <Button Grid.Row="1" Classes="primary" Content="_Close" Command="{Binding CloseAccountCommand}" HorizontalAlignment="Right" />
        </Grid>
      </Border>
    </Border>
    <toasts:ToastHost Grid.RowSpan="3" DataContext="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,36" />
  </Grid>
</Window>
