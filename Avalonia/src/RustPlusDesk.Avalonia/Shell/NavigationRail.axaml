<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Servers"
             xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
             x:Class="RustPlusDesk.Avalonia.Shell.NavigationRail" x:DataType="vm:ServersViewModel">
  <!-- Navigation follows the reference RailCatalog order; areas appear here as they are ported. -->
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
    <Grid RowDefinitions="Auto,*,Auto" Margin="8,10,7,10">
      <StackPanel Spacing="4">
        <Button Classes="nav" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Show or hide server and device panel"
                AutomationProperties.Name="Toggle server and device panel">
          <Grid ColumnDefinitions="28,*"><icons:Icon Symbol="Navigation24" />
            <TextBlock Grid.Column="1" Classes="navLabel" Text="Servers panel" IsVisible="{Binding IsRailExpanded}" /></Grid>
        </Button>
        <Border Height="1" Margin="6,6" Background="{DynamicResource CardBorder}" />
        <Button Classes="nav" Classes.selected="{Binding !IsToolSelected}" Command="{Binding ShowDevicesCommand}"
                ToolTip.Tip="Monitor and control paired smart devices" AutomationProperties.Name="Devices">
          <Grid ColumnDefinitions="28,*"><icons:Icon Symbol="Connector24" />
            <TextBlock Grid.Column="1" Classes="navLabel" Text="Devices" IsVisible="{Binding IsRailExpanded}" /></Grid>
        </Button>
        <TextBlock Classes="navSection" Text="TOOLS" IsVisible="{Binding IsRailExpanded}" />
        <Border Height="1" Margin="6,6" Background="{DynamicResource CardBorder}" IsVisible="{Binding !IsRailExpanded}" />
        <Button Classes="nav" Classes.selected="{Binding IsRaidSelected}" Command="{Binding OpenRaidCommand}" IsVisible="{Binding HasRaidTool}"
                ToolTip.Tip="Calculate raid costs and required materials" AutomationProperties.Name="Raid calculator">
          <Grid ColumnDefinitions="28,*"><icons:Icon Symbol="Rocket24" />
            <TextBlock Grid.Column="1" Classes="navLabel" Text="Raid Calculator" IsVisible="{Binding IsRailExpanded}" /></Grid>
        </Button>
        <Button Classes="nav" Classes.selected="{Binding IsRecyclerSelected}" Command="{Binding OpenRecyclerCommand}" IsVisible="{Binding HasRecyclerTool}"
                ToolTip.Tip="Calculate component yields for wild and safe-zone recyclers" AutomationProperties.Name="Recycler">
          <Grid ColumnDefinitions="28,*"><icons:Icon Symbol="Recycle32" />
            <TextBlock Grid.Column="1" Classes="navLabel" Text="Recycling Calculator" IsVisible="{Binding IsRailExpanded}" /></Grid>
        </Button>
        <Button Classes="nav" Classes.selected="{Binding IsConsoleSelected}" Command="{Binding OpenConsoleCommand}" IsVisible="{Binding HasConsoleTool}"
                ToolTip.Tip="Useful console commands, ready to copy into the F1 console" AutomationProperties.Name="Console Helper">
          <Grid ColumnDefinitions="28,*"><icons:Icon Symbol="WindowConsole20" />
            <TextBlock Grid.Column="1" Classes="navLabel" Text="Console Helper" IsVisible="{Binding IsRailExpanded}" /></Grid>
        </Button>
      </StackPanel>
      <StackPanel Grid.Row="2" Spacing="4">
        <Button Classes="nav" Command="{Binding OpenCloudAccountCommand}" IsVisible="{Binding HasCloudAccount}"
                ToolTip.Tip="Cloud account, sync and backups" AutomationProperties.Name="Cloud account">
          <Grid ColumnDefinitions="28,*"><icons:Icon Symbol="Cloud24" />
            <TextBlock Grid.Column="1" Classes="navLabel" Text="Cloud" IsVisible="{Binding IsRailExpanded}" /></Grid>
        </Button>
        <Button Classes="nav" Command="{Binding OpenAccountCommand}" IsVisible="{Binding HasAccount}"
                ToolTip.Tip="Account and pairing" AutomationProperties.Name="Account and pairing">
          <Grid ColumnDefinitions="28,*"><icons:Icon Symbol="Person24" />
            <TextBlock Grid.Column="1" Classes="navLabel" Text="Account" IsVisible="{Binding IsRailExpanded}" /></Grid>
        </Button>
        <Button Classes="nav" Command="{Binding ToggleRailLabelsCommand}" ToolTip.Tip="Show or hide navigation labels"
                AutomationProperties.Name="Toggle navigation labels">
          <Grid ColumnDefinitions="28,*"><icons:Icon Symbol="PanelLeftExpand20" />
            <TextBlock Grid.Column="1" Classes="navLabel" Text="Collapse" IsVisible="{Binding IsRailExpanded}" /></Grid>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
