<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Servers"
             xmlns:teams="using:RustPlusDesk.Avalonia.Features.Teams" xmlns:map="using:RustPlusDesk.Avalonia.Features.Map"
             xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons" xmlns:chat="using:RustPlusDesk.Avalonia.Features.Chat"
             xmlns:activity="using:RustPlusDesk.Avalonia.Features.Activity"
             xmlns:shops="using:RustPlusDesk.Avalonia.Features.Shops"
             x:Class="RustPlusDesk.Avalonia.Shell.MapWorkspace" x:DataType="vm:ServersViewModel">
  <UserControl.Styles>
    <!--  Reference event dock: every row reveals its labels while the panel itself is hovered.  -->
    <Style Selector="Border.dockrow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.dockrow:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>
    <Style Selector="Border.dockrow:not(.dockactive)">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.dockrow.docktrackable.dockactive">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.eventdock TextBlock.docktext">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.eventdock.dockreveal TextBlock.docktext">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.dockname.dockactive">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="WorkspaceGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="190" />
      <RowDefinition Height="4" />
      <RowDefinition Height="200" MinHeight="90" MaxHeight="420" />
    </Grid.RowDefinitions>
    <Grid RowDefinitions="Auto,*">
      <Border Classes="toolbar">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <WrapPanel ItemSpacing="8" LineSpacing="6" VerticalAlignment="Center">
            <TextBlock Text="Map" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ToggleButton Classes="chip" IsChecked="{Binding Connection.Map.ShowGrid}" IsEnabled="{Binding Connection.Map.HasMap}"
                          ToolTip.Tip="Show the map grid" AutomationProperties.Name="Grid">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Grid24" FontSize="16" /><TextBlock Text="Grid" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="chip" IsChecked="{Binding Connection.Map.ShowMonuments}" IsEnabled="{Binding Connection.Map.HasMap}"
                          ToolTip.Tip="Show monuments" AutomationProperties.Name="Monuments">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Location24" FontSize="16" /><TextBlock Text="Monuments" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="chip" IsChecked="{Binding Connection.Map.ShowPlayers}" IsEnabled="{Binding Connection.Map.HasMap}"
                          ToolTip.Tip="Show team players" AutomationProperties.Name="Players">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="People24" FontSize="16" /><TextBlock Text="Players" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="chip" IsChecked="{Binding Connection.Map.ShowShops}" IsEnabled="{Binding Connection.Map.HasMap}"
                          ToolTip.Tip="Show vending machines" AutomationProperties.Name="Shops">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Cart24" FontSize="16" /><TextBlock Text="Shops" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="chip" IsChecked="{Binding Connection.Map.ShowDeathHeatmap}" IsEnabled="{Binding Connection.Map.HasMap}" IsVisible="{Binding HasDeathStats}"
                          ToolTip.Tip="Show a heatmap of the deaths logged on this server" AutomationProperties.Name="Deaths">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="HeartBroken24" FontSize="16" /><TextBlock Text="Deaths" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="chip" IsChecked="{Binding Connection.Map.AbbreviateNames}"
                          ToolTip.Tip="Streamer mode: abbreviate player names and Steam IDs and hide server names" AutomationProperties.Name="Streamer mode">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Incognito24" FontSize="16" /><TextBlock Text="Streamer" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="chip" IsChecked="{Binding Shops.IsOpen}" IsEnabled="{Binding Connection.Map.HasMap}"
                          ToolTip.Tip="Search vending machine offers" AutomationProperties.Name="Shop search">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="BuildingShop24" FontSize="16" /><TextBlock Text="Shop search" /></StackPanel>
            </ToggleButton>
            <Button x:Name="LayersButton" Classes="subtle" ToolTip.Tip="Map layer settings" AutomationProperties.Name="Layers">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Layer24" FontSize="16" /><TextBlock Text="Layers" /></StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Width="300" Spacing="10" Margin="4">
                    <TextBlock Text="Map layers" FontWeight="SemiBold" />
                    <TextBlock Text="Monument style" Classes="muted" FontSize="12" />
                    <ComboBox ItemsSource="{Binding Connection.Map.MonumentStyles}" SelectedIndex="{Binding Connection.Map.MonumentDisplayMode}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Monument style" />
                    <Grid ColumnDefinitions="*,48"><TextBlock Text="Monument size" Classes="muted" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding Connection.Map.MonumentScale, StringFormat='{}{0:0.0}x'}" HorizontalAlignment="Right" FontSize="12" /></Grid>
                    <Slider Minimum="0.5" Maximum="3" Value="{Binding Connection.Map.MonumentScale}" AutomationProperties.Name="Monument size" />
                    <Grid ColumnDefinitions="*,48"><TextBlock Text="Monument opacity" Classes="muted" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding Connection.Map.MonumentOpacity, StringFormat='{}{0:0%}'}" HorizontalAlignment="Right" FontSize="12" /></Grid>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding Connection.Map.MonumentOpacity}" AutomationProperties.Name="Monument opacity" />
                    <Grid ColumnDefinitions="*,48"><TextBlock Text="Grid opacity" Classes="muted" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding Connection.Map.GridOpacity, StringFormat='{}{0:0%}'}" HorizontalAlignment="Right" FontSize="12" /></Grid>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding Connection.Map.GridOpacity}" AutomationProperties.Name="Grid opacity" />
                    <Grid ColumnDefinitions="*,48"><TextBlock Text="Player icon size" Classes="muted" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding Connection.Map.PlayerIconScale, StringFormat='{}{0:0%}'}" HorizontalAlignment="Right" FontSize="12" /></Grid>
                    <Slider Minimum="0.5" Maximum="1.5" Value="{Binding Connection.Map.PlayerIconScale}" AutomationProperties.Name="Player icon size" />
                    <CheckBox Content="Show shops automatically when connecting" IsChecked="{Binding Connection.Map.AutoLoadShops}" />
                    <CheckBox Content="Show Steam avatars on player markers" IsChecked="{Binding Connection.Map.ShowSteamAvatars}"
                              ToolTip.Tip="Team players show their Steam profile picture instead of a dot" />
                    <CheckBox Content="Show player direction arrows" IsChecked="{Binding Connection.Map.ShowPlayerArrows}"
                              ToolTip.Tip="A small arrow on each player marker points the way they last moved" />
                    <StackPanel Spacing="8" IsVisible="{Binding DeathPins, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <Separator />
                      <ToggleSwitch Content="Death markers" IsChecked="{Binding DeathPins.Show, FallbackValue=False}" OnContent="" OffContent=""
                                    AutomationProperties.Name="Death markers" ToolTip.Tip="Pin every team death on the map" />
                      <StackPanel Spacing="8" IsVisible="{Binding DeathPins.Show, FallbackValue=False}">
                        <TextBlock Text="Markers kept per player" Classes="muted" FontSize="12" />
                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                          <TextBlock Text="You" FontSize="12" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Column="1" Minimum="1" Maximum="50" Increment="1" FormatString="0" Value="{Binding DeathPins.MaxSelf, FallbackValue=3}"
                                         AutomationProperties.Name="Death markers kept for you" />
                          <TextBlock Grid.Column="2" Text="Teammates" FontSize="12" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Column="3" Minimum="1" Maximum="50" Increment="1" FormatString="0" Value="{Binding DeathPins.MaxTeam, FallbackValue=3}"
                                         AutomationProperties.Name="Death markers kept per teammate" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding DeathPins.CountText, FallbackValue=''}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Classes="subtle" Content="Apply limits now" Command="{Binding DeathPins.ApplyCapsCommand, FallbackValue={x:Null}}"
                                  ToolTip.Tip="Remove the oldest markers beyond these limits" AutomationProperties.Name="Apply death marker limits" />
                        </Grid>
                        <Button Classes="subtle" Foreground="{DynamicResource ConnectionDanger}" Command="{Binding DeathPins.ConfirmWipeCommand, FallbackValue={x:Null}}"
                                IsVisible="{Binding !DeathPins.IsWipeConfirming, FallbackValue=True}" AutomationProperties.Name="Wipe death markers">
                          <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Delete24" FontSize="14" /><TextBlock Text="Wipe death markers" /></StackPanel>
                        </Button>
                        <Border Classes="panel" Padding="10" IsVisible="{Binding DeathPins.IsWipeConfirming, FallbackValue=False}">
                          <StackPanel Spacing="8">
                            <TextBlock Text="Remove every death marker from this server's map?" TextWrapping="Wrap" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                              <Button Classes="subtle" Content="Cancel" Command="{Binding DeathPins.CancelWipeCommand, FallbackValue={x:Null}}" />
                              <Button Classes="primary" Content="Wipe" Command="{Binding DeathPins.ConfirmWipeCommand, FallbackValue={x:Null}}"
                                      AutomationProperties.Name="Confirm wipe death markers" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Classes="icon" Command="{Binding Connection.Map.ResetViewCommand}" IsEnabled="{Binding Connection.Map.HasMap}"
                    ToolTip.Tip="Fit the whole map (Home)" AutomationProperties.Name="Fit map">
              <icons:Icon Symbol="Target24" FontSize="16" />
            </Button>
          </WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" IsVisible="{Binding Connection.IsConnected}">
            <TextBlock Text="{Binding Connection.Population, StringFormat='Players {0}'}" />
            <TextBlock Text="{Binding Connection.ServerTime}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Background="{DynamicResource MapBackground}">
        <Grid x:Name="MapContent" RowDefinitions="*,Auto">
        <map:MapSurface Grid.RowSpan="2" x:Name="Surface" Image="{Binding Connection.Map.Image}" Geometry="{Binding Connection.Map.Geometry}"
                        Monuments="{Binding Connection.Map.Monuments}" ShowGrid="{Binding Connection.Map.ShowGrid}"
                        MonumentScale="{Binding Connection.Map.MonumentScale}" MonumentOpacity="{Binding Connection.Map.MonumentOpacity}"
                        GridOpacity="{Binding Connection.Map.GridOpacity}" MonumentNames="{Binding Connection.Map.ShowMonumentNames}"
                        Markers="{Binding Connection.Map.DrawnMarkers}" ShowPlayers="{Binding Connection.Map.ShowPlayers}" ShowShops="{Binding Connection.Map.ShowShops}"
                        ShowMonuments="{Binding Connection.Map.ShowMonuments}" ResetRequest="{Binding Connection.Map.ViewResetRequest}"
                        FocusRequest="{Binding Connection.Map.FocusRequest}" AbbreviateNames="{Binding Connection.Map.AbbreviateNames}"
                        PlayerScale="{Binding Connection.Map.PlayerIconScale}" ShowDeathHeatmap="{Binding Connection.Map.ShowDeathHeatmap}"
                        DeathPositions="{Binding Connection.Map.DeathPositions}"
                        ShowSteamAvatars="{Binding Connection.Map.ShowSteamAvatars}" AvatarVersion="{Binding Connection.Map.AvatarVersion}"
                        Avatars="{Binding Connection.Map.Avatars}" ShowPlayerArrows="{Binding Connection.Map.ShowPlayerArrows}"
                        PlayerHeadings="{Binding Connection.Map.PlayerHeadings}"
                        ShowDeathPins="{Binding DeathPins.Show, FallbackValue=False}" DeathPins="{Binding DeathPins.Pins, FallbackValue={x:Null}}"
                        BitmapScalingMode="{Binding Connection.Map.BitmapScalingMode}" UseAliasedEdgeMode="{Binding Connection.Map.UseAliasedEdgeMode}"
                        SceneCache="{Binding Connection.Map.UseCacheMode}" RenderScale="{Binding Connection.Map.RenderScale}"
                        IsVisible="{Binding Connection.Map.HasMap}" AutomationProperties.Name="Server map" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !Connection.Map.HasMap}" Margin="20">
        <Border Classes="card" MaxWidth="360" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
              <icons:Icon Symbol="Map24" FontSize="26" Foreground="{DynamicResource Accent}" />
            </Border>
            <TextBlock Text="Ready to explore the map?" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Connection.DisplayServerName}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button Content="_Connect" Classes="primary" Command="{Binding Connection.ConnectCommand}"
                    IsVisible="{Binding !Connection.IsActive}" HorizontalAlignment="Center" />
            <Button Content="_Disconnect" Classes="subtle" Command="{Binding Connection.DisconnectCommand}"
                    IsVisible="{Binding Connection.IsActive}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Connection.Map.Message}" Classes="muted" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                       IsVisible="{Binding Connection.Map.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="Connect to a selected server to load the live Rust map and team." Classes="muted" FontSize="12"
                       TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding !Connection.IsActive}" />
          </StackPanel>
        </Border>
        </ScrollViewer>
        <Button Classes="subtle" Background="{DynamicResource SurfaceAlt}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                Command="{Binding DeathPins.WipeCommand, FallbackValue={x:Null}}" IsVisible="{Binding DeathPins.ShowWipeOverlay, FallbackValue=False}"
                ToolTip.Tip="Wipe Death Markers" AutomationProperties.Name="Wipe death markers on the map">
          <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Delete24" FontSize="16" /><TextBlock Text="Wipe death markers" /></StackPanel>
        </Button>
        <shops:ShopSearchView Grid.RowSpan="2" DataContext="{Binding Shops}" IsVisible="{Binding IsOpen}" Width="380"
                              HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,12,12,12" />
        <shops:ShopProfitView Grid.RowSpan="2" DataContext="{Binding Shops.Profit}" IsVisible="{Binding IsOpen}" Width="380"
                              HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,12,12,12" />
        <shops:ShopPathFinderView Grid.RowSpan="2" DataContext="{Binding Shops.PathFinder}" IsVisible="{Binding IsOpen}" Width="380"
                                  HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,12,12,12" />
        <teams:TeamView Grid.Row="1" DataContext="{Binding Connection.Team}" MaxHeight="{Binding #MapContent.Bounds.Height}"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,20,20" />
        <!--  Reference event dock (Panel.ZIndex 100): live event rows with their spawn/despawn timers.  -->
        <Border x:Name="EventDockBox" Classes="eventdock" Background="#AA16181C" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="12"
                Padding="6,8" Margin="15" HorizontalAlignment="Right" VerticalAlignment="Top" BoxShadow="0 2 15 0 #4D000000"
                IsVisible="{Binding Connection.Map.HasEventDock}"
                PointerEntered="OnEventDockPointerEntered" PointerExited="OnEventDockPointerExited">
          <ItemsControl x:Name="EventDock" ItemsSource="{Binding Connection.Map.EventDock}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="map:EventDockRow">
                <Border Classes="dockrow" Classes.dockactive="{Binding Active}" Classes.docktrackable="{Binding Trackable}"
                        Height="34" Padding="4,1" Margin="0,1" ToolTip.Tip="{Binding Tip}" PointerPressed="OnEventDockRowPressed">
                  <Grid ColumnDefinitions="36,*" RowDefinitions="Auto,Auto">
                    <Ellipse Grid.RowSpan="2" Grid.Column="0" Width="32" Height="32" Fill="{DynamicResource AccentSoft}" IsVisible="{Binding Active}" />
                    <Image Grid.RowSpan="2" Grid.Column="0" Width="24" Height="24" Source="{Binding Icon}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Grid.RowSpan="2" Grid.Column="0" Width="6" Height="6" Margin="0,0,4,0" Fill="{DynamicResource Accent}"
                             HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding Active}" />
                    <TextBlock Classes="docktext dockname" Classes.dockactive="{Binding Active}" Grid.Row="0" Grid.Column="1" Text="{Binding Name}"
                               FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="8,2,12,0" VerticalAlignment="Center" />
                    <TextBlock Classes="docktext" Grid.Row="1" Grid.Column="1" Text="{Binding TimerText}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" Margin="8,0,12,2" VerticalAlignment="Center"
                               IsVisible="{Binding TimerText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        </Grid>
      </Border>
    </Grid>
    <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" Background="{DynamicResource CardBorder}"
                  AutomationProperties.Name="Resize activity panel" />
    <Border Grid.Row="2" Background="{DynamicResource Surface}" Padding="14,4,14,10" x:Name="ActivityPanel">
      <TabControl x:Name="BottomTabs" Padding="0" AutomationProperties.Name="Chat and activity">
        <TabItem FontSize="14" AutomationProperties.Name="Team chat">
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Chat24" FontSize="16" /><TextBlock Text="Team chat" /></StackPanel></TabItem.Header>
          <chat:ChatView DataContext="{Binding Connection.Chat}" Margin="0,6,0,0" />
        </TabItem>
        <TabItem FontSize="14" AutomationProperties.Name="Activity" IsVisible="{Binding !Activity.IsHidden}">
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Pulse24" FontSize="16" /><TextBlock Text="Activity" /></StackPanel></TabItem.Header>
          <activity:ActivityLogView DataContext="{Binding Activity}" Margin="0,6,0,0" />
        </TabItem>
      </TabControl>
    </Border>
  </Grid>
</UserControl>
