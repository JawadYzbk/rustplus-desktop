<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Servers"
             xmlns:teams="using:RustPlusDesk.Avalonia.Features.Teams" xmlns:map="using:RustPlusDesk.Avalonia.Features.Map"
             xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons" xmlns:chat="using:RustPlusDesk.Avalonia.Features.Chat"
             xmlns:activity="using:RustPlusDesk.Avalonia.Features.Activity"
             xmlns:shops="using:RustPlusDesk.Avalonia.Features.Shops"
             x:Class="RustPlusDesk.Avalonia.Shell.MapWorkspace" x:DataType="vm:ServersViewModel">
  <Grid x:Name="WorkspaceGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="190" />
      <RowDefinition Height="4" />
      <RowDefinition Height="200" MinHeight="90" MaxHeight="420" />
    </Grid.RowDefinitions>
    <Grid RowDefinitions="Auto,*">
      <Border Classes="toolbar">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <WrapPanel ItemSpacing="8" LineSpacing="6" VerticalAlignment="Center">
            <TextBlock Text="Map" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ToggleButton Classes="chip" IsChecked="{Binding Connection.Map.ShowGrid}" IsEnabled="{Binding Connection.Map.HasMap}"
                          ToolTip.Tip="Show the map grid" AutomationProperties.Name="Grid">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Grid24" FontSize="16" /><TextBlock Text="Grid" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="chip" IsChecked="{Binding Connection.Map.ShowMonuments}" IsEnabled="{Binding Connection.Map.HasMap}"
                          ToolTip.Tip="Show monuments" AutomationProperties.Name="Monuments">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Location24" FontSize="16" /><TextBlock Text="Monuments" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="chip" IsChecked="{Binding Connection.Map.ShowPlayers}" IsEnabled="{Binding Connection.Map.HasMap}"
                          ToolTip.Tip="Show team players" AutomationProperties.Name="Players">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="People24" FontSize="16" /><TextBlock Text="Players" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="chip" IsChecked="{Binding Connection.Map.ShowShops}" IsEnabled="{Binding Connection.Map.HasMap}"
                          ToolTip.Tip="Show vending machines" AutomationProperties.Name="Shops">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Cart24" FontSize="16" /><TextBlock Text="Shops" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="chip" IsChecked="{Binding Shops.IsOpen}" IsEnabled="{Binding Connection.Map.HasMap}"
                          ToolTip.Tip="Search vending machine offers" AutomationProperties.Name="Shop search">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="BuildingShop24" FontSize="16" /><TextBlock Text="Shop search" /></StackPanel>
            </ToggleButton>
            <Button x:Name="LayersButton" Classes="subtle" ToolTip.Tip="Map layer settings" AutomationProperties.Name="Layers">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Layer24" FontSize="16" /><TextBlock Text="Layers" /></StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Width="300" Spacing="10" Margin="4">
                    <TextBlock Text="Map layers" FontWeight="SemiBold" />
                    <TextBlock Text="Monument style" Classes="muted" FontSize="12" />
                    <ComboBox ItemsSource="{Binding Connection.Map.MonumentStyles}" SelectedIndex="{Binding Connection.Map.MonumentDisplayMode}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Monument style" />
                    <Grid ColumnDefinitions="*,48"><TextBlock Text="Monument size" Classes="muted" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding Connection.Map.MonumentScale, StringFormat='{}{0:0.0}x'}" HorizontalAlignment="Right" FontSize="12" /></Grid>
                    <Slider Minimum="0.5" Maximum="3" Value="{Binding Connection.Map.MonumentScale}" AutomationProperties.Name="Monument size" />
                    <Grid ColumnDefinitions="*,48"><TextBlock Text="Monument opacity" Classes="muted" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding Connection.Map.MonumentOpacity, StringFormat='{}{0:0%}'}" HorizontalAlignment="Right" FontSize="12" /></Grid>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding Connection.Map.MonumentOpacity}" AutomationProperties.Name="Monument opacity" />
                    <Grid ColumnDefinitions="*,48"><TextBlock Text="Grid opacity" Classes="muted" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding Connection.Map.GridOpacity, StringFormat='{}{0:0%}'}" HorizontalAlignment="Right" FontSize="12" /></Grid>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding Connection.Map.GridOpacity}" AutomationProperties.Name="Grid opacity" />
                    <CheckBox Content="Show shops automatically when connecting" IsChecked="{Binding Connection.Map.AutoLoadShops}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Classes="icon" Command="{Binding Connection.Map.ResetViewCommand}" IsEnabled="{Binding Connection.Map.HasMap}"
                    ToolTip.Tip="Fit the whole map (Home)" AutomationProperties.Name="Fit map">
              <icons:Icon Symbol="Target24" FontSize="16" />
            </Button>
          </WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" IsVisible="{Binding Connection.IsConnected}">
            <TextBlock Text="{Binding Connection.Population, StringFormat='Players {0}'}" />
            <TextBlock Text="{Binding Connection.ServerTime}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Background="{DynamicResource MapBackground}">
        <Grid x:Name="MapContent" RowDefinitions="*,Auto">
        <map:MapSurface Grid.RowSpan="2" x:Name="Surface" Image="{Binding Connection.Map.Image}" Geometry="{Binding Connection.Map.Geometry}"
                        Monuments="{Binding Connection.Map.Monuments}" ShowGrid="{Binding Connection.Map.ShowGrid}"
                        MonumentScale="{Binding Connection.Map.MonumentScale}" MonumentOpacity="{Binding Connection.Map.MonumentOpacity}"
                        GridOpacity="{Binding Connection.Map.GridOpacity}" MonumentNames="{Binding Connection.Map.ShowMonumentNames}"
                        Markers="{Binding Connection.Map.Markers}" ShowPlayers="{Binding Connection.Map.ShowPlayers}" ShowShops="{Binding Connection.Map.ShowShops}"
                        ShowMonuments="{Binding Connection.Map.ShowMonuments}" ResetRequest="{Binding Connection.Map.ViewResetRequest}"
                        FocusRequest="{Binding Connection.Map.FocusRequest}"
                        IsVisible="{Binding Connection.Map.HasMap}" AutomationProperties.Name="Server map" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !Connection.Map.HasMap}" Margin="20">
        <Border Classes="card" MaxWidth="360" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
              <icons:Icon Symbol="Map24" FontSize="26" Foreground="{DynamicResource Accent}" />
            </Border>
            <TextBlock Text="Ready to explore the map?" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Connection.ServerName}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button Content="_Connect" Classes="primary" Command="{Binding Connection.ConnectCommand}"
                    IsVisible="{Binding !Connection.IsActive}" HorizontalAlignment="Center" />
            <Button Content="_Disconnect" Classes="subtle" Command="{Binding Connection.DisconnectCommand}"
                    IsVisible="{Binding Connection.IsActive}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Connection.Map.Message}" Classes="muted" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                       IsVisible="{Binding Connection.Map.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="Connect to a selected server to load the live Rust map and team." Classes="muted" FontSize="12"
                       TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding !Connection.IsActive}" />
          </StackPanel>
        </Border>
        </ScrollViewer>
        <shops:ShopSearchView Grid.RowSpan="2" DataContext="{Binding Shops}" IsVisible="{Binding IsOpen}" Width="380"
                              HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,12,12,12" />
        <shops:ShopProfitView Grid.RowSpan="2" DataContext="{Binding Shops.Profit}" IsVisible="{Binding IsOpen}" Width="380"
                              HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,12,12,12" />
        <shops:ShopPathFinderView Grid.RowSpan="2" DataContext="{Binding Shops.PathFinder}" IsVisible="{Binding IsOpen}" Width="380"
                                  HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,12,12,12" />
        <teams:TeamView Grid.Row="1" DataContext="{Binding Connection.Team}" MaxHeight="{Binding #MapContent.Bounds.Height}"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,20,20" />
        </Grid>
      </Border>
    </Grid>
    <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" Background="{DynamicResource CardBorder}"
                  AutomationProperties.Name="Resize activity panel" />
    <Border Grid.Row="2" Background="{DynamicResource Surface}" Padding="14,4,14,10" x:Name="ActivityPanel">
      <TabControl Padding="0" AutomationProperties.Name="Chat and activity">
        <TabItem FontSize="14" AutomationProperties.Name="Team chat">
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Chat24" FontSize="16" /><TextBlock Text="Team chat" /></StackPanel></TabItem.Header>
          <chat:ChatView DataContext="{Binding Connection.Chat}" Margin="0,6,0,0" />
        </TabItem>
        <TabItem FontSize="14" AutomationProperties.Name="Activity">
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Pulse24" FontSize="16" /><TextBlock Text="Activity" /></StackPanel></TabItem.Header>
          <activity:ActivityLogView DataContext="{Binding Activity}" Margin="0,6,0,0" />
        </TabItem>
      </TabControl>
    </Border>
  </Grid>
</UserControl>
