<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Servers"
             xmlns:servers="using:RustPlusDesk.Avalonia.Features.Servers"
             xmlns:devices="using:RustPlusDesk.Avalonia.Features.Devices"
             x:Class="RustPlusDesk.Avalonia.Shell.ServerDevicePane" x:DataType="vm:ServersViewModel">
  <Border Background="{DynamicResource Surface}" Padding="12,16,12,10">
    <Grid RowDefinitions="Auto,*" RowSpacing="16">
      <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
        <servers:ServersView x:Name="ServersList" />
      </ScrollViewer>
      <devices:DevicesView x:Name="DevicesList" Grid.Row="1" DataContext="{Binding Connection.Devices}" />
    </Grid>
  </Border>
</UserControl>
