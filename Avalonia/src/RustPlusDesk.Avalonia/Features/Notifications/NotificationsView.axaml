<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Notifications"
             xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
             xmlns:core="clr-namespace:RustPlusDesk.Core.Notifications;assembly=RustPlusDesk.Core"
             x:Class="RustPlusDesk.Avalonia.Features.Notifications.NotificationsView" x:DataType="vm:NotificationsViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
      <TextBlock Text="Alarms, deaths and server events pushed by Rust+." Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Classes="subtle" Command="{Binding MarkAllReadCommand}" ToolTip.Tip="Mark every notification as read"
              AutomationProperties.Name="Mark all notifications read">
        <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="MailAllRead24" FontSize="14" /><TextBlock Text="Mark read" /></StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="subtle" Command="{Binding RequestClearCommand}" ToolTip.Tip="Clear all notification history"
              AutomationProperties.Name="Clear notification history">
        <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Delete24" FontSize="14" /><TextBlock Text="Clear" /></StackPanel>
      </Button>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <RadioButton Classes="chip" Content="All" IsChecked="{Binding ShowAll, Mode=OneWay}" GroupName="NotificationFilter" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static core:NotificationFilter.All}" AutomationProperties.Name="All notifications" />
        <RadioButton Classes="chip" Content="Alarms" IsChecked="{Binding ShowAlarms, Mode=OneWay}" GroupName="NotificationFilter" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static core:NotificationFilter.Alarms}" AutomationProperties.Name="Alarm notifications" />
        <RadioButton Classes="chip" Content="Deaths" IsChecked="{Binding ShowDeaths, Mode=OneWay}" GroupName="NotificationFilter" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static core:NotificationFilter.Deaths}" AutomationProperties.Name="Death notifications" />
      </StackPanel>
      <TextBox Grid.Column="1" Text="{Binding SearchText}" PlaceholderText="Search message…" AutomationProperties.Name="Search notifications">
        <TextBox.InnerLeftContent><icons:Icon Symbol="Search24" FontSize="15" Margin="8,0,0,0" Foreground="{DynamicResource TextSubtle}" /></TextBox.InnerLeftContent>
      </TextBox>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="6">
      <Border Classes="confirm" IsVisible="{Binding IsConfirmingClear}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <TextBlock Text="Are you sure you want to clear all notification history?" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="1" Classes="subtle" Content="Cancel" Command="{Binding CancelClearCommand}" AutomationProperties.Name="Keep notification history" />
          <Button Grid.Column="2" Classes="danger" Content="Clear history" Command="{Binding ConfirmClearCommand}" AutomationProperties.Name="Confirm clear notification history" />
        </Grid>
      </Border>
      <Border Classes="confirm" IsVisible="{Binding IsMuteConfirmOpen}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <TextBlock Text="{Binding MuteQuestion}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="1" Classes="subtle" Content="Cancel" Command="{Binding CancelMuteCommand}" AutomationProperties.Name="Keep server notifications" />
          <Button Grid.Column="2" Classes="danger" Content="Mute" Command="{Binding ConfirmMuteCommand}" AutomationProperties.Name="Confirm mute server" />
        </Grid>
      </Border>
      <TextBlock Text="{Binding Notice}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                 IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
    <Grid Grid.Row="3">
      <StackPanel IsVisible="{Binding !HasRows}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
        <icons:Icon Symbol="Alert24" FontSize="36" Foreground="{DynamicResource TextSubtle}" HorizontalAlignment="Center" />
        <TextBlock Text="No notifications here" Classes="title" HorizontalAlignment="Center" />
        <TextBlock Text="You're all caught up!" Classes="muted" HorizontalAlignment="Center" />
      </StackPanel>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasRows}">
        <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="Notifications">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NotificationRow">
              <Button Classes="notification" Classes.unread="{Binding IsUnread}" CommandParameter="{Binding}"
                      Command="{Binding $parent[UserControl].((vm:NotificationsViewModel)DataContext).OpenCommand}" AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource SurfaceHover}" VerticalAlignment="Top">
                    <icons:Icon Symbol="{Binding Symbol}" FontSize="18" Classes.alarm="{Binding IsAlarm}" Classes.death="{Binding IsDeath}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" IsVisible="{Binding IsUnread}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="tag" IsVisible="{Binding HasServer}" CommandParameter="{Binding}" ToolTip.Tip="Connect to this server"
                              Command="{Binding $parent[UserControl].((vm:NotificationsViewModel)DataContext).ConnectServerCommand}" AutomationProperties.Name="Connect to notification server">
                        <StackPanel Orientation="Horizontal" Spacing="4"><icons:Icon Symbol="Server24" FontSize="11" VerticalAlignment="Center" /><TextBlock Text="{Binding ServerTag}" FontSize="11" VerticalAlignment="Center" /></StackPanel>
                      </Button>
                      <TextBlock Text="{Binding Time}" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                    <Button Classes="icon" IsVisible="{Binding HasServer}" CommandParameter="{Binding}" ToolTip.Tip="Mute notifications from this server"
                            Command="{Binding $parent[UserControl].((vm:NotificationsViewModel)DataContext).RequestMuteCommand}" AutomationProperties.Name="Mute notification server">
                      <icons:Icon Symbol="AlertOff24" FontSize="15" /></Button>
                    <Button Classes="icon" CommandParameter="{Binding}" ToolTip.Tip="Delete"
                            Command="{Binding $parent[UserControl].((vm:NotificationsViewModel)DataContext).DeleteCommand}" AutomationProperties.Name="Delete notification">
                      <icons:Icon Symbol="Delete24" FontSize="15" /></Button>
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
  <UserControl.Styles>
    <Style Selector="Button.notification">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Button.notification.unread">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.notification:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.tag">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBlock.alarm"><Setter Property="Foreground" Value="{DynamicResource ConnectionDanger}" /></Style>
    <Style Selector="TextBlock.death"><Setter Property="Foreground" Value="{DynamicResource Highlight}" /></Style>
    <Style Selector="Border.confirm">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
  </UserControl.Styles>
</UserControl>
