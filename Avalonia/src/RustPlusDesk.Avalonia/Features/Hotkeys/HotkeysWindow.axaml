<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RustPlusDesk.Avalonia.Features.Hotkeys"
        xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
        x:Class="RustPlusDesk.Avalonia.Features.Hotkeys.HotkeysWindow" x:DataType="vm:HotkeysEditorViewModel"
        Title="Hotkeys" Width="640" Height="560" MinWidth="460" MinHeight="380" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Background="{DynamicResource Surface}" Padding="16">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:Icon Symbol="Keyboard24" FontSize="20" Foreground="{DynamicResource Accent}" />
        <TextBlock Text="{DynamicResource Hotkeys}" Classes="title" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Row="1" Classes="muted" TextWrapping="Wrap"
                 Text="{DynamicResource AssignGlobalHotkeys}" />
      <Border Grid.Row="2" Classes="note" IsVisible="{Binding HasUnavailableReason}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <icons:Icon Symbol="Info24" FontSize="16" Foreground="{DynamicResource Highlight}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding UnavailableReason}" FontSize="12" TextWrapping="Wrap" MaxWidth="560" />
        </StackPanel>
      </Border>
      <Grid Grid.Row="3">
        <TextBlock Text="No smart switches on this server yet. Pair a switch to give it a hotkey." Classes="muted" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasRows}" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasRows}">
          <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="Hotkey assignments">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HotkeyRowViewModel">
                <Border Classes="row" Classes.deleted="{Binding IsDeleted}">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding IdText}" FontSize="11" Classes="muted" />
                        <TextBlock Text="{Binding Status}" FontSize="11" Classes="muted" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <icons:Icon Symbol="Warning24" FontSize="14" Foreground="{DynamicResource ConnectionDanger}" IsVisible="{Binding IsRegisteredWarningVisible}"
                                  ToolTip.Tip="{DynamicResource HotkeyWarningInUse}" />
                      <Border Classes="key"><TextBlock Text="{Binding HotkeyDisplay}" FontWeight="SemiBold" FontSize="12" /></Border>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="subtle" Content="{DynamicResource Set}" Click="SetHotkey" AutomationProperties.Name="Set hotkey" />
                    <Button Grid.Column="3" Classes="subtle" Content="{DynamicResource Clear}" IsEnabled="{Binding HasHotkey}" CommandParameter="{Binding}"
                            Command="{Binding $parent[Window].((vm:HotkeysEditorViewModel)DataContext).ClearCommand}" AutomationProperties.Name="Clear hotkey" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
      <Grid Grid.Row="4" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
        <TextBlock Text="{DynamicResource HotkeyExecutionMode}" Classes="muted" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <RadioButton Classes="chip" Content="{DynamicResource HotkeySequential}" IsChecked="{Binding IsSequential}" GroupName="HotkeyMode" AutomationProperties.Name="Sequential mode" />
          <RadioButton Classes="chip" Content="{DynamicResource HotkeyParallel}" IsChecked="{Binding IsParallel}" GroupName="HotkeyMode" AutomationProperties.Name="Parallel mode" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{Binding DelayText}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding IsSequential}" />
        <Slider Grid.Row="1" Grid.Column="1" Minimum="50" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding DelayMs}"
                IsVisible="{Binding IsSequential}" AutomationProperties.Name="Toggle delay" />
      </Grid>
      <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="subtle" Content="{DynamicResource CloseDeactivate}" Command="{Binding CloseDeactivateCommand}" AutomationProperties.Name="Close and deactivate hotkeys" />
        <Button Classes="primary" Content="{DynamicResource CloseActivate}" Command="{Binding CloseActivateCommand}" ToolTip.Tip="{Binding UnavailableReason}"
                ToolTip.ShowOnDisabled="True" AutomationProperties.Name="Close and activate hotkeys" />
      </StackPanel>
    </Grid>
  </Border>
  <Window.Styles>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.row.deleted"><Setter Property="Opacity" Value="0.7" /></Style>
    <Style Selector="Border.key">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinWidth" Value="60" />
    </Style>
    <Style Selector="Border.note">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
  </Window.Styles>
</Window>
