<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Connections"
             x:Class="RustPlusDesk.Avalonia.Features.Connections.ConnectionStatusView" x:DataType="vm:ConnectionViewModel">
  <Border Classes="panel">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <Ellipse Width="10" Height="10" Classes="connection-dot" Classes.connected="{Binding IsConnected}"
                   Classes.pending="{Binding IsPending}" Classes.repair="{Binding RequiresRePair}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{Binding ServerName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Content="_Connect" Classes="primary" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsActive}" />
          <Button Content="_Disconnect" Classes="subtle" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsActive}" />
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" IsVisible="{Binding IsConnected}">
        <StackPanel Spacing="2"><TextBlock Text="PLAYERS" Classes="section" FontSize="10" /><TextBlock Text="{Binding Population}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
        <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="QUEUE" Classes="section" FontSize="10" /><TextBlock Text="{Binding Queue}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
        <StackPanel Grid.Column="2" Spacing="2"><TextBlock Text="TIME" Classes="section" FontSize="10" /><TextBlock Text="{Binding ServerTime}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding NextPhase}" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
