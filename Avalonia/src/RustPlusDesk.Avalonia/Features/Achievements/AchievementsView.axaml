<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Achievements"
             xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
             x:Class="RustPlusDesk.Avalonia.Features.Achievements.AchievementsView" x:DataType="vm:AchievementsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.tile"><Setter Property="Background" Value="{DynamicResource SurfaceAlt}" /><Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10" /><Setter Property="Margin" Value="0,0,8,8" /></Style>
    <Style Selector="TextBlock.title2"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.detail"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource TextSubtle}" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" RowSpacing="10">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Summary}" Classes="title" />
        <TextBlock Text="Every achievement the app knows, in the order the artwork is drawn." Classes="muted" FontSize="12" />
      </StackPanel>
      <Button Grid.Column="1" Classes="subtle" Command="{Binding MarkSeenCommand}" ToolTip.Tip="Clear the badge on the achievements button"
              AutomationProperties.Name="Mark achievements seen">
        <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Dismiss24" FontSize="14" /><TextBlock Text="Mark seen" /></StackPanel>
      </Button>
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemSpacing="0" LineSpacing="0" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AchievementRow">
            <Border Classes="tile" Width="176">
              <StackPanel Spacing="6">
                <Panel Height="64" Width="64" HorizontalAlignment="Left">
                  <Image Source="{Binding Icon}" Stretch="Uniform" />
                  <TextBlock Text="?" FontSize="28" Foreground="{DynamicResource TextSubtle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding !IsEarned}" />
                </Panel>
                <TextBlock Text="{Binding Name}" Classes="title2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                <TextBlock Text="{Binding Detail}" Classes="detail" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
