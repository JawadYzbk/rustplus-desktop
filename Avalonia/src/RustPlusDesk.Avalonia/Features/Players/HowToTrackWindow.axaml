<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
        x:Class="RustPlusDesk.Avalonia.Features.Players.HowToTrackWindow"
        Title="How to Track Players" Width="800" Height="700" MinWidth="600" MinHeight="500">
  <!-- Reference HowToTrackWindow: the guide to the players the user keeps an eye on. -->
  <Window.Styles>
    <Style Selector="TextBlock.sectionTitle"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,6" /></Style>
    <Style Selector="TextBlock.body"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineHeight" Value="20" />
      <Setter Property="Margin" Value="0,0,0,8" /></Style>
    <Style Selector="Border.note"><Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
      <Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="12" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
    <Style Selector="Border.step"><Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
      <Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="12" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
    <Style Selector="Border.number"><Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" /><Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="VerticalAlignment" Value="Top" /></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Classes="toolbar">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:Icon Symbol="QuestionCircle24" FontSize="22" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
        <StackPanel>
          <TextBlock Text="{DynamicResource HowToTrackPlayersTitle}" Classes="title" />
          <TextBlock Text="{DynamicResource NativeUDPTrackingSubtitle}" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" Padding="20,16,20,16">
      <StackPanel Spacing="4">
        <Border Classes="note">
          <TextBlock Text="{DynamicResource TrackingGuideEnglishOnlyNotice}" Classes="body" Margin="0" />
        </Border>

        <TextBlock Text="Native UDP Tracking" Classes="sectionTitle" />
        <TextBlock Classes="body"
                   Text="Rust+ Desktop talks to the game server directly, over UDP, through the local protocol. Nothing about the players you keep an eye on leaves your machine: they are bookmarks in your own app data folder, and both apps read the same file." />

        <Border Classes="step">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="number"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OnAccent}" /></Border>
            <TextBlock Grid.Column="1" Classes="body" Margin="0"
                       Text="Turn the Players tab on in the settings, then open it from the rail." />
          </Grid>
        </Border>
        <Border Classes="step">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="number"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OnAccent}" /></Border>
            <TextBlock Grid.Column="1" Classes="body" Margin="0"
                       Text="Type the name or the Steam ID of the player in the box, and press Track. A Steam ID is looked up in the public profile, so the name is the one the profile shows." />
          </Grid>
        </Border>
        <Border Classes="step">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="number"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OnAccent}" /></Border>
            <TextBlock Grid.Column="1" Classes="body" Margin="0"
                       Text="The player is in the Tracked tab. From there you can rename it, put it in a group - a group may have a colour of its own - and stop tracking it." />
          </Grid>
        </Border>

        <Border Classes="note">
          <TextBlock Classes="body" Margin="0"
                     Text="The player activity tracking was removed: the app no longer polls the server for a player's comings and goings. The team history is in the wipe tracker." />
        </Border>

        <TextBlock Text="Limitations &amp; ToS" Classes="sectionTitle" />
        <TextBlock Classes="body"
                   Text="The players you keep an eye on are your own bookmarks: the app never sends them anywhere, and no third-party service is involved." />
        <Border Classes="note">
          <TextBlock Classes="body" Margin="0"
                     Text="If a server has the Facepunch Name Randomizer enabled, the names you see are the randomized ones. You can still keep an eye on the players, but only under the name the server shows them." />
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" Padding="20,12,20,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Classes="muted" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="{DynamicResource HowToTrackCloseHint}" />
        <Button Grid.Column="1" Classes="subtle" Click="OnCloseClick" AutomationProperties.Name="Close the guide">
          <TextBlock Text="{DynamicResource Close}" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
