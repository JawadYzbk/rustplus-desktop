<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Players"
             xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
             xmlns:sys="using:System"
             x:Class="RustPlusDesk.Avalonia.Features.Players.PlayersView" x:DataType="vm:PlayersViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.colHeader"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" /></Style>
    <Style Selector="TextBlock.cell"><Setter Property="FontSize" Value="13" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
    <Style Selector="Border.dot"><Setter Property="Width" Value="9" /><Setter Property="Height" Value="9" />
      <Setter Property="CornerRadius" Value="5" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
    <!-- The reference's Players tab has an Online half and a Tracked half. -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <RadioButton Classes="chip" Content="{DynamicResource OnlineTab}" IsChecked="{Binding !IsTrackedTab}" GroupName="PlayersTab"
                     AutomationProperties.Name="Online players" />
        <RadioButton Classes="chip" Content="{DynamicResource TrackedTab}" IsChecked="{Binding IsTrackedTab}" GroupName="PlayersTab"
                     AutomationProperties.Name="Tracked players" />
      </StackPanel>
      <Button Grid.Column="1" Classes="subtle" Command="{Binding HowToTrackCommand}"
              ToolTip.Tip="{DynamicResource LearnHowTrackingWorks}" AutomationProperties.Name="How to track">
        <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="QuestionCircle24" FontSize="14" />
          <TextBlock Text="{DynamicResource HowToTrack}" /></StackPanel>
      </Button>
    </Grid>

    <!-- The online half: the reference asks Steam for the players of the server and says the tracking was removed. -->
    <StackPanel Grid.Row="1" Spacing="10" IsVisible="{Binding !IsTrackedTab}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="{DynamicResource OnlinePlayers}" Classes="title" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Classes="subtle" Command="{Binding RefreshOnlineCommand}"
                  ToolTip.Tip="Read the players of the server again" AutomationProperties.Name="Refresh online players">
            <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="ArrowClockwise24" FontSize="14" />
              <TextBlock Text="{DynamicResource Refresh}" /></StackPanel>
          </Button>
          <Button Classes="subtle" Command="{Binding PopOutCommand}" IsEnabled="{Binding CanPopOut}"
                  ToolTip.Tip="{DynamicResource OpenPlayersSeparateWindow}" AutomationProperties.Name="Open the players in a window of their own">
            <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Window24" FontSize="14" />
              <TextBlock Text="{DynamicResource Popout}" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{DynamicResource BmShortcuts}" Classes="muted" FontSize="12" />
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding ManualId}" PlaceholderText="{DynamicResource ManualTrackPlaceholder}"
                 AutomationProperties.Name="Track a player by name or Steam ID" />
        <Button Grid.Column="1" Classes="primary" Command="{Binding AddManualCommand}" AutomationProperties.Name="Track player">
          <TextBlock Text="{DynamicResource Track}" />
        </Button>
      </Grid>
    </StackPanel>

    <!-- The tracked half: the bookmarks, by the server they were seen on and by their group. -->
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" IsVisible="{Binding IsTrackedTab}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="{DynamicResource TrackedPlayers}" Classes="title" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="subtle" Command="{Binding OpenGroupManagerCommand}"
                ToolTip.Tip="Create a group and put the players in it" AutomationProperties.Name="Manage groups">
          <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Group24" FontSize="14" />
            <TextBlock Text="{DynamicResource ManageGroups}" /></StackPanel>
        </Button>
      </Grid>
      <TextBox Grid.Row="1" Text="{Binding Filter}" PlaceholderText="{DynamicResource FilterPlayersPlaceholder}"
               AutomationProperties.Name="Filter tracked players" />
      <Border Grid.Row="2" Classes="panel" Padding="12" IsVisible="{Binding IsManagingGroups}" Margin="0,0,0,8">
        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource CodeUiManagePlayerGroup}" Classes="section" />
          <TextBox Text="{Binding GroupName}" PlaceholderText="{DynamicResource EnterGroupNamePlaceholder}"
                   AutomationProperties.Name="The name of the group" />
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <Button Classes="subtle" Margin="0,0,4,4" Padding="8,4" Content="{Binding}"
                        Command="{Binding $parent[ItemsControl].((vm:PlayersViewModel)DataContext).ChooseGroupCommand}"
                        CommandParameter="{Binding}" AutomationProperties.Name="Edit the group" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ComboBox ItemsSource="{Binding GroupColours}" SelectedItem="{Binding GroupColour}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="The colour of the group" />
          <TextBlock Text="{Binding GroupError}" Foreground="{DynamicResource ConnectionDanger}" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding GroupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding GroupPlayers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackedPlayerRow">
                  <CheckBox Margin="0,2,0,2" IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="subtle" Content="{DynamicResource Cancel}" Command="{Binding CancelGroupManagerCommand}"
                    AutomationProperties.Name="Close the group manager" />
            <Button Classes="primary" Content="{DynamicResource SaveGroup}" Command="{Binding SaveGroupCommand}"
                    AutomationProperties.Name="Save the group" />
          </StackPanel>
        </StackPanel>
      </Border>
      <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="6">
          <ItemsControl ItemsSource="{Binding Servers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TrackedPlayerServerRow">
                <StackPanel Spacing="4">
                  <TextBlock Classes="colHeader" Text="{Binding Name}" />
                  <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TrackedPlayerGroupRow">
                        <StackPanel Spacing="2">
                          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="6">
                            <ToggleButton Classes="subtle" IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                          Command="{Binding $parent[ItemsControl].((vm:PlayersViewModel)DataContext).ToggleGroupCommand}"
                                          CommandParameter="{Binding}" ToolTip.Tip="Fold the group away or open it"
                                          AutomationProperties.Name="Fold the group away or open it">
                              <icons:Icon Symbol="ChevronRight24" FontSize="12" />
                            </ToggleButton>
                            <Border Grid.Column="1" Classes="dot" Background="{Binding Colour}" IsVisible="{Binding Colour, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Grid.Column="2" Classes="cell" MaxWidth="220" Text="{Binding GroupName}" VerticalAlignment="Center" ToolTip.Tip="{Binding GroupName}" />
                            <Button Grid.Column="3" Classes="icon" Command="{Binding $parent[ItemsControl].((vm:PlayersViewModel)DataContext).MoveGroupUpCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="Move the group up" AutomationProperties.Name="Move the group up">
                              <icons:Icon Symbol="ArrowUp24" FontSize="12" />
                            </Button>
                            <Button Grid.Column="4" Classes="icon" Command="{Binding $parent[ItemsControl].((vm:PlayersViewModel)DataContext).MoveGroupDownCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="Move the group down" AutomationProperties.Name="Move the group down">
                              <icons:Icon Symbol="ArrowDown24" FontSize="12" />
                            </Button>
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Players}" IsVisible="{Binding IsExpanded}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:TrackedPlayerRow">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="18,2,0,2">
                                  <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource SurfaceAlt}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initial}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Border>
                                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Classes="cell" Text="{Binding Name}" ToolTip.Tip="{Binding Name}"
                                               IsVisible="{Binding !IsRenaming}" />
                                    <TextBox Text="{Binding Name}" IsVisible="{Binding IsRenaming}" FontSize="13"
                                             KeyDown="OnNameKeyDown" AutomationProperties.Name="The new name of the player" />
                                    <TextBlock Classes="muted" FontSize="11" Text="{Binding BMId}" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="2" Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding PlayTime}" />
                                  <ComboBox Grid.Column="3" Width="140" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsGrouping}"
                                            ItemsSource="{Binding $parent[ItemsControl].((vm:PlayersViewModel)DataContext).Groups}"
                                            SelectedItem="{Binding GroupName}" IsEditable="True"
                                            AutomationProperties.Name="The group of the player" />
                                  <TextBlock Grid.Column="3" Classes="cell" VerticalAlignment="Center" IsVisible="{Binding !IsGrouping}"
                                             Text="{Binding GroupName}" />
                                  <Button Grid.Column="4" Classes="icon" IsVisible="{Binding !IsRenaming}"
                                          Command="{Binding $parent[ItemsControl].((vm:PlayersViewModel)DataContext).EditNameCommand}"
                                          CommandParameter="{Binding}" ToolTip.Tip="Give the player another name" AutomationProperties.Name="Rename the player">
                                    <icons:Icon Symbol="Edit24" FontSize="13" />
                                  </Button>
                                  <Button Grid.Column="4" Classes="icon" IsVisible="{Binding !IsGrouping}"
                                          Command="{Binding $parent[ItemsControl].((vm:PlayersViewModel)DataContext).EditGroupCommand}"
                                          CommandParameter="{Binding}" ToolTip.Tip="Put the player in a group" AutomationProperties.Name="Group the player">
                                    <icons:Icon Symbol="Tag24" FontSize="13" />
                                  </Button>
                                  <Button Grid.Column="5" Classes="icon" IsVisible="{Binding !IsRenaming}"
                                          Command="{Binding $parent[ItemsControl].((vm:PlayersViewModel)DataContext).RemoveCommand}"
                                          CommandParameter="{Binding}" ToolTip.Tip="Stop tracking the player" AutomationProperties.Name="Stop tracking the player">
                                    <icons:Icon Symbol="Dismiss24" FontSize="13" Foreground="IndianRed" />
                                  </Button>
                                  <Button Grid.Column="4" Classes="icon" IsVisible="{Binding IsRenaming}"
                                          Command="{Binding $parent[ItemsControl].((vm:PlayersViewModel)DataContext).SaveCommand}"
                                          CommandParameter="{Binding}" ToolTip.Tip="Keep the change" AutomationProperties.Name="Keep the change">
                                    <icons:Icon Symbol="Checkmark24" FontSize="13" />
                                  </Button>
                                  <Button Grid.Column="5" Classes="icon" IsVisible="{Binding IsRenaming}"
                                          Command="{Binding $parent[ItemsControl].((vm:PlayersViewModel)DataContext).CancelCommand}"
                                          CommandParameter="{Binding}" ToolTip.Tip="Leave the player as it was" AutomationProperties.Name="Leave the player as it was">
                                    <icons:Icon Symbol="Dismiss24" FontSize="13" />
                                  </Button>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{DynamicResource CodeUiNoResultsFoundMatchingFilter}" Classes="muted" HorizontalAlignment="Center"
                     IsVisible="{Binding HasNoMatches}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
