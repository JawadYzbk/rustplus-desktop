<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Chat"
             xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
             xmlns:shared="using:RustPlusDesk.Avalonia.Shared.Controls"
             xmlns:alerts="using:RustPlusDesk.Avalonia.Features.Alerts"
             xmlns:core="clr-namespace:RustPlusDesk.Core.Chat;assembly=RustPlusDesk.Core"
             x:Class="RustPlusDesk.Avalonia.Features.Chat.ChatView" x:DataType="vm:ChatViewModel">
  <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="6">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasClan}" VerticalAlignment="Center">
        <RadioButton Classes="chip" Content="Team" IsChecked="{Binding !IsClan}" GroupName="ChatChannel" AutomationProperties.Name="Team chat" />
        <RadioButton Classes="chip" Content="Clan" IsChecked="{Binding IsClan}" GroupName="ChatChannel" AutomationProperties.Name="Clan chat" />
      </StackPanel>
      <Grid Grid.Column="1" x:Name="SearchRow" ColumnDefinitions="*,Auto" IsVisible="{Binding IsSearchOpen}">
        <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="Search messages or names…" AutomationProperties.Name="Search chat" />
        <Button Grid.Column="1" Classes="icon" Command="{Binding ClearSearchCommand}" ToolTip.Tip="Clear search" AutomationProperties.Name="Clear chat search"
                Margin="4,0,0,0"><icons:Icon Symbol="Dismiss24" /></Button>
      </Grid>
      <StackPanel Grid.Column="2" x:Name="AlertsBar" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                  DataContext="{Binding Alerts}" x:DataType="alerts:ChatAlertsViewModel"
                  IsVisible="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).Alerts, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
        <ToggleButton x:Name="AlertsToggle" Classes="chip" IsChecked="{Binding IsMasterOn, Mode=OneWay}" Command="{Binding ToggleMasterCommand}"
                      ToolTip.Tip="{Binding MasterTip}" AutomationProperties.Name="Chat alerts" Padding="8,4">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <icons:Icon Symbol="Alert24" />
            <Border Classes="count" IsVisible="{Binding ShowCountBadge}" VerticalAlignment="Center">
              <TextBlock Text="{Binding CountText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}" />
            </Border>
            <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" IsVisible="{Binding ShowEmptyDot}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <Button x:Name="AlertsMenuButton" Classes="icon" ToolTip.Tip="Choose chat alerts" AutomationProperties.Name="Choose chat alerts">
          <icons:Icon Symbol="ChevronDown24" FontSize="14" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Shops" IsEnabled="False" />
              <MenuItem Header="New shops" ToggleType="CheckBox" IsChecked="{Binding AnnounceNewShops, Mode=OneWay}"
                        IsEnabled="{Binding IsMasterOn}" Command="{Binding ToggleNewShopsCommand}" />
              <MenuItem Header="Suspicious shops" ToggleType="CheckBox" IsChecked="{Binding AnnounceSuspiciousShops, Mode=OneWay}"
                        IsEnabled="{Binding IsMasterOn}" Command="{Binding ToggleSuspiciousShopsCommand}" />
              <MenuItem Header="{Binding TradeAlertsHeader}" IsEnabled="{Binding HasTradeAlerts}" ItemsSource="{Binding TradeAlerts}">
                <MenuItem.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="alerts:TradeAlertMenuItem">
                    <Setter Property="Header" Value="{Binding Header}" />
                    <Setter Property="ToggleType" Value="CheckBox" />
                    <Setter Property="IsChecked" Value="{Binding NotifyChat, Mode=OneWay}" />
                    <Setter Property="Command" Value="{Binding ToggleCommand}" />
                  </ControlTheme>
                </MenuItem.ItemContainerTheme>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
      <ToggleButton Grid.Column="3" Classes="chip" IsChecked="{Binding IsSearchOpen, Mode=OneWay}" Command="{Binding ToggleSearchCommand}"
                    IsVisible="{Binding IsConnected}"
                    ToolTip.Tip="Search chat" AutomationProperties.Name="Toggle chat search" Padding="8,4"><icons:Icon Symbol="Search24" /></ToggleButton>
    </Grid>
    <Grid Grid.Row="1">
      <TextBlock Text="Connect to a server to read and send team chat." Classes="muted" TextWrapping="Wrap"
                 IsVisible="{Binding !IsConnected}" VerticalAlignment="Center" HorizontalAlignment="Center" />
      <TextBlock Text="No messages match your search." Classes="muted" IsVisible="{Binding HasNoMatches}"
                 VerticalAlignment="Center" HorizontalAlignment="Center" />
      <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsConnected}">
        <ItemsControl ItemsSource="{Binding Lines}" AutomationProperties.Name="Chat messages">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatLine">
              <vm:ChatMessageText TextWrapping="Wrap" Margin="0,2" Background="Transparent" Line="{Binding}"
                                  Catalog="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).Emoji}">
                <vm:ChatMessageText.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy text" Click="CopyText"><MenuItem.Icon><icons:Icon Symbol="Copy24" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Copy Steam ID" Click="CopySteamId" IsVisible="{Binding HasSteamId}" />
                    <MenuItem Header="Mention @User" Click="Mention" />
                    <MenuItem Header="Center on map" IsVisible="{Binding HasSteamId}" CommandParameter="{Binding}"
                              Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).CenterOnAuthorCommand}">
                      <MenuItem.Icon><icons:Icon Symbol="Location24" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Open Steam profile" Click="OpenSteamProfile" IsVisible="{Binding HasSteamId}" />
                  </ContextMenu>
                </vm:ChatMessageText.ContextMenu>
              </vm:ChatMessageText>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="2">
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ConnectionDanger}" FontSize="12" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding Notice}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                 IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
      <TextBox x:Name="DraftBox" Text="{Binding Draft}" PlaceholderText="Message your team…" MaxLength="128" IsEnabled="{Binding IsConnected}"
               AutomationProperties.Name="Chat message" />
      <Popup PlacementTarget="{Binding #DraftBox}" Placement="TopEdgeAlignedLeft" IsOpen="{Binding IsEmojiSuggestionsOpen}" IsLightDismissEnabled="False">
        <Border Classes="panel" Background="{DynamicResource Surface}" Padding="4" BoxShadow="0 6 18 0 #66000000" Width="280">
          <ListBox x:Name="EmojiSuggestionList" ItemsSource="{Binding EmojiSuggestions}" SelectedItem="{Binding SelectedEmojiSuggestion}" MaxHeight="240"
                   Background="Transparent" Tapped="EmojiSuggestionTapped" AutomationProperties.Name="Emoji suggestions">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:ChatEmoji">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EmojiPicture}" />
                  <TextBlock Text="{Binding Tag}" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Popup>
      <Button Grid.Column="1" x:Name="EmojiButton" Classes="icon" IsEnabled="{Binding IsConnected}" ToolTip.Tip="Insert emoji" AutomationProperties.Name="Insert emoji">
        <icons:Icon Symbol="Emoji24" />
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedRight" Opened="EmojiPickerOpened">
            <StackPanel Width="300" Spacing="8">
              <TextBox x:Name="EmojiSearch" Text="{Binding EmojiPickerQuery}" PlaceholderText="Search emojis or items…" AutomationProperties.Name="Search emojis" />
              <TextBlock Text="No emoji or item matches." Classes="muted" FontSize="12" IsVisible="{Binding HasNoEmojiPickerItems}" />
              <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding EmojiPickerItems}" AutomationProperties.Name="Emoji picker">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:ChatEmoji">
                      <Button Classes="icon" Width="36" Height="36" Click="EmojiPicked" ToolTip.Tip="{Binding ToolTip}" AutomationProperties.Name="{Binding Tag}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EmojiPicture}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <TextBlock Grid.Column="2" Text="{Binding CharacterCount}" VerticalAlignment="Center" FontSize="11"
                 Classes="muted" Classes.limit="{Binding IsAtLimit}" />
      <Button Grid.Column="3" Classes="primary" Command="{Binding SendCommand}" AutomationProperties.Name="Send chat message" ToolTip.Tip="Send (Enter)">
        <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Send24" FontSize="16" /><TextBlock Text="Send" /></StackPanel>
      </Button>
    </Grid>
  </Grid>
  <UserControl.Resources>
    <DataTemplate x:Key="EmojiPicture" x:DataType="core:ChatEmoji">
      <Panel Width="22" Height="22">
        <Image Source="{Binding Name, Converter={x:Static vm:ChatEmojiImages.Custom}}" IsVisible="{Binding IsCustom}" />
        <shared:ItemIcon ShortName="{Binding Name}" IsVisible="{Binding !IsCustom}" />
      </Panel>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.count">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="MinWidth" Value="14" />
      <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style Selector="Border.count TextBlock"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
    <Style Selector="TextBlock.limit"><Setter Property="Foreground" Value="{DynamicResource ConnectionDanger}" /></Style>
  </UserControl.Styles>
</UserControl>
