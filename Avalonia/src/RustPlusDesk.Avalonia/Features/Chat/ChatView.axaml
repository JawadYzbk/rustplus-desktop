<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Chat"
             xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
             x:Class="RustPlusDesk.Avalonia.Features.Chat.ChatView" x:DataType="vm:ChatViewModel">
  <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="6">
    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasClan}">
      <RadioButton Content="Team" IsChecked="{Binding !IsClan}" GroupName="ChatChannel" AutomationProperties.Name="Team chat" />
      <RadioButton Content="Clan" IsChecked="{Binding IsClan}" GroupName="ChatChannel" AutomationProperties.Name="Clan chat" />
    </StackPanel>
    <Grid Grid.Row="1">
      <TextBlock Text="Connect to a server to read and send team chat." Classes="muted" TextWrapping="Wrap"
                 IsVisible="{Binding !IsConnected}" VerticalAlignment="Center" HorizontalAlignment="Center" />
      <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsConnected}">
        <ItemsControl ItemsSource="{Binding Lines}" AutomationProperties.Name="Chat messages">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatLine">
              <TextBlock TextWrapping="Wrap" Margin="0,2">
                <Run Text="{Binding Time}" Foreground="{DynamicResource TextSubtle}" FontSize="11" />
                <Run Text=" " /><Run Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                <Run Text=": " /><Run Text="{Binding Text}" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="{DynamicResource ConnectionDanger}" FontSize="12" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBox Text="{Binding Draft}" PlaceholderText="Message your team…" MaxLength="128" IsEnabled="{Binding IsConnected}"
               KeyDown="DraftKeyDown" AutomationProperties.Name="Chat message" />
      <TextBlock Grid.Column="1" Text="{Binding CharacterCount}" VerticalAlignment="Center" FontSize="11"
                 Classes="muted" Classes.limit="{Binding IsAtLimit}" />
      <Button Grid.Column="2" Command="{Binding SendCommand}" AutomationProperties.Name="Send chat message" ToolTip.Tip="Send (Enter)">
        <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Send24" FontSize="16" /><TextBlock Text="Send" /></StackPanel>
      </Button>
    </Grid>
  </Grid>
  <UserControl.Styles>
    <Style Selector="TextBlock.limit"><Setter Property="Foreground" Value="{DynamicResource ConnectionDanger}" /></Style>
  </UserControl.Styles>
</UserControl>
