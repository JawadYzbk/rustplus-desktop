<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tutorials="using:RustPlusDesk.Avalonia.Features.Tutorials"
             xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
             x:Class="RustPlusDesk.Avalonia.Features.Tutorials.TutorialsView"
             x:DataType="tutorials:TutorialsViewModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <StackPanel Spacing="4">
      <TextBlock Text="{DynamicResource Tutorials.Center.Title}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource Tutorials.Center.Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>

    <!--  Reference the tutorial centre's own row of buttons: the recommended tour, the one that was last run, and the
          switches that decide whether the app offers a tour by itself.  -->
    <WrapPanel Grid.Row="1">
      <Button Classes="primary" Command="{Binding StartRecommendedCommand}" Margin="0,0,8,8"
              AutomationProperties.Name="Start the recommended tutorial">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <icons:Icon Symbol="Play24" FontSize="13" />
          <TextBlock Text="{DynamicResource Tutorials.Center.StartRecommended}" />
        </StackPanel>
      </Button>
      <Button Classes="subtle" Command="{Binding ContinueLastCommand}" IsEnabled="{Binding CanContinueLast}" Margin="0,0,8,8"
              AutomationProperties.Name="Continue the last tutorial">
        <TextBlock Text="{DynamicResource Tutorials.Center.ContinueLast}" />
      </Button>
      <Button Classes="subtle" Command="{Binding ResetAllCommand}" Margin="0,0,8,8"
              AutomationProperties.Name="Forget the progress of every tutorial">
        <TextBlock Text="{DynamicResource Tutorials.Center.ResetProgress}" />
      </Button>
      <CheckBox IsChecked="{Binding AutoStartBasic, Mode=TwoWay}" Content="{DynamicResource Tutorials.Center.AutoBasic}"
                Margin="0,0,16,8" AutomationProperties.Name="Start the basic tour by itself" />
      <CheckBox IsChecked="{Binding AutoStartNewFeatures, Mode=TwoWay}" Content="{DynamicResource Tutorials.Center.AutoFeatures}"
                Margin="0,0,0,8" AutomationProperties.Name="Offer the new features' tours by itself" />
    </WrapPanel>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="tutorials:TutorialCategoryGroup">
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                         Margin="0,6,0,8" />

              <ItemsControl ItemsSource="{Binding Tutorials}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="tutorials:TutorialRow">
                    <!--  Reference the tutorial centre's card: the name, what it is about, how far through it the
                          player is, and the buttons that start it again or forget it.  -->
                    <Border Classes="card" Padding="16" Margin="0,0,0,10">
                      <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <icons:Icon Symbol="Book24" FontSize="18" Foreground="{DynamicResource Accent}" />
                          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="7,3"
                                  IsVisible="{Binding IsNewFeature}">
                            <TextBlock Text="{DynamicResource Tutorials.Status.NewFeature}" FontSize="11" FontWeight="Bold" />
                          </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock Text="{Binding ProgressLabel}" Classes="muted" FontSize="11" />
                          <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="11" Foreground="{DynamicResource Accent}" />
                        </Grid>
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                          <Button Classes="subtle" Click="OnReset" AutomationProperties.Name="Forget this tutorial's progress">
                            <TextBlock Text="{DynamicResource Tutorials.Common.Reset}" />
                          </Button>
                          <Button Classes="subtle" Click="OnRestart" AutomationProperties.Name="Start this tutorial again">
                            <TextBlock Text="{DynamicResource Tutorials.Common.Restart}" />
                          </Button>
                          <Button Classes="primary" Click="OnStart" AutomationProperties.Name="Start this tutorial">
                            <TextBlock Text="{Binding PrimaryActionLabel}" />
                          </Button>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
