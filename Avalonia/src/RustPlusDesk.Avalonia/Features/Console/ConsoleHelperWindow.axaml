<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RustPlusDesk.Avalonia.Features.Console" xmlns:console="using:RustPlusDesk.Avalonia.Features.Console"
        x:Class="RustPlusDesk.Avalonia.Features.Console.ConsoleHelperWindow" x:DataType="vm:ConsoleHelperViewModel"
        Title="Console Helper" Width="520" Height="720" MinWidth="380" MinHeight="320" Topmost="True">
  <!-- Reference popout: an always-on-top window to keep beside Rust (borderless or windowed) while the F1 console is open. -->
  <Border Background="{DynamicResource Surface}" Padding="14">
    <console:ConsoleHelperView />
  </Border>
</Window>
