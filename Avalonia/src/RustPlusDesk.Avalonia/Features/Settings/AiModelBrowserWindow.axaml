<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ai="using:RustPlusDesk.Avalonia.Features.Settings"
        xmlns:core="using:RustPlusDesk.Core.Ai"
        xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
        x:Class="RustPlusDesk.Avalonia.Features.Settings.AiModelBrowserWindow" x:DataType="ai:AiModelBrowserViewModel"
        Title="{DynamicResource AiCompanionOpenRouterBrowse}" Width="720" Height="560" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10" Margin="16">
    <TextBlock Text="{DynamicResource AiCompanionOpenRouterBrowse}" FontSize="18" FontWeight="SemiBold" />

    <!--  Reference the browser's own toolbar: the search box, the free-only switch and the refresh. The search
          narrows the list as it is typed, and the refresh goes back to OpenRouter rather than to the cache.  -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBox Text="{Binding Search, Mode=TwoWay}" PlaceholderText="Search the models" AutomationProperties.Name="Search the models" />
      <CheckBox Grid.Column="1" IsChecked="{Binding FreeOnly, Mode=TwoWay}" Content="Free only"
                VerticalAlignment="Center" AutomationProperties.Name="Show only the free models" />
      <Button Grid.Column="2" Command="{Binding RefreshCommand}" ToolTip.Tip="{DynamicResource AiCompanionOpenRouterRefreshTip}"
              AutomationProperties.Name="Refresh the model catalogue">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <icons:Icon Symbol="ArrowSync24" FontSize="14" />
          <TextBlock Text="Refresh" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <ListBox ItemsSource="{Binding Models}" SelectedItem="{Binding Selected, Mode=TwoWay}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="OpenRouter models">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:OpenRouterModelInfo">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4">
              <StackPanel Grid.Column="0" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Text="{Binding Id}" FontSize="11" Classes="muted" />
                </StackPanel>
                <TextBlock Text="{Binding Description}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding PricingSummary}" FontSize="11" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding ContextSummary}" FontSize="11" Classes="muted" HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!--  Reference the browser's detail pane: the model that is highlighted, and what it is.  -->
      <Border Grid.Column="1" Width="220" Classes="card" Padding="12" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Selected.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Selected.Id}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Selected.Description}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Selected.PricingSummary}" FontSize="11" />
          <TextBlock Text="{Binding Selected.FormattedContextLength}" FontSize="11" Classes="muted" />
          <TextBlock Text="{Binding Selected.FormattedMaxOutput}" FontSize="11" Classes="muted" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="subtle" Content="Cancel" Click="OnCancel" AutomationProperties.Name="Close the model browser" />
        <Button Classes="primary" Click="OnPick" AutomationProperties.Name="Use the selected model">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:Icon Symbol="Checkmark24" FontSize="14" />
            <TextBlock Text="Use this model" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
