<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Settings"
             xmlns:devices="using:RustPlusDesk.Avalonia.Features.Devices"
             xmlns:logic="using:RustPlusDesk.Avalonia.Features.Logic"
             xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
             x:Class="RustPlusDesk.Avalonia.Features.Settings.SettingsView" x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.muted.error"><Setter Property="Foreground" Value="{DynamicResource ConnectionDanger}" /></Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Stretch">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:Icon Symbol="Settings24" FontSize="18" Foreground="{DynamicResource Accent}" />
        <StackPanel>
          <TextBlock Text="General" Classes="title" />
          <TextBlock Text="Startup and app behavior" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="STARTUP" Classes="section" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Auto-connect to last server on startup" FontWeight="SemiBold" />
              <TextBlock Text="Automatically reconnects to the last server and loads the map." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoConnect}" OnContent="" OffContent="" AutomationProperties.Name="Auto-connect to last server on startup" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{Binding AutoStartLabel}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding AutoStartNote}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AutoStartError}" Foreground="{DynamicResource ConnectionDanger}" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding AutoStartError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStart}" IsEnabled="{Binding CanAutoStart}" OnContent="" OffContent=""
                          AutomationProperties.Name="{Binding AutoStartLabel}" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="16" IsVisible="{Binding HasMap}">
        <StackPanel Spacing="12">
          <TextBlock Text="BEHAVIOR" Classes="section" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasActivity}">
            <StackPanel>
              <TextBlock Text="Hide system console" FontWeight="SemiBold" />
              <TextBlock Text="Hides the bottom Activity log to declutter; team chat stays." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Activity.IsHidden, FallbackValue=False}" OnContent="" OffContent=""
                          AutomationProperties.Name="Hide system console" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Streamer mode" FontWeight="SemiBold" />
              <TextBlock Text="Abbreviates Steam names and IDs to protect privacy during streams, hides server names, and hides the console and server list."
                         Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Map.AbbreviateNames, FallbackValue=False}" OnContent="" OffContent=""
                          AutomationProperties.Name="Streamer mode" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
            <StackPanel>
              <TextBlock Text="Player icon size" FontWeight="SemiBold" />
              <TextBlock Text="Size of team player markers on the map." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Map.PlayerIconScale, StringFormat='{}{0:0%}', FallbackValue=''}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0.5" Maximum="1.5" Value="{Binding Map.PlayerIconScale, FallbackValue=1}"
                    AutomationProperties.Name="Player icon size" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="16" IsVisible="{Binding HasMap}">
        <StackPanel Spacing="12">
          <TextBlock Text="MAP PERFORMANCE" Classes="section" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel>
              <TextBlock Text="Image scaling quality" FontWeight="SemiBold" />
              <TextBlock Text="Controls the map image scaling filter." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="210" SelectedIndex="{Binding Map.BitmapScalingMode, FallbackValue=0}" AutomationProperties.Name="Image scaling quality">
              <ComboBoxItem Content="High quality (bicubic)" />
              <ComboBoxItem Content="Balanced (linear)" />
              <ComboBoxItem Content="Performance (nearest neighbour)" />
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Enable GPU bitmap caching" FontWeight="SemiBold" />
              <TextBlock Text="Caches the map scene; extremely improves panning and zooming smoothness." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Map.UseCacheMode, FallbackValue=False}" OnContent="" OffContent=""
                          AutomationProperties.Name="Enable GPU bitmap caching" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsEnabled="{Binding Map.UseCacheMode, FallbackValue=False}">
            <StackPanel>
              <TextBlock Text="GPU rendering scale" FontWeight="SemiBold" />
              <TextBlock Text="Resolution scale of the cached map scene. Lower scales improve performance." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="210" SelectedIndex="{Binding Map.RenderScaleIndex, FallbackValue=2}" AutomationProperties.Name="GPU rendering scale">
              <ComboBoxItem Content="50% (fastest)" />
              <ComboBoxItem Content="75% (performance)" />
              <ComboBoxItem Content="100% (native)" />
              <ComboBoxItem Content="125% (sharp)" />
              <ComboBoxItem Content="150% (high resolution)" />
              <ComboBoxItem Content="200% (ultra high resolution)" />
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Disable grid anti-aliasing (aliased edge mode)" FontWeight="SemiBold" />
              <TextBlock Text="Disables anti-aliasing on grid lines and markers; improves rendering performance." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Map.UseAliasedEdgeMode, FallbackValue=False}" OnContent="" OffContent=""
                          AutomationProperties.Name="Disable grid anti-aliasing (aliased edge mode)" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="16" IsVisible="{Binding HasMap}">
        <StackPanel Spacing="12">
          <TextBlock Text="TEAM MARKERS" Classes="section" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Profile markers" FontWeight="SemiBold" />
              <TextBlock Text="Show circular team member markers with Steam avatars on the map." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Map.ShowSteamAvatars, FallbackValue=True}" OnContent="" OffContent=""
                          AutomationProperties.Name="Profile markers" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Player direction arrows" FontWeight="SemiBold" />
              <TextBlock Text="Show a direction arrow pointing where each player is facing." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Map.ShowPlayerArrows, FallbackValue=True}" OnContent="" OffContent=""
                          AutomationProperties.Name="Player direction arrows" />
          </Grid>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0" IsVisible="{Binding HasCustomMap}">
        <icons:Icon Symbol="Map24" FontSize="18" Foreground="{DynamicResource Accent}" />
        <StackPanel>
          <TextBlock Text="Map" Classes="title" />
          <TextBlock Text="Map image of the selected server" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <Border Classes="panel" Padding="16" IsVisible="{Binding HasCustomMap}">
        <StackPanel Spacing="8">
          <TextBlock Text="CUSTOM HD MAP IMAGE" Classes="section" />
          <TextBlock Text="Use a custom high-definition map image from a URL source instead of the map coming from the server. Cached locally and automatically wiped when a server wipe is detected."
                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="Custom Map Image URL" FontWeight="SemiBold" Margin="0,4,0,0" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding CustomMap.Url, FallbackValue=''}" PlaceholderText="https://example.com/rust_map_hd.png"
                     AutomationProperties.Name="Custom map image URL" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Classes="primary" Content="Apply" Command="{Binding CustomMap.ApplyCommand, FallbackValue={x:Null}}"
                    AutomationProperties.Name="Apply custom map URL" />
            <Button Grid.Column="2" Classes="subtle" Content="Clear" Command="{Binding CustomMap.ClearCommand, FallbackValue={x:Null}}"
                    AutomationProperties.Name="Clear custom map URL" />
          </Grid>
          <TextBlock Text="{Binding CustomMap.Status, FallbackValue=''}" FontSize="12" TextWrapping="Wrap"
                     Classes="muted" Classes.error="{Binding CustomMap.IsError, FallbackValue=False}" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0" IsVisible="{Binding HasChatCommands}">
        <icons:Icon Symbol="Chat24" FontSize="18" Foreground="{DynamicResource Accent}" />
        <StackPanel>
          <TextBlock Text="Chat Commands" Classes="title" />
          <TextBlock Text="Answer commands typed in team chat" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <Border Classes="panel" Padding="16" IsVisible="{Binding HasChatCommands}">
        <StackPanel Spacing="8">
          <TextBlock Text="CHAT COMMANDS" Classes="section" />
          <TextBlock Text="Commands in team chat are answered while the app is connected. Each server keeps its own prefix and command names."
                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <StackPanel>
              <TextBlock Text="Enable Chat Commands" FontWeight="SemiBold" />
              <TextBlock Text="Turn this off to stop answering every command on this server." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ChatCommands.Enabled, FallbackValue=True}" OnContent="" OffContent=""
                          AutomationProperties.Name="Enable chat commands" />
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="Prefix:" FontWeight="SemiBold" />
              <TextBox Text="{Binding ChatCommands.Prefix, FallbackValue='!'}" MaxLength="1" Width="80" HorizontalAlignment="Left"
                       AutomationProperties.Name="Chat command prefix" />
              <TextBlock Text="One of ! . , or \" Classes="muted" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Command Delay:" FontWeight="SemiBold" />
              <TextBox Text="{Binding ChatCommands.ResponseDelay, FallbackValue='0.5'}" Width="80" HorizontalAlignment="Left"
                       AutomationProperties.Name="Chat command response delay" />
              <TextBlock Text="Seconds to wait before an answer is sent (0 - 5)." Classes="muted" FontSize="12" />
            </StackPanel>
          </Grid>
          <TextBlock Text="STANDARD COMMANDS" Classes="section" Margin="0,8,0,0" />
          <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
            <TextBlock Text="Population:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding ChatCommands.Pop, FallbackValue=''}" AutomationProperties.Name="Population command name" />
            <TextBlock Grid.Row="1" Text="Time:" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ChatCommands.Time, FallbackValue=''}" AutomationProperties.Name="Time command name" />
            <TextBlock Grid.Row="2" Text="Promote:" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ChatCommands.Promote, FallbackValue=''}" AutomationProperties.Name="Promote command name" />
            <TextBlock Grid.Row="3" Text="Deep Sea:" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ChatCommands.DeepSea, FallbackValue=''}" AutomationProperties.Name="Deep Sea command name" />
            <TextBlock Grid.Row="4" Text="Cargo Ship:" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ChatCommands.Cargo, FallbackValue=''}" AutomationProperties.Name="Cargo Ship command name" />
            <TextBlock Grid.Row="5" Text="Patrol Heli:" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ChatCommands.Heli, FallbackValue=''}" AutomationProperties.Name="Patrol Heli command name" />
            <TextBlock Grid.Row="6" Text="Travelling Vendor:" VerticalAlignment="Center" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ChatCommands.Vendor, FallbackValue=''}" AutomationProperties.Name="Travelling Vendor command name" />
            <TextBlock Grid.Row="7" Text="AFK Players" VerticalAlignment="Center" />
            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ChatCommands.Afk, FallbackValue=''}" AutomationProperties.Name="AFK command name" />
            <TextBlock Grid.Row="8" Text="List Chat Commands" VerticalAlignment="Center" />
            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ChatCommands.List, FallbackValue=''}" AutomationProperties.Name="List commands command name" />
            <TextBlock Grid.Row="9" Text="Oil Rig:" VerticalAlignment="Center" />
            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding ChatCommands.OilRig, FallbackValue=''}" AutomationProperties.Name="Oil rig command name" />
            <TextBlock Grid.Row="10" Text="Upkeep Detail:" VerticalAlignment="Center" />
            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding ChatCommands.UpkeepDetail, FallbackValue=''}" AutomationProperties.Name="Upkeep detail command name" />
            <TextBlock Grid.Row="11" Text="Base Codes:" VerticalAlignment="Center" />
            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding ChatCommands.BaseCodes, FallbackValue=''}" AutomationProperties.Name="Base codes command name" />
            <TextBlock Grid.Row="12" Text="Custom Timer:" VerticalAlignment="Center" />
            <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding ChatCommands.CustomTimer, FallbackValue=''}" AutomationProperties.Name="Custom timer command name" />
            <TextBlock Grid.Row="13" Text="Ask AI:" VerticalAlignment="Center" />
            <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding ChatCommands.Ai, FallbackValue=''}" AutomationProperties.Name="Ask AI command name" />
          </Grid>
          <TextBlock Text="BASE CODES" Classes="section" Margin="0,8,0,0" />
          <TextBlock Text="Labelled door codes answered by the base-code command. Only four-digit codes are sent, and blank rows are ignored."
                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ChatCommands.BaseCodeRows, FallbackValue={x:Null}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3,0,0">
                  <TextBox Text="{Binding Code, FallbackValue=''}" Width="90" MaxLength="4"
                           PlaceholderText="Code" AutomationProperties.Name="Base door code" />
                  <TextBox Text="{Binding Label, FallbackValue=''}" Width="220"
                           PlaceholderText="Label (Doorcode)" AutomationProperties.Name="Base code label" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="CLAN CHAT" Classes="section" Margin="0,8,0,0" />
          <TextBlock Text="A clan holds up to a hundred accounts, so commands in clan chat are off unless you turn them on and grant a role."
                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <CheckBox IsChecked="{Binding ChatCommands.ClanCommandsEnabled, FallbackValue=False}"
                    Content="Answer chat commands in clan chat" AutomationProperties.Name="Allow clan chat commands" />
          <CheckBox IsChecked="{Binding ChatCommands.ClanAllowBaseCodes, FallbackValue=False}"
                    Content="Allow clan chat to read the base codes" AutomationProperties.Name="Allow clan base codes" />
          <CheckBox IsChecked="{Binding ChatCommands.ClanAllowSwitches, FallbackValue=False}"
                    Content="Allow clan chat to toggle mapped switches" AutomationProperties.Name="Allow clan switches" />
          <CheckBox IsChecked="{Binding ChatCommands.ClanAllowAi, FallbackValue=False}"
                    Content="Allow clan chat to use the AI command" AutomationProperties.Name="Allow clan AI command" />
          <ItemsControl ItemsSource="{Binding ChatCommands.ClanRoles, FallbackValue={x:Null}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Allowed, FallbackValue=False}" Margin="0,3,0,0"
                          Content="{Binding Name}" AutomationProperties.Name="Clan role permission" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Classes="primary" Content="Apply" Command="{Binding ChatCommands.ApplyCommand, FallbackValue={x:Null}}"
                    AutomationProperties.Name="Apply chat commands" />
            <TextBlock Text="{Binding ChatCommands.Status, FallbackValue=''}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                       Classes="muted" Classes.error="{Binding ChatCommands.IsError, FallbackValue=False}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0" IsVisible="{Binding HasAutomation, FallbackValue=False}">
        <icons:Icon Symbol="Play24" FontSize="18" Foreground="{DynamicResource Accent}" />
        <StackPanel>
          <TextBlock Text="Device Automation" Classes="title" />
          <TextBlock Text="Put a paired switch on or off when a condition holds" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <Border Classes="panel" Padding="16" IsVisible="{Binding HasAutomation, FallbackValue=False}">
        <StackPanel Spacing="12">
          <TextBlock Text="AUTOMATION" Classes="section" />
          <TextBlock Text="Each server keeps its own rules. A rule reads the team and the game clock and drives one paired switch."
                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Enable device automation" FontWeight="SemiBold" />
              <TextBlock Text="Turn this off to stop every rule on this server." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Automation.Enabled, FallbackValue=False}" OnContent="" OffContent=""
                          AutomationProperties.Name="Enable device automation" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Automation.Rules, FallbackValue={x:Null}}" AutomationProperties.Name="Device automation rules">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="panel" Padding="12" Margin="0,0,0,8">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                      <TextBox Text="{Binding Name, FallbackValue=''}" AutomationProperties.Name="Automation rule name" />
                      <ToggleButton Grid.Column="1" IsChecked="{Binding IsEnabled, FallbackValue=False}" Content="Enabled"
                                    AutomationProperties.Name="Automation rule enabled" />
                      <Button Grid.Column="2" Classes="subtle" Content="Remove" Command="{Binding $parent[ItemsControl].DataContext.Automation.RemoveRuleCommand}"
                              CommandParameter="{Binding}" AutomationProperties.Name="Remove automation rule" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                      <TextBlock Text="Condition" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding ConditionTypes}" SelectedItem="{Binding ConditionType}"
                                AutomationProperties.Name="Automation condition">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="devices:AutomationChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                      <TextBlock Text="Players" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding PlayerMatchModes}" SelectedItem="{Binding PlayerMatchMode}"
                                AutomationProperties.Name="Automation player match">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="devices:AutomationChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding IsSpecificMode}">
                      <TextBlock Text="Steam ID" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding SpecificPlayerSteamId, FallbackValue=''}" AutomationProperties.Name="Automation player Steam ID" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                      <TextBlock Text="Anchor device" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[ItemsControl].DataContext.Automation.DeviceChoices}"
                                SelectedItem="{Binding LocationDevice}" PlaceholderText="Choose a device" AutomationProperties.Name="Automation anchor device">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="devices:AutomationChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="2" Text="{Binding DistanceMeters, FallbackValue='250'}" Width="70" Margin="6,0,0,0"
                               AutomationProperties.Name="Automation distance in meters" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                      <TextBlock Text="From" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding StartTime, FallbackValue='20:00'}" AutomationProperties.Name="Automation start time" />
                      <TextBlock Grid.Column="2" Text="to" VerticalAlignment="Center" />
                      <TextBox Grid.Column="3" Text="{Binding EndTime, FallbackValue='08:00'}" AutomationProperties.Name="Automation end time" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                      <TextBlock Text="Target switch" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[ItemsControl].DataContext.Automation.DeviceChoices}"
                                SelectedItem="{Binding TargetDevice}" PlaceholderText="Choose a switch" AutomationProperties.Name="Automation target switch">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="devices:AutomationChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                      <TextBlock Text="While matched" VerticalAlignment="Center" />
                      <ToggleSwitch Grid.Column="1" IsChecked="{Binding MatchedState, FallbackValue=False}" OnContent="On" OffContent="Off"
                                    AutomationProperties.Name="Automation matched state" />
                      <TextBlock Grid.Column="2" Text="Otherwise" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="3" ItemsSource="{Binding UnmatchedChoices}" SelectedItem="{Binding UnmatchedChoice}"
                                AutomationProperties.Name="Automation unmatched state">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="devices:AutomationChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Automation.Anchors, FallbackValue={x:Null}}" AutomationProperties.Name="Automation anchor positions">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="devices:AutomationAnchorRow">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6" Margin="0,2,0,0">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MinWidth="140" />
                  <TextBlock Grid.Column="1" Text="{Binding Position}" Classes="muted" VerticalAlignment="Center" MinWidth="110" />
                  <ComboBox Grid.Column="2" ItemsSource="{Binding $parent[ItemsControl].DataContext.Automation.Teammates}"
                            SelectedItem="{Binding Teammate}" PlaceholderText="Choose a teammate" MinWidth="180"
                            AutomationProperties.Name="Automation anchor teammate" />
                  <Button Grid.Column="3" Classes="subtle" Content="Capture" Command="{Binding CaptureNowCommand}"
                          ToolTip.Tip="Take the device's position from that teammate" AutomationProperties.Name="Capture device position" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Classes="subtle" Content="Add rule" Command="{Binding Automation.AddRuleCommand, FallbackValue={x:Null}}"
                    AutomationProperties.Name="Add automation rule" />
            <Button Classes="primary" Content="Apply" Command="{Binding Automation.ApplyCommand, FallbackValue={x:Null}}"
                    AutomationProperties.Name="Apply device automation" />
            <TextBlock Text="{Binding Automation.Status, FallbackValue=''}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                       Classes="muted" Classes.error="{Binding Automation.IsError, FallbackValue=False}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0" IsVisible="{Binding HasLogicRules, FallbackValue=False}">
        <icons:Icon Symbol="Play24" FontSize="18" Foreground="{DynamicResource Accent}" />
        <StackPanel>
          <TextBlock Text="Logic Rules" Classes="title" />
          <TextBlock Text="Let a trigger run a short program of steps" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <Border Classes="panel" Padding="16" IsVisible="{Binding HasLogicRules, FallbackValue=False}">
        <StackPanel Spacing="12">
          <TextBlock Text="LOGIC ENGINE" Classes="section" />
          <TextBlock Text="A rule watches for a trigger, checks its condition and then runs its steps. The rules belong to
                         the selected server and are saved with it."
                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Enable the logic engine" FontWeight="SemiBold" />
              <TextBlock Text="Turn this off to stop every rule on this server." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding LogicRules.Enabled, FallbackValue=False}" OnContent="" OffContent=""
                          AutomationProperties.Name="Enable the logic engine" />
          </Grid>
          <ItemsControl ItemsSource="{Binding LogicRules.Rules, FallbackValue={x:Null}}" AutomationProperties.Name="Logic rules">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="logic:LogicRuleRowViewModel">
                <Border Classes="panel" Padding="12" Margin="0,0,0,8">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                      <TextBox Text="{Binding Name, FallbackValue=''}" AutomationProperties.Name="Logic rule name" />
                      <ToggleButton Grid.Column="1" Classes="subtle" IsChecked="{Binding IsEnabled, FallbackValue=False}" Content="Enabled"
                                    AutomationProperties.Name="Logic rule enabled" />
                      <Button Grid.Column="2" Classes="subtle" Content="Remove" Command="{Binding RemoveCommand}"
                              AutomationProperties.Name="Remove logic rule" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                      <TextBlock Text="Trigger" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding TriggerTypes}" SelectedItem="{Binding TriggerType}"
                                AutomationProperties.Name="Logic rule trigger">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="devices:AutomationChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                      <TextBlock Text="Device" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[ItemsControl].DataContext.LogicRules.DeviceChoices}"
                                SelectedItem="{Binding TriggerDevice}" PlaceholderText="Choose a device" AutomationProperties.Name="Logic rule trigger device">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="devices:AutomationChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                      <TextBlock Text="Command" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding TriggerCommand, FallbackValue=''}" AutomationProperties.Name="Logic rule trigger command" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                      <TextBlock Text="Condition" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding ConditionOperators}" SelectedItem="{Binding ConditionOperator}"
                                AutomationProperties.Name="Logic rule condition">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="devices:AutomationChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <CheckBox Grid.Column="2" IsChecked="{Binding ConditionDeviceState, FallbackValue=True}" Content="Device is on" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                      <TextBlock Text="Condition device" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[ItemsControl].DataContext.LogicRules.DeviceChoices}"
                                SelectedItem="{Binding ConditionDevice}" PlaceholderText="Choose a device" AutomationProperties.Name="Logic rule condition device">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="devices:AutomationChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                    <StackPanel Spacing="4">
                      <TextBlock Text="STEPS" Classes="section" />
                      <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="logic:LogicStepRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,2,0,0">
                              <ComboBox ItemsSource="{Binding StepTypes}" SelectedItem="{Binding StepType}" MinWidth="150"
                                        AutomationProperties.Name="Logic step type">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="devices:AutomationChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                              </ComboBox>
                              <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[ItemsControl].DataContext.DeviceChoices}"
                                        SelectedItem="{Binding TargetDevice}" PlaceholderText="Choose a switch" MinWidth="150"
                                        AutomationProperties.Name="Logic step target">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="devices:AutomationChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                              </ComboBox>
                              <ComboBox Grid.Column="2" ItemsSource="{Binding ToggleStates}" SelectedItem="{Binding ToggleState}" MinWidth="90"
                                        AutomationProperties.Name="Logic step toggle state">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="devices:AutomationChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                              </ComboBox>
                              <TextBox Grid.Column="3" Text="{Binding WaitSeconds, FallbackValue='10'}" Width="56" ToolTip.Tip="Wait seconds"
                                       AutomationProperties.Name="Logic step wait seconds" />
                              <TextBox Grid.Column="4" Text="{Binding TimerMinutes, FallbackValue='15'}" Width="56" ToolTip.Tip="Timer minutes"
                                       AutomationProperties.Name="Logic step timer minutes" />
                              <Button Grid.Column="5" Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove step"
                                      AutomationProperties.Name="Remove logic step"><icons:Icon Symbol="Dismiss24" FontSize="14" /></Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Classes="subtle" Content="Add step" Command="{Binding AddStepCommand}" HorizontalAlignment="Left"
                              AutomationProperties.Name="Add logic step" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="subtle" Content="Add rule" Command="{Binding LogicRules.AddRuleCommand, FallbackValue={x:Null}}"
                    AutomationProperties.Name="Add logic rule" />
            <Button Classes="primary" Content="Apply" Command="{Binding LogicRules.ApplyCommand, FallbackValue={x:Null}}"
                    AutomationProperties.Name="Apply logic rules" />
            <TextBlock Text="{Binding LogicRules.Status, FallbackValue=''}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                       Classes="muted" Classes.error="{Binding LogicRules.IsError, FallbackValue=False}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0" IsVisible="{Binding HasUpdate, FallbackValue=False}">
        <icons:Icon Symbol="ArrowSync24" FontSize="18" Foreground="{DynamicResource Accent}" />
        <StackPanel>
          <TextBlock Text="Updates" Classes="title" />
          <TextBlock Text="The running build and the newest published release" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <Border Classes="panel" Padding="16" IsVisible="{Binding HasUpdate, FallbackValue=False}">
        <StackPanel Spacing="12">
          <TextBlock Text="VERSION" Classes="section" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel>
              <TextBlock Text="Installed version" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Update.CurrentVersionText, FallbackValue=''}" Classes="muted" FontSize="12" />
            </StackPanel>
            <Button Grid.Column="1" Classes="subtle" Command="{Binding Update.CheckCommand, FallbackValue={x:Null}}"
                    IsEnabled="{Binding !Update.IsChecking, FallbackValue=True}" ToolTip.Tip="Check for a new release"
                    AutomationProperties.Name="Check for updates">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="ArrowSync24" FontSize="14" /><TextBlock Text="Check for updates" /></StackPanel>
            </Button>
          </Grid>
          <TextBlock Text="{Binding Update.Status, FallbackValue=''}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="subtle" Command="{Binding Update.OpenReleasesCommand, FallbackValue={x:Null}}"
                    ToolTip.Tip="Open the releases page" AutomationProperties.Name="Open the releases page">
              <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="Open24" FontSize="14" /><TextBlock Text="Open the releases page" /></StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
        <icons:Icon Symbol="Alert24" FontSize="18" Foreground="{DynamicResource Accent}" />
        <StackPanel>
          <TextBlock Text="Alerts" Classes="title" />
          <TextBlock Text="Notifications, sounds, and offline death" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="NOTIFICATION CENTER" Classes="section" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Show toast notifications" FontWeight="SemiBold" />
              <TextBlock Text="A short card in the corner for every new alarm, death or pairing." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ToastsEnabled}" OnContent="" OffContent="" AutomationProperties.Name="Show toast notifications" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
            <StackPanel>
              <TextBlock Text="Retention period" FontWeight="SemiBold" />
              <TextBlock Text="Older notifications are removed from the history." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding RetentionText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="1" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RetentionDays}"
                    AutomationProperties.Name="Notification retention in days" />
          </Grid>
          <StackPanel Spacing="6">
            <TextBlock Text="Muted servers" FontWeight="SemiBold" />
            <TextBlock Text="No servers muted" Classes="muted" FontSize="12" FontStyle="Italic" IsVisible="{Binding !HasMutedServers}" />
            <ItemsControl ItemsSource="{Binding MutedServers}" AutomationProperties.Name="Muted servers">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MutedServerRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Key}" Classes="muted" FontSize="11" IsVisible="{Binding HasName}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="subtle" CommandParameter="{Binding}" AutomationProperties.Name="Unmute server"
                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).UnmuteCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="AlertOn24" FontSize="14" /><TextBlock Text="Unmute" /></StackPanel>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="16" x:Name="WebhookPanel" IsVisible="{Binding HasWebhook}">
        <StackPanel Spacing="10">
          <TextBlock Text="DISCORD WEBHOOK (CHAT ALERTS)" Classes="section" />
          <TextBlock Text="Post this server's chat alerts to a Discord channel too. Paste the channel's webhook URL from Discord (Server Settings > Integrations > Webhooks)."
                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Webhook.SignInNote, FallbackValue=''}" Foreground="{DynamicResource ConnectionPending}" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding !Webhook.IsSignedIn, FallbackValue=False}" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding Webhook.UrlDraft, FallbackValue=''}" PlaceholderText="https://discord.com/api/webhooks/…" AutomationProperties.Name="Discord webhook URL" />
            <Button Grid.Column="1" Classes="primary" Content="Save" Command="{Binding Webhook.SaveUrlCommand, FallbackValue={x:Null}}" AutomationProperties.Name="Save Discord webhook" />
            <Button Grid.Column="2" Classes="subtle" Command="{Binding Webhook.ClearUrlCommand, FallbackValue={x:Null}}" ToolTip.Tip="Remove the webhook"
                    AutomationProperties.Name="Clear Discord webhook"><icons:Icon Symbol="Delete24" FontSize="15" /></Button>
          </Grid>
          <TextBlock Text="{Binding Webhook.Status, FallbackValue=''}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding Webhook.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
          <TextBlock Text="Optional pings" FontWeight="SemiBold" />
          <WrapPanel ItemSpacing="16" LineSpacing="6">
            <CheckBox Content="@everyone" IsChecked="{Binding Webhook.MentionEveryone, FallbackValue=False}" IsEnabled="{Binding Webhook.HasProfile, FallbackValue=False}" />
            <CheckBox Content="@here" IsChecked="{Binding Webhook.MentionHere, FallbackValue=False}" IsEnabled="{Binding Webhook.HasProfile, FallbackValue=False}" />
            <CheckBox Content="Text-to-speech (TTS)" IsChecked="{Binding Webhook.Tts, FallbackValue=False}" IsEnabled="{Binding Webhook.HasProfile, FallbackValue=False}" />
            <CheckBox Content="Discord only (not in-game)" IsChecked="{Binding Webhook.Exclusive, FallbackValue=False}" IsEnabled="{Binding Webhook.HasProfile, FallbackValue=False}"
                      ToolTip.Tip="Alerts go only to Discord and are not posted to the in-game team or clan chat." />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="16" x:Name="TemplatesPanel" IsVisible="{Binding HasTemplates}">
        <StackPanel Spacing="10">
          <TextBlock Text="CUSTOMIZE CHAT ALERT TEMPLATES" Classes="section" />
          <TextBlock Text="Here you can edit the templates for automated chat alerts. Variables (like {0}, {1}) will be automatically replaced."
                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding TemplateRows}" AutomationProperties.Name="Chat alert templates">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlertTemplateRow">
                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="4" RowSpacing="3" Margin="0,6">
                  <StackPanel Grid.ColumnSpan="3">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBox Grid.Row="1" Text="{Binding Text}" AutomationProperties.Name="{Binding Name}" />
                  <Button Grid.Row="1" Grid.Column="1" Classes="icon" Command="{Binding SaveCommand}" ToolTip.Tip="Save" AutomationProperties.Name="Save template">
                    <icons:Icon Symbol="Save24" FontSize="15" /></Button>
                  <Button Grid.Row="1" Grid.Column="2" Classes="icon" Command="{Binding ResetCommand}" ToolTip.Tip="Reset" AutomationProperties.Name="Reset template">
                    <icons:Icon Symbol="ArrowReset24" FontSize="15" /></Button>
                  <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Variables}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource ConnectionSuccess}" FontSize="11" />
                  </Grid>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="GENERIC SMART ALARMS" Classes="section" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Popup window" FontWeight="SemiBold" />
              <TextBlock Text="Alarms that do not name a paired device open the Incoming Alarms window." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GenericAlarmPopup}" OnContent="" OffContent="" AutomationProperties.Name="Popup window for generic alarms" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
