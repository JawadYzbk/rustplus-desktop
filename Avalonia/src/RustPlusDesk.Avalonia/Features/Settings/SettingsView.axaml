<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Settings"
             xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
             x:Class="RustPlusDesk.Avalonia.Features.Settings.SettingsView" x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.muted.error"><Setter Property="Foreground" Value="{DynamicResource ConnectionDanger}" /></Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Stretch">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:Icon Symbol="Settings24" FontSize="18" Foreground="{DynamicResource Accent}" />
        <StackPanel>
          <TextBlock Text="General" Classes="title" />
          <TextBlock Text="Startup and app behavior" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="STARTUP" Classes="section" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Auto-connect to last server on startup" FontWeight="SemiBold" />
              <TextBlock Text="Automatically reconnects to the last server and loads the map." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoConnect}" OnContent="" OffContent="" AutomationProperties.Name="Auto-connect to last server on startup" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{Binding AutoStartLabel}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding AutoStartNote}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AutoStartError}" Foreground="{DynamicResource ConnectionDanger}" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding AutoStartError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStart}" IsEnabled="{Binding CanAutoStart}" OnContent="" OffContent=""
                          AutomationProperties.Name="{Binding AutoStartLabel}" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="16" IsVisible="{Binding HasMap}">
        <StackPanel Spacing="12">
          <TextBlock Text="BEHAVIOR" Classes="section" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasActivity}">
            <StackPanel>
              <TextBlock Text="Hide system console" FontWeight="SemiBold" />
              <TextBlock Text="Hides the bottom Activity log to declutter; team chat stays." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Activity.IsHidden, FallbackValue=False}" OnContent="" OffContent=""
                          AutomationProperties.Name="Hide system console" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Streamer mode" FontWeight="SemiBold" />
              <TextBlock Text="Abbreviates Steam names and IDs to protect privacy during streams, hides server names, and hides the console and server list."
                         Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Map.AbbreviateNames, FallbackValue=False}" OnContent="" OffContent=""
                          AutomationProperties.Name="Streamer mode" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
            <StackPanel>
              <TextBlock Text="Player icon size" FontWeight="SemiBold" />
              <TextBlock Text="Size of team player markers on the map." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Map.PlayerIconScale, StringFormat='{}{0:0%}', FallbackValue=''}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0.5" Maximum="1.5" Value="{Binding Map.PlayerIconScale, FallbackValue=1}"
                    AutomationProperties.Name="Player icon size" />
          </Grid>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0" IsVisible="{Binding HasCustomMap}">
        <icons:Icon Symbol="Map24" FontSize="18" Foreground="{DynamicResource Accent}" />
        <StackPanel>
          <TextBlock Text="Map" Classes="title" />
          <TextBlock Text="Map image of the selected server" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <Border Classes="panel" Padding="16" IsVisible="{Binding HasCustomMap}">
        <StackPanel Spacing="8">
          <TextBlock Text="CUSTOM HD MAP IMAGE" Classes="section" />
          <TextBlock Text="Use a custom high-definition map image from a URL source instead of the map coming from the server. Cached locally and automatically wiped when a server wipe is detected."
                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="Custom Map Image URL" FontWeight="SemiBold" Margin="0,4,0,0" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding CustomMap.Url, FallbackValue=''}" PlaceholderText="https://example.com/rust_map_hd.png"
                     AutomationProperties.Name="Custom map image URL" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Classes="primary" Content="Apply" Command="{Binding CustomMap.ApplyCommand, FallbackValue={x:Null}}"
                    AutomationProperties.Name="Apply custom map URL" />
            <Button Grid.Column="2" Classes="subtle" Content="Clear" Command="{Binding CustomMap.ClearCommand, FallbackValue={x:Null}}"
                    AutomationProperties.Name="Clear custom map URL" />
          </Grid>
          <TextBlock Text="{Binding CustomMap.Status, FallbackValue=''}" FontSize="12" TextWrapping="Wrap"
                     Classes="muted" Classes.error="{Binding CustomMap.IsError, FallbackValue=False}" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
        <icons:Icon Symbol="Alert24" FontSize="18" Foreground="{DynamicResource Accent}" />
        <StackPanel>
          <TextBlock Text="Alerts" Classes="title" />
          <TextBlock Text="Notifications, sounds, and offline death" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="NOTIFICATION CENTER" Classes="section" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Show toast notifications" FontWeight="SemiBold" />
              <TextBlock Text="A short card in the corner for every new alarm, death or pairing." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ToastsEnabled}" OnContent="" OffContent="" AutomationProperties.Name="Show toast notifications" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
            <StackPanel>
              <TextBlock Text="Retention period" FontWeight="SemiBold" />
              <TextBlock Text="Older notifications are removed from the history." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding RetentionText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="1" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RetentionDays}"
                    AutomationProperties.Name="Notification retention in days" />
          </Grid>
          <StackPanel Spacing="6">
            <TextBlock Text="Muted servers" FontWeight="SemiBold" />
            <TextBlock Text="No servers muted" Classes="muted" FontSize="12" FontStyle="Italic" IsVisible="{Binding !HasMutedServers}" />
            <ItemsControl ItemsSource="{Binding MutedServers}" AutomationProperties.Name="Muted servers">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MutedServerRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Key}" Classes="muted" FontSize="11" IsVisible="{Binding HasName}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="subtle" CommandParameter="{Binding}" AutomationProperties.Name="Unmute server"
                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).UnmuteCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><icons:Icon Symbol="AlertOn24" FontSize="14" /><TextBlock Text="Unmute" /></StackPanel>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="16" x:Name="TemplatesPanel" IsVisible="{Binding HasTemplates}">
        <StackPanel Spacing="10">
          <TextBlock Text="CUSTOMIZE CHAT ALERT TEMPLATES" Classes="section" />
          <TextBlock Text="Here you can edit the templates for automated chat alerts. Variables (like {0}, {1}) will be automatically replaced."
                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding TemplateRows}" AutomationProperties.Name="Chat alert templates">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlertTemplateRow">
                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="4" RowSpacing="3" Margin="0,6">
                  <StackPanel Grid.ColumnSpan="3">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBox Grid.Row="1" Text="{Binding Text}" AutomationProperties.Name="{Binding Name}" />
                  <Button Grid.Row="1" Grid.Column="1" Classes="icon" Command="{Binding SaveCommand}" ToolTip.Tip="Save" AutomationProperties.Name="Save template">
                    <icons:Icon Symbol="Save24" FontSize="15" /></Button>
                  <Button Grid.Row="1" Grid.Column="2" Classes="icon" Command="{Binding ResetCommand}" ToolTip.Tip="Reset" AutomationProperties.Name="Reset template">
                    <icons:Icon Symbol="ArrowReset24" FontSize="15" /></Button>
                  <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Variables}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource ConnectionSuccess}" FontSize="11" />
                  </Grid>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="GENERIC SMART ALARMS" Classes="section" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Popup window" FontWeight="SemiBold" />
              <TextBlock Text="Alarms that do not name a paired device open the Incoming Alarms window." Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GenericAlarmPopup}" OnContent="" OffContent="" AutomationProperties.Name="Popup window for generic alarms" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
