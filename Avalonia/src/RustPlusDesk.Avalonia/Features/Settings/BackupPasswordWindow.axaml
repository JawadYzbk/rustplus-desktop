<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:RustPlusDesk.Avalonia.Features.Settings"
        x:Class="RustPlusDesk.Avalonia.Features.Settings.BackupPasswordWindow" x:DataType="settings:BackupPasswordViewModel"
        Title="{DynamicResource BackupPasswordTitle}" Width="440" Height="280" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource AppBackground}">
  <!--  Reference Views/Windows/BackupPasswordDialog: one field, because an empty password is how a backup is left unencrypted.  -->
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14" Margin="20">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
      <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Center">
      <TextBox x:Name="PasswordBox" Text="{Binding Password, Mode=TwoWay}" PasswordChar="•"
               AutomationProperties.Name="The backup's password" />
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource ConnectionDanger}"
                 FontSize="11" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <Button Grid.Column="1" Classes="primary" Content="{Binding ConfirmLabel}" Click="OnConfirm"
              AutomationProperties.Name="Use this password" />
      <Button Grid.Column="2" Classes="subtle" Content="{DynamicResource Cancel}" IsCancel="True" Click="OnCancel"
              AutomationProperties.Name="Close without a password" />
    </Grid>
  </Grid>
</Window>
