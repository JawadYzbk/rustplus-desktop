<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Teams"
             x:Class="RustPlusDesk.Avalonia.Features.Teams.TeamView" x:DataType="vm:TeamViewModel">
  <Grid Width="300" RowDefinitions="Auto,*" RowSpacing="4">
    <Button Content="{Binding Caption}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Show or hide server team" />
    <Border Grid.Row="1" Classes="card" Padding="10" IsVisible="{Binding IsExpanded}">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Classes="muted" />
        <ScrollViewer Grid.Row="1" MaxHeight="140" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Members}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TeamMemberRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Member.SteamId}" />
                  <TextBlock Grid.Column="1" Text="{Binding State}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
