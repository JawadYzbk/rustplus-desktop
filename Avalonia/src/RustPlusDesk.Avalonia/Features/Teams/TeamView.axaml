<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Teams"
             xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
             x:Class="RustPlusDesk.Avalonia.Features.Teams.TeamView" x:DataType="vm:TeamViewModel">
  <UserControl.Styles>
    <Style Selector="Ellipse.member"><Setter Property="Fill" Value="{DynamicResource TextSubtle}" /></Style>
    <Style Selector="Ellipse.member.online"><Setter Property="Fill" Value="{DynamicResource ConnectionSuccess}" /></Style>
    <Style Selector="Ellipse.member.dead"><Setter Property="Fill" Value="{DynamicResource ConnectionDanger}" /></Style>
  </UserControl.Styles>
  <Grid Width="300" RowDefinitions="*,Auto" RowSpacing="6">
    <Border Classes="panel" Padding="8" IsVisible="{Binding IsExpanded}" BoxShadow="0 6 18 0 #50000000">
      <Grid RowDefinitions="Auto,*" RowSpacing="6">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11" Classes="muted" Margin="4,0" />
        <ScrollViewer Grid.Row="1" MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Members}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TeamMemberRow">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="4,3">
                  <Panel Width="24" Height="24" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource SurfaceAlt}">
                      <Panel>
                        <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding !HasAvatar}" />
                        <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                      </Panel>
                    </Border>
                    <Ellipse Width="9" Height="9" Classes="member" Classes.online="{Binding IsOnline}" Classes.dead="{Binding IsDead}"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{DynamicResource Surface}" StrokeThickness="1.5" />
                  </Panel>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SteamId}" />
                  <TextBlock Grid.Column="2" Text="{Binding AfkText}" IsVisible="{Binding IsAfk}" Foreground="{DynamicResource ConnectionPending}"
                             FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip.Tip="Has not moved for at least 5 minutes" />
                  <TextBlock Grid.Column="3" Text="{Binding State}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
    <Button Grid.Row="1" Classes="subtle" Background="{DynamicResource SurfaceAlt}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left"
            Padding="10,5" AutomationProperties.Name="Show or hide server team">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <icons:Icon Symbol="People24" FontSize="16" />
        <TextBlock Text="{Binding Caption}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
