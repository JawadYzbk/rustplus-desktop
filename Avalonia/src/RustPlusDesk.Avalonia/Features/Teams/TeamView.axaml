<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Teams"
             xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
             x:Class="RustPlusDesk.Avalonia.Features.Teams.TeamView" x:DataType="vm:TeamViewModel">
  <UserControl.Styles>
    <Style Selector="Ellipse.member"><Setter Property="Fill" Value="{DynamicResource TextSubtle}" /></Style>
    <Style Selector="Ellipse.member.online"><Setter Property="Fill" Value="{DynamicResource ConnectionSuccess}" /></Style>
    <Style Selector="Ellipse.member.dead"><Setter Property="Fill" Value="{DynamicResource ConnectionDanger}" /></Style>
  </UserControl.Styles>
  <Grid Width="300" RowDefinitions="*,Auto" RowSpacing="6">
    <Border Classes="panel" Padding="8" IsVisible="{Binding IsExpanded}" BoxShadow="0 6 18 0 #50000000">
      <Grid RowDefinitions="Auto,*" RowSpacing="6">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11" Classes="muted" Margin="4,0" />
        <ScrollViewer Grid.Row="1" MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Members}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TeamMemberRow">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="4,3">
                  <Ellipse Width="8" Height="8" Classes="member" Classes.online="{Binding IsOnline}" Classes.dead="{Binding IsDead}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Member.SteamId}" />
                  <TextBlock Grid.Column="2" Text="{Binding State}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
    <Button Grid.Row="1" Classes="subtle" Background="{DynamicResource SurfaceAlt}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left"
            Padding="10,5" AutomationProperties.Name="Show or hide server team">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <icons:Icon Symbol="People24" FontSize="16" />
        <TextBlock Text="{Binding Caption}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
