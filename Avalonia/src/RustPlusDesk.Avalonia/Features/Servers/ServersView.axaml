<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Servers"
             xmlns:models="clr-namespace:RustPlusDesk.Core.Servers;assembly=RustPlusDesk.Core"
             xmlns:shared="using:RustPlusDesk.Avalonia.Shared.Controls"
             xmlns:connections="using:RustPlusDesk.Avalonia.Features.Connections"
             xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons"
             x:Class="RustPlusDesk.Avalonia.Features.Servers.ServersView"
             x:DataType="vm:ServersViewModel">
  <StackPanel Spacing="10">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="SERVERS" Classes="section" ToolTip.Tip="{Binding SourcePath}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
        <Button Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="Reload saved servers" AutomationProperties.Name="Refresh servers">
          <icons:Icon Symbol="ArrowClockwise24" /></Button>
        <Button Classes="icon" Command="{Binding OpenFileCommand}" ToolTip.Tip="Open a profiles.json file" AutomationProperties.Name="Open profiles file">
          <icons:Icon Symbol="FolderOpen24" /></Button>
        <Button Classes="icon" Command="{Binding EditCommand}" ToolTip.Tip="Edit the selected server" AutomationProperties.Name="Edit server">
          <icons:Icon Symbol="Edit24" /></Button>
        <Button Classes="icon" Command="{Binding DeleteServerCommand}" IsVisible="{Binding HasServerDelete}" ToolTip.Tip="Delete server…"
                AutomationProperties.Name="Delete server">
          <icons:Icon Symbol="Delete24" /></Button>
      </StackPanel>
    </Grid>
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" AutomationProperties.Name="Loading saved servers" />
    <shared:StatusPanel Classes="compact" Title="{Binding StatusTitle}" Message="{Binding StatusMessage}" IsVisible="{Binding ShowStatus}" />
    <ComboBox x:Name="SavedServerSelector" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer, Mode=TwoWay}" IsVisible="{Binding HasServers}"
              AutomationProperties.Name="Saved servers" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding SourcePath}">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="models:ServerSummary">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" ToolTip.Tip="{Binding Host}">
            <icons:Icon Symbol="Server24" FontSize="18" Foreground="{DynamicResource TextSubtle}" />
            <StackPanel Grid.Column="1" Spacing="1">
              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Port, StringFormat='Port {0}'}" FontSize="11" Classes="muted" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="CONNECTION" Classes="section" Margin="0,6,0,0" IsVisible="{Binding HasServers}" />
    <connections:ConnectionStatusView DataContext="{Binding Connection}" IsVisible="{Binding $parent[UserControl].((vm:ServersViewModel)DataContext).HasServers}" />
    <Border Classes="panel" Padding="10,6" IsVisible="{Binding HasListener}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <Ellipse Width="8" Height="8" Classes="connection-dot" Classes.connected="{Binding Listener.IsRunning, FallbackValue=False}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Pairing listener" FontSize="12" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Listener.Status, FallbackValue=''}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <Panel Grid.Column="2" VerticalAlignment="Center">
          <Button Classes="subtle" Content="Start" Command="{Binding Listener.StartCommand}" IsVisible="{Binding !Listener.IsRunning, FallbackValue=True}"
                  AutomationProperties.Name="Start listening for pairing" />
          <Button Classes="subtle" Content="Stop" Command="{Binding Listener.StopCommand}" IsVisible="{Binding Listener.IsRunning, FallbackValue=False}"
                  AutomationProperties.Name="Stop listening for pairing" />
        </Panel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
