<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Devices"
             xmlns:servers="using:RustPlusDesk.Avalonia.Features.Servers"
             xmlns:shared="using:RustPlusDesk.Avalonia.Shared.Controls"
             x:Class="RustPlusDesk.Avalonia.Features.Devices.DevicesView" x:DataType="vm:DevicesViewModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
    <StackPanel Spacing="8">
      <StackPanel Spacing="4">
        <TextBlock Text="Devices" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Message}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
      <WrapPanel>
        <Button Content="_Organize…" Margin="0,0,6,4" Command="{Binding $parent[Window].((servers:ServersViewModel)DataContext).OrganizeDevicesCommand}"
                IsVisible="{Binding $parent[Window].((servers:ServersViewModel)DataContext).HasDeviceEditor, FallbackValue=False}" />
        <Button Content="_Refresh devices" Command="{Binding RefreshCommand}" Margin="0,0,0,4" />
        <Button Content="_Import devices…" Margin="6,0,0,4"
                Command="{Binding $parent[Window].((servers:ServersViewModel)DataContext).ImportDevicesCommand}"
                ToolTip.Tip="Connect to this server to import shared team devices or local snapshots."
                IsVisible="{Binding $parent[Window].((servers:ServersViewModel)DataContext).HasDeviceImporter, FallbackValue=False}" />
        <Button Content="Recover _cloud devices…" Margin="6,0,0,4"
                ToolTip.Tip="Verify cloud and Steam sign-in, then allow sync in Account → Cloud."
                Command="{Binding $parent[Window].((servers:ServersViewModel)DataContext).RecoverCloudDevicesCommand}"
                IsVisible="{Binding $parent[Window].((servers:ServersViewModel)DataContext).HasCloudDeviceRestore, FallbackValue=False}" />
      </WrapPanel>
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="6">
      <Grid ColumnDefinitions="*,110" ColumnSpacing="8" IsVisible="{Binding HasDevices}">
        <TextBox Text="{Binding SearchText}" PlaceholderText="Search devices…" AutomationProperties.Name="Search devices" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding KindFilters}" SelectedItem="{Binding KindFilter}" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Device type filter" />
      </Grid>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRefreshing}" AutomationProperties.Name="Refreshing devices" />
    </StackPanel>
    <Grid Grid.Row="2">
      <TextBlock Text="No devices match this search." Classes="muted" IsVisible="{Binding HasNoMatches}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12" />
      <Border Classes="card" IsVisible="{Binding !HasDevices}" VerticalAlignment="Center">
        <TextBlock Text="No devices paired for this server." TextWrapping="Wrap" Classes="muted" />
      </Border>
      <TreeView ItemsSource="{Binding Devices}" IsVisible="{Binding HasDevices}" Background="Transparent"
                AutomationProperties.Name="Paired smart devices" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <TreeView.Styles>
          <Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="True" /></Style>
          <Style Selector="TreeViewItem" x:DataType="vm:DeviceRowViewModel"><Setter Property="IsVisible" Value="{Binding IsMatch}" /></Style>
        </TreeView.Styles>
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="vm:DeviceRowViewModel" x:DataType="vm:DeviceRowViewModel" ItemsSource="{Binding Children}">
            <Border Classes="card" Margin="0,0,0,8" Padding="12">
              <StackPanel Spacing="8">
                <StackPanel Spacing="8">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                      <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                              Command="{Binding $parent[Window].((servers:ServersViewModel)DataContext).OrganizeDevicesCommand}"
                              CommandParameter="{Binding Definition}" ToolTip.Tip="Customize device icon"
                              AutomationProperties.Name="{Binding Name, StringFormat='Customize icon for {0}'}">
                        <shared:ItemIcon Width="32" Height="32" ItemId="{Binding Definition.CustomIconId}" ShortName="{Binding Definition.CustomIconShortName}" DefaultShortName="{Binding DefaultIconShortName}" />
                      </Button>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding KindLabel}" Classes="muted" FontSize="12" />
                    <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding SupportsControl}">
                    <Button Content="ON" Command="{Binding TurnOnCommand}" AutomationProperties.Name="Turn device on" />
                    <Button Content="OFF" Command="{Binding TurnOffCommand}" AutomationProperties.Name="Turn device off" />
                  </StackPanel>
                </StackPanel>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" AutomationProperties.Name="Waiting for device confirmation" />
                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Classes="muted" />
                <StackPanel IsVisible="{Binding IsStorage}" Spacing="6">
                  <TextBlock Text="{Binding StorageCaption}" Classes="muted" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StorageItemViewModel">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,3">
                          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Text="Blueprint" IsVisible="{Binding IsBlueprint}" Classes="muted" />
                          <TextBlock Grid.Column="2" Text="{Binding Quantity}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>
          </TreeDataTemplate>
        </TreeView.DataTemplates>
      </TreeView>
    </Grid>
  </Grid>
</UserControl>
