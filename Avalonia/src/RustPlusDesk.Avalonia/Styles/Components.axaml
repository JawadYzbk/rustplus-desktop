<Styles xmlns="https://github.com/avaloniaui" xmlns:icons="using:RustPlusDesk.Avalonia.Shared.Icons" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- Dark branding follows the reference; Light follows the system preference. -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBg">#0F1013</SolidColorBrush>
          <SolidColorBrush x:Key="Surface">#181B1F</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceAlt">#1F2229</SolidColorBrush>
          <SolidColorBrush x:Key="MapBackground">#0B3948</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorder">#28FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Accent">#60CDFF</SolidColorBrush>
          <SolidColorBrush x:Key="AccentDark">#1A4D6B</SolidColorBrush>
          <SolidColorBrush x:Key="TextPrimary">#F0F3F7</SolidColorBrush>
          <SolidColorBrush x:Key="TextSubtle">#A2ABBA</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionSuccess">#66BB6A</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionDanger">#EF5350</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionPending">#FFCA28</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionRePair">#FF7043</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceHover">#1FFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AccentSoft">#2260CDFF</SolidColorBrush>
          <SolidColorBrush x:Key="OnAccent">#05202C</SolidColorBrush>
          <SolidColorBrush x:Key="RaidSulfur">#F2C14E</SolidColorBrush>
          <SolidColorBrush x:Key="RaidSulfurSoft">#26F2C14E</SolidColorBrush>
          <SolidColorBrush x:Key="RaidSulfurBorder">#55F2C14E</SolidColorBrush>
          <SolidColorBrush x:Key="RaidBest">#66BB6A</SolidColorBrush>
          <SolidColorBrush x:Key="RaidBestSoft">#2266BB6A</SolidColorBrush>
          <SolidColorBrush x:Key="RaidAccentSoft">#1860CDFF</SolidColorBrush>
          <SolidColorBrush x:Key="RaidWarning">#FFC857</SolidColorBrush>
          <SolidColorBrush x:Key="ChartBar">#EF6C33</SolidColorBrush>
          <SolidColorBrush x:Key="ChartBarEmpty">#559D9D9D</SolidColorBrush>
          <SolidColorBrush x:Key="Highlight">#FFCA28</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBg">#F3F3F3</SolidColorBrush>
          <SolidColorBrush x:Key="Surface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceAlt">#E9EDF2</SolidColorBrush>
          <SolidColorBrush x:Key="MapBackground">#DCEFF3</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorder">#26000000</SolidColorBrush>
          <SolidColorBrush x:Key="Accent">#006E99</SolidColorBrush>
          <SolidColorBrush x:Key="AccentDark">#CDEFFC</SolidColorBrush>
          <SolidColorBrush x:Key="TextPrimary">#1A1A1A</SolidColorBrush>
          <SolidColorBrush x:Key="TextSubtle">#526071</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionSuccess">#237A27</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionDanger">#BB2323</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionPending">#875C00</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionRePair">#B33A16</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceHover">#12000000</SolidColorBrush>
          <SolidColorBrush x:Key="AccentSoft">#1A006E99</SolidColorBrush>
          <SolidColorBrush x:Key="OnAccent">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="RaidSulfur">#8A5F00</SolidColorBrush>
          <SolidColorBrush x:Key="RaidSulfurSoft">#26E0A800</SolidColorBrush>
          <SolidColorBrush x:Key="RaidSulfurBorder">#66B58400</SolidColorBrush>
          <SolidColorBrush x:Key="RaidBest">#237A27</SolidColorBrush>
          <SolidColorBrush x:Key="RaidBestSoft">#22237A27</SolidColorBrush>
          <SolidColorBrush x:Key="RaidAccentSoft">#18006E99</SolidColorBrush>
          <SolidColorBrush x:Key="RaidWarning">#8A5F00</SolidColorBrush>
          <SolidColorBrush x:Key="ChartBar">#D9531E</SolidColorBrush>
          <SolidColorBrush x:Key="ChartBarEmpty">#40707070</SolidColorBrush>
          <SolidColorBrush x:Key="Highlight">#8A5F00</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.brand">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <!-- Design system: primary / subtle / icon buttons, chips, section captions, panels. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <!-- Destructive confirmation (clear, delete). -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource ConnectionDanger}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ConnectionDanger}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.subtle, Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter, Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon icons|Icon, Button.subtle icons|Icon">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
  </Style>
  <Style Selector="Button.icon:pointerover icons|Icon, Button.subtle:pointerover icons|Icon">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button:disabled, ToggleButton:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="ToggleButton.chip, RadioButton.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="RadioButton.chip">
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>
  <Style Selector="RadioButton.chip:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="ToggleButton.chip icons|Icon">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked icons|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <!-- Page header strip shared by the map toolbar and tool pages. -->
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,10" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.nav icons|Icon">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
  </Style>
  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="{DynamicResource AccentDark}" />
  </Style>
  <Style Selector="Button.nav.selected icons|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="TextBlock.navLabel">
    <Setter Property="Margin" Value="6,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.navSection">
    <Setter Property="Margin" Value="10,10,0,4" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
  </Style>
  <Style Selector="Button.rail">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.rail.selected">
    <Setter Property="Background" Value="{DynamicResource AccentDark}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Ellipse.connection-dot"><Setter Property="Fill" Value="{DynamicResource ConnectionDanger}" /></Style>
  <Style Selector="Ellipse.connection-dot.connected"><Setter Property="Fill" Value="{DynamicResource ConnectionSuccess}" /></Style>
  <Style Selector="Ellipse.connection-dot.pending"><Setter Property="Fill" Value="{DynamicResource ConnectionPending}" /></Style>
  <Style Selector="Ellipse.connection-dot.repair"><Setter Property="Fill" Value="{DynamicResource ConnectionRePair}" /></Style>
</Styles>
