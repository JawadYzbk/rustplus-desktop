<UserControl
    x:Class="RustPlusDesk.Controls.MaterialTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RustPlusDesk.Controls">
    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  App icon  -->
        <Image
            x:Name="IconImage"
            Grid.Column="0"
            Width="18"
            Height="18"
            Margin="14,0,8,0"
            VerticalAlignment="Center"
            RenderOptions.BitmapScalingMode="HighQuality"
            Visibility="{Binding IconVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <!--  Title  -->
        <TextBlock
            x:Name="TitleText"
            Grid.Column="1"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            FontSize="13"
            FontWeight="Medium"
            Foreground="#DEFFFFFF" />

        <!--  Optional header content (buttons etc.), right-aligned before caption buttons  -->
        <ContentPresenter
            x:Name="HeaderPresenter"
            Grid.Column="3"
            VerticalAlignment="Stretch"
            Content="{Binding Header, RelativeSource={RelativeSource AncestorType=UserControl}}"
            WindowChrome.IsHitTestVisibleInChrome="True" />

        <!--  Caption buttons  -->
        <controls:MaterialCaptionButtons Grid.Column="4" VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
