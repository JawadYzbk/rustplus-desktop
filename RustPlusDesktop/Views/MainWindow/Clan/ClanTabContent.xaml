<UserControl
    x:Class="RustPlusDesk.Views.ClanTabContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:conv="clr-namespace:RustPlusDesk.Converters"
    xmlns:tutorials="clr-namespace:RustPlusDesk.Features.Tutorials">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                            <Grid>
                                <Grid Background="#181A1E">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /> <!-- Header (Clan name, announcement) -->
                                        <RowDefinition Height="*" />    <!-- List of members -->
                                        <RowDefinition Height="Auto" /> <!-- Footer (Last pull, Refresh button, view switcher) -->
                                    </Grid.RowDefinitions>

                                    <Grid.Resources>
                                        <conv:BoolToVisibilityConverter x:Key="Vis" />
                                        <conv:BoolToVisibilityConverter x:Key="VisInv" Invert="True" />
                                        <Style x:Key="ClanCard" TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10" />
                                            <Setter Property="Background" Value="#FF141F2D" />
                                            <Setter Property="Padding" Value="8" />
                                            <Setter Property="Margin" Value="6" />
                                        </Style>
                                    </Grid.Resources>

                                    <!-- Header Hover Details -->
                                    <Grid Grid.Row="0" Margin="10,10,10,5">
                                        <Border x:Name="ClanHeaderBorder" 
                                                Background="#FF1A2737" 
                                                CornerRadius="8" 
                                                Padding="10,8" 
                                                Cursor="Hand"
                                                Tag="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTipService.InitialShowDelay="0"
                                                ToolTipService.ShowDuration="60000">
                                            <Border.ToolTip>
                                                <ToolTip Background="#FF141F2D" BorderBrush="#FF2A3F5D" BorderThickness="1" Padding="15"
                                                         DataContext="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <StackPanel Width="250">
                                                        <TextBlock Text="{Binding ClanName}" 
                                                                   FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" />
                                                        
                                                        <!-- MOTD Card -->
                                                        <Border Background="#FF1E2D42" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding ClanMotd}" 
                                                                           Foreground="White" FontSize="12" TextWrapping="Wrap" FontStyle="Italic" />
                                                                <TextBlock Text="{Binding ClanMotdAuthorText}" 
                                                                           Foreground="#FF8E9AA7" FontSize="10" Margin="0,6,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                        
                                                        <!-- Details Grid -->
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <!-- Score -->
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Score" Foreground="#FF8E9AA7" FontSize="11" Margin="0,2,10,2" />
                                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ClanScoreText}" 
                                                                       Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,2" />
                                                            
                                                            <!-- Members -->
                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Members" Foreground="#FF8E9AA7" FontSize="11" Margin="0,2,10,2" />
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ClanMembersRatio}" 
                                                                       Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,2" />
                                                            
                                                            <!-- Created -->
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Created" Foreground="#FF8E9AA7" FontSize="11" Margin="0,2,10,2" />
                                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClanCreatedText}" 
                                                                       Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,2" />
                                                            
                                                            <!-- Founder -->
                                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Founder" Foreground="#FF8E9AA7" FontSize="11" Margin="0,2,10,2" />
                                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ClanCreatorText}" 
                                                                       Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,2" />
                                                        </Grid>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="0"  Kind="Shield" Foreground="{DynamicResource SystemAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="18"  />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ClanName, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue='Clan Loading...'}" 
                                                               Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ClanMotd, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue='No Announcement'}" 
                                                               Foreground="#FF8E9AA7" FontSize="11" FontStyle="Italic" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <materialDesign:PackIcon Grid.Column="2"  Kind="Information" Foreground="#FF8E9AA7" VerticalAlignment="Center" Margin="5,0,0,0"  />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!--  ListBox of Clan Members  -->
                                    <ListBox
                                        x:Name="ClanList"
                                        Grid.Row="1"
                                        HorizontalContentAlignment="Stretch"
                                        ItemsSource="{Binding ClanMembers, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <!--  Context Menu  -->
                                        <ListBox.Resources>
                                            <ContextMenu x:Key="ClanContextMenu" Style="{StaticResource DarkContextMenu}">
                                                <MenuItem Click="Clan_OpenProfile_Click" Header="{DynamicResource OpenSteamProfile}" />
                                                <MenuItem Click="Clan_CopySteamId_Click" Header="Copy Steam ID" />
                                            </ContextMenu>
                                        </ListBox.Resources>

                                        <ListBox.Style>
                                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                                <!-- Default to Grid/Tile View (2 columns) -->
                                                <Setter Property="ItemsPanel">
                                                    <Setter.Value>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" VerticalAlignment="Top" />
                                                        </ItemsPanelTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="ItemContainerStyle">
                                                    <Setter.Value>
                                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                            <Setter Property="Margin" Value="4" />
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="ContextMenu" Value="{StaticResource ClanContextMenu}" />
                                                        </Style>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="ItemTemplate">
                                                    <Setter.Value>
                                                        <!-- Grid/Tile View Item Template -->
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource ClanCard}" Padding="6">
                                                                <!-- ToolTip for full info on hover -->
                                                                <Border.ToolTip>
                                                                    <ToolTip Background="#FF141F2D" BorderBrush="#FF2A3F5D" BorderThickness="1" Padding="12">
                                                                        <StackPanel Width="220">
                                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="White" />
                                                                            <TextBlock Text="{Binding RoleName, StringFormat='Role: {0}'}" Foreground="#FF8E9AA7" FontSize="11" Margin="0,4,0,0" />
                                                                            <TextBlock Text="{Binding SteamId, StringFormat='Steam ID: {0}'}" Foreground="#FF8E9AA7" FontSize="10" Margin="0,2,0,0" />
                                                                            <TextBlock Text="{Binding Notes, StringFormat='Note: {0}'}" Foreground="#FF8E9AA7" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" FontStyle="Italic" Visibility="{Binding HasNotes, Converter={StaticResource Vis}}" />
                                                                            <TextBlock Text="{Binding LastSeenText, StringFormat='Last Seen: {0}'}" Foreground="#FF8E9AA7" FontSize="11" Margin="0,4,0,0" />
                                                                        </StackPanel>
                                                                    </ToolTip>
                                                                </Border.ToolTip>
                                                                
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="38" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Avatar + Status -->
                                                                    <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Top">
                                                                        <Border CornerRadius="4" ClipToBounds="True">
                                                                            <Image ClipToBounds="True" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Avatar}" Stretch="UniformToFill" />
                                                                        </Border>
                                                                        
                                                                        <!-- Online dot -->
                                                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Fill="#4CAF50" Stroke="Black" Visibility="{Binding IsOnline, Converter={StaticResource Vis}}" />
                                                                        <!-- Offline dot -->
                                                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Fill="#666" Stroke="Black" Visibility="{Binding IsOnline, Converter={StaticResource VisInv}}" />
                                                                    </Grid>

                                                                    <!-- Details (Compacted) -->
                                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                        <!-- Name & Team Icon -->
                                                                        <StackPanel Orientation="Horizontal" MaxWidth="120">
                                                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                            <materialDesign:PackIcon  Kind="AccountMultiple" FontSize="10" Foreground="{DynamicResource SystemAccentBrush}" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="In your team" Visibility="{Binding IsInTeam, Converter={StaticResource Vis}}"  />
                                                                        </StackPanel>
                                                                        
                                                                        <!-- Role (Trimmed) -->
                                                                        <TextBlock Text="{Binding RoleName}" Foreground="#FF9BA4B5" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" MaxWidth="120" />
                                                                        
                                                                        <!-- Notes (Trimmed) -->
                                                                        <TextBlock Text="{Binding Notes}" Foreground="#6C7A89" FontSize="8" FontStyle="Italic" TextTrimming="CharacterEllipsis" Visibility="{Binding HasNotes, Converter={StaticResource Vis}}" Margin="0,1,0,0" MaxWidth="120" />
                                                                        
                                                                        <!-- Last Seen -->
                                                                        <TextBlock Text="{Binding LastSeenText, StringFormat='seen: {0}'}" Foreground="#FF6C7A89" FontSize="8" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                
                                                <Style.Triggers>
                                                    <!-- Switch to Compact List View -->
                                                    <DataTrigger Binding="{Binding IsClanListView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="ItemsPanel">
                                                            <Setter.Value>
                                                                <ItemsPanelTemplate>
                                                                    <VirtualizingStackPanel />
                                                                </ItemsPanelTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="ItemContainerStyle">
                                                            <Setter.Value>
                                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                                    <Setter Property="Margin" Value="2,1" />
                                                                    <Setter Property="Padding" Value="0" />
                                                                    <Setter Property="ContextMenu" Value="{StaticResource ClanContextMenu}" />
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                </Style>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="ItemTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource ClanCard}" Background="#FF111924" Margin="2" Padding="8,6">
                                                                        <StackPanel>
                                                                            <!-- Header Row -->
                                                                            <Grid Background="Transparent">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" /> <!-- Status dot -->
                                                                                    <ColumnDefinition Width="Auto" /> <!-- Rank Icon -->
                                                                                    <ColumnDefinition Width="*" />    <!-- Name -->
                                                                                    <ColumnDefinition Width="Auto" /> <!-- Role/Rank -->
                                                                                </Grid.ColumnDefinitions>
                                                                                
                                                                                <!-- Status Dot -->
                                                                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" Fill="#4CAF50" Visibility="{Binding IsOnline, Converter={StaticResource Vis}}" />
                                                                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" Fill="#666" Visibility="{Binding IsOnline, Converter={StaticResource VisInv}}" />
                                                                                
                                                                                <!-- Rank Icon (shield) -->
                                                                                <materialDesign:PackIcon Grid.Column="1"  Kind="Shield" FontSize="11" Foreground="#FF9BA4B5" VerticalAlignment="Center" Margin="0,0,6,0"  />
                                                                                
                                                                                <!-- Name & Team Icon -->
                                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                                                    <materialDesign:PackIcon  Kind="AccountMultiple" FontSize="10" Foreground="{DynamicResource SystemAccentBrush}" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="In your team" Visibility="{Binding IsInTeam, Converter={StaticResource Vis}}"  />
                                                                                </StackPanel>
                                                                                
                                                                                <!-- Role -->
                                                                                <TextBlock Grid.Column="3" Text="{Binding RoleName}" Foreground="#FF6C7A89" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                                            </Grid>
                                                                            
                                                                            <!-- Expanded Detail Section (visible on Selection) -->
                                                                            <Border Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource Vis}}"
                                                                                    BorderBrush="#FF1D2B3D" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                                                                                <StackPanel>
                                                                                    <!-- Steam ID -->
                                                                                    <Grid Margin="0,2,0,2">
                                                                                        <TextBlock Text="Steam ID:" Foreground="#FF6C7A89" FontSize="9" />
                                                                                        <TextBlock Text="{Binding SteamId}" Foreground="#FF9BA4B5" FontSize="9" HorizontalAlignment="Right" />
                                                                                    </Grid>
                                                                                    <!-- Last Seen -->
                                                                                    <Grid Margin="0,2,0,2" Visibility="{Binding IsOnline, Converter={StaticResource VisInv}}">
                                                                                        <TextBlock Text="Last Seen:" Foreground="#FF6C7A89" FontSize="9" />
                                                                                        <TextBlock Text="{Binding LastSeenText}" Foreground="#FF9BA4B5" FontSize="9" HorizontalAlignment="Right" />
                                                                                    </Grid>
                                                                                    <!-- Notes -->
                                                                                    <Grid Margin="0,2,0,2" Visibility="{Binding HasNotes, Converter={StaticResource Vis}}">
                                                                                        <TextBlock Text="Note:" Foreground="#FF6C7A89" FontSize="9" VerticalAlignment="Top" />
                                                                                        <TextBlock Text="{Binding Notes}" Foreground="#FF9BA4B5" FontSize="9" HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="180" FontStyle="Italic" />
                                                                                    </Grid>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.Style>
                                    </ListBox>

                                    <!-- Footer (Refresh & Mode Toggle) -->
                                    <Grid Grid.Row="2" Margin="10,5,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Last pull timestamp -->
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" Foreground="#FF6C7A89">
                                            <Run Text="Last pull: " />
                                            <Run Text="{Binding LastClanPullTime, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue='-'}" />
                                        </TextBlock>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <!-- Toggle view button -->
                                            <Button Click="BtnToggleClanView_Click" 
                                                       Width="28" Height="28" Padding="0" Margin="0,0,6,0"
                                                       ToolTip="Toggle List/Tile View">
                                                <Button.Content>
                                                    <Grid>
                                                        <!-- Grid icon -->
                                                        <materialDesign:PackIcon  Kind="ViewGrid" FontSize="14" Visibility="{Binding IsClanListView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"  />
                                                        <!-- List icon -->
                                                        <materialDesign:PackIcon  Kind="FormatListBulleted" FontSize="14" Visibility="{Binding IsClanListView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisInv}}"  />
                                                    </Grid>
                                                </Button.Content>
                                            </Button>
                                            
                                            <!-- Refresh button -->
                                            <Button Click="BtnRefreshClan_Click" 
                                                       Width="28" Height="28" Padding="0" Margin="0,0,6,0"
                                                       ToolTip="Refresh Clan Info">
                                                <materialDesign:PackIcon  Kind="Undo" FontSize="14"  />
                                            </Button>
                                            
                                            <!-- Chat button -->
                                            <Button Click="BtnOpenClanChat_Click" 
                                                       Width="28" Height="28" Padding="0"
                                                       ToolTip="Open Clan Chat">
                                                <materialDesign:PackIcon  Kind="Chat" FontSize="14"  />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
</UserControl>
