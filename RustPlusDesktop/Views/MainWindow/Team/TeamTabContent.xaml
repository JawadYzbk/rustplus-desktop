<UserControl
    x:Class="RustPlusDesk.Views.TeamTabContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:conv="clr-namespace:RustPlusDesk.Converters"
    xmlns:tutorials="clr-namespace:RustPlusDesk.Features.Tutorials">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                            <Grid>
                                <Grid Background="#181A1E">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                         <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.Resources>
                                        <conv:BoolToVisibilityConverter x:Key="Vis" />
                                        <conv:BoolToVisibilityConverter x:Key="VisInv" Invert="True" />
                                        <Style x:Key="Card" TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10" />
                                            <Setter Property="Background" Value="#FF141F2D" />
                                            <Setter Property="Padding" Value="6" />
                                            <Setter Property="Margin" Value="4" />
                                        </Style>
                                    </Grid.Resources>

                                    <!--  Liste oben  -->
                                    <ListBox
                                        x:FieldModifier="public" x:Name="TeamList"
                                        tutorials:Tutorial.TargetId="Team.List"
                                        Grid.Row="0"
                                        HorizontalContentAlignment="Stretch"
                                        ItemsSource="{Binding TeamMembers, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" VerticalAlignment="Top" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <!--  KontextmenÃ¼  -->
                                        <ListBox.Resources>
                                            <ContextMenu x:Key="TeamContextMenu" Style="{StaticResource DarkContextMenu}">
                                                <MenuItem Click="Team_Center_Click" Header="{DynamicResource CenterOnMap}" />
                                                <MenuItem Click="Team_Follow_Click" Header="{DynamicResource FollowOnMap}" />
                                                <MenuItem Click="Team_OpenProfile_Click" Header="{DynamicResource OpenSteamProfile}" />
                                                <Separator />
                                                <MenuItem Click="Team_Promote_Click" Header="{DynamicResource PromoteToLeader}" />
                                            </ContextMenu>
                                        </ListBox.Resources>

                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Margin" Value="4" />
                                                <Setter Property="Padding" Value="0" />
                                                <EventSetter Event="MouseLeftButtonUp" Handler="TeamItem_MouseLeftButtonUp" />
                                                <Setter Property="ContextMenu" Value="{StaticResource TeamContextMenu}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>
                                                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="32" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0" 
                                                                  Style="{StaticResource DotCheckBox}"
                                                                  IsChecked="{Binding ShowMarkers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                  PreviewMouseLeftButtonDown="TeamCheckBox_PreviewMouseLeftButtonDown" 
                                                                  VerticalAlignment="Center" Margin="0" Cursor="Hand" 
                                                                  ToolTip="{DynamicResource UiShowMarkersOnMap}" />

                                                        <!--  Avatar + Status  -->
                                                        <Grid Grid.Column="1" Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <Border CornerRadius="4" ClipToBounds="True">
                                                                <Image
                                                                    ClipToBounds="True"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Source="{Binding Avatar}"
                                                                    Stretch="UniformToFill" />
                                                            </Border>

                                                            <!--  Online (grÃ¼n)  -->
                                                            <Ellipse
                                                                Width="10"
                                                                Height="10"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Margin="0,0,-2,-2"
                                                                Fill="#4CAF50"
                                                                Stroke="Black"
                                                                Visibility="{Binding IsOnline, Converter={StaticResource Vis}}" />

                                                            <!--  Offline (grau)  -->
                                                            <Ellipse
                                                                Width="10"
                                                                Height="10"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Margin="0,0,-2,-2"
                                                                Fill="#666"
                                                                Stroke="Black"
                                                                Visibility="{Binding IsOnline, Converter={StaticResource VisInv}}" />

                                                            <!--  Leader-Stern  -->
                                                            <Path
                                                                Width="14"
                                                                Height="14"
                                                                Stretch="Uniform"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Margin="-3,-3,0,0"
                                                                Data="M 10,1 12,7 19,7 13,11 15,18 10,14 5,18 7,11 1,7 8,7 z"
                                                                Fill="Gold"
                                                                Stroke="Black"
                                                                Visibility="{Binding IsLeader, Converter={StaticResource Vis}}" />
                                                            <TextBlock
                                                                Text="&#x1F4A4;"
                                                                FontSize="12"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Margin="0,-5,-5,0"
                                                                RenderTransformOrigin="0.5,0.5"
                                                                Visibility="{Binding IsAfk, Converter={StaticResource Vis}}">
                                                                <TextBlock.RenderTransform>
                                                                    <RotateTransform Angle="15" />
                                                                </TextBlock.RenderTransform>
                                                            </TextBlock>
                                                        </Grid>

                                                        <!--  Textseite  -->
                                                        <StackPanel Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center">
                                                            <!--  Name: Standard weiÃŸ, offline leicht ausgrauen, tot = rot  -->
                                                            <TextBlock FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Text>
                                                                    <Binding Path="DisplayName" />
                                                                </TextBlock.Text>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="White" />
                                                                        <Setter Property="Opacity" Value="1" />
                                                                        <Style.Triggers>
                                                                            <!--  tot -> rot  -->
                                                                            <DataTrigger Binding="{Binding IsDead}" Value="True">
                                                                                <Setter Property="Foreground" Value="#EF5350" />
                                                                            </DataTrigger>
                                                                            <!--  offline -> etwas ausgegraut  -->
                                                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                                <Setter Property="Opacity" Value="0.55" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock
                                                                FontSize="9"
                                                                Foreground="White"
                                                                Opacity="0.65"
                                                                Text="{Binding DisplaySteamId}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="8"
                                                                Foreground="#FF8C00"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding AfkText}"
                                                                Visibility="{Binding IsAfk, Converter={StaticResource Vis}}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- RESPONSIVE SETTINGS GRID -->
                                    <Grid Grid.Row="1" Margin="8,4,8,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- ROW 0: Marker Toggles -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="{DynamicResource Markers}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AAA" FontSize="11" />
                                            
                                            <!-- Profile Markers -->
                                            <CheckBox x:FieldModifier="public" x:Name="ChkProfileMarkers" tutorials:Tutorial.TargetId="Team.Markers" IsChecked="True" Checked="ChkProfileMarkers_Toggled" Unchecked="ChkProfileMarkers_Toggled" Margin="0,0,12,0" Style="{StaticResource DotCheckBox}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="18" Height="18" Margin="0,0,6,0" Stretch="Uniform">
                                                        <Grid Width="40" Height="40">
                                                            <!-- Real profile marker preview (lime dot with avatar) -->
                                                            <Ellipse Width="38" Height="38" Stroke="Black" StrokeThickness="2" Visibility="{Binding IsChecked, ElementName=ChkProfileMarkers, Converter={StaticResource BoolToVisibility}}">
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{Binding MyAvatar}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                            <!-- Fallback if unchecked -->
                                                            <Ellipse Width="18" Height="18" Fill="LimeGreen" Stroke="Black" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsChecked, ElementName=ChkProfileMarkers, Converter={StaticResource BoolToVisibilityInv}}" />
                                                        </Grid>
                                                    </Viewbox>
                                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Profile}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- Player direction arrow -->
                                            <CheckBox x:FieldModifier="public" x:Name="ChkPlayerArrows" IsChecked="True" Checked="ChkPlayerArrows_Toggled" Unchecked="ChkPlayerArrows_Toggled" Margin="0,0,12,0" Style="{StaticResource DotCheckBox}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="18" Height="18" Margin="0,0,6,0" Stretch="Uniform">
                                                        <Grid Width="40" Height="40">
                                                            <!-- Arrow preview -->
                                                            <Path Data="M 20,4 L 32,32 L 8,32 Z" Fill="LimeGreen" Stroke="Black" StrokeThickness="2" Visibility="{Binding IsChecked, ElementName=ChkPlayerArrows, Converter={StaticResource BoolToVisibility}}" />
                                                            <!-- Fallback if unchecked -->
                                                            <Path Data="M 20,4 L 32,32 L 8,32 Z" Fill="#444" Stroke="#666" StrokeThickness="2" Visibility="{Binding IsChecked, ElementName=ChkPlayerArrows, Converter={StaticResource BoolToVisibilityInv}}" />
                                                        </Grid>
                                                    </Viewbox>
                                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource PlayerDirectionArrow}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </CheckBox>


                                            <!-- Death Markers -->
                                            <Grid x:Name="DeathMarkerToggleContainer" Background="Transparent">
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox x:FieldModifier="public" x:Name="ChkDeathMarkers" IsChecked="False" Checked="ChkDeathMarkers_Toggled" Unchecked="ChkDeathMarkers_Toggled" Style="{StaticResource DotCheckBox}" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Viewbox Width="18" Height="22" Margin="0,0,6,0" Stretch="Uniform">
                                                                <Grid Width="40" Height="56">
                                                                    <!-- Path matching BuildDeathPin -->
                                                                    <Path Data="M20,0 C31,0 40,9 40,20 C40,33 20,56 20,56 C20,56 0,33 0,20 C0,9 9,0 20,0 Z" Fill="IndianRed" Stroke="Black" StrokeThickness="2" Stretch="Fill" Visibility="{Binding IsChecked, ElementName=ChkDeathMarkers, Converter={StaticResource BoolToVisibility}}" />
                                                                    
                                                                    <!-- Avatar Circle inside the pin -->
                                                                    <Ellipse Width="26" Height="26" Stroke="Black" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,5,0,0" Visibility="{Binding IsChecked, ElementName=ChkDeathMarkers, Converter={StaticResource BoolToVisibility}}">
                                                                        <Ellipse.Fill>
                                                                            <ImageBrush ImageSource="{Binding MyAvatar}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        </Ellipse.Fill>
                                                                    </Ellipse>

                                                                    <!-- Checkbox unchecked state (gray dot) -->
                                                                    <Ellipse Width="16" Height="16" Fill="#444" Stroke="#666" StrokeThickness="2" Visibility="{Binding IsChecked, ElementName=ChkDeathMarkers, Converter={StaticResource BoolToVisibilityInv}}" />
                                                                </Grid>
                                                            </Viewbox>
                                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Death}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                    
                                                    <Button x:Name="BtnDeathMarkerSettings"
                                                               Padding="2"
                                                               Margin="2,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Click="BtnDeathMarkerSettings_Click">
                                                        <materialDesign:PackIcon  Kind="Cog" FontSize="12" Foreground="#AAA"  />
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Opacity" Value="0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=DeathMarkerToggleContainer}" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- ROW 1: Streamer Mode + Icon Scale -->
                                        <Grid Grid.Row="1" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Abbreviate Names Toggle -->
                                            <ToggleButton Grid.Column="0" x:FieldModifier="public" x:Name="BtnAbbreviateNames" Margin="0,0,10,0" Width="24" Height="24" ToolTip="{DynamicResource StreamerMode}" Checked="BtnAbbreviateNames_Toggled" Unchecked="BtnAbbreviateNames_Toggled">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="BorderBrush" Value="#444"/>
                                                        <Setter Property="Foreground" Value="#CCC"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#222"/></Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Background" Value="#1C4B82"/>
                                                                <Setter Property="BorderBrush" Value="#2A6CA6"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                                <TextBlock Text="{DynamicResource UiA}" FontSize="10" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                            </ToggleButton>

                                            <!-- Dynamic Slider -->
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{DynamicResource ScaleLabel}" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#AAA" FontSize="10" />
                                                <Slider Grid.Column="1" x:FieldModifier="public" x:Name="SliderPlayerIconSize" Minimum="0.5" Maximum="1.5" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="SliderPlayerIconSize_ValueChanged" VerticalAlignment="Center" MinWidth="30" />
                                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SliderPlayerIconSize, StringFormat={}{0:P0}}" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#AAA" FontSize="10" Width="30" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
</UserControl>
