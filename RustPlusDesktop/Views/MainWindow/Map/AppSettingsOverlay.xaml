                <Button HorizontalAlignment="Stretch" Margin="0,0,0,10" Click="BtnCompareCloud_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Information" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource CompareCloudFeatures}" /></StackPanel></Button>

