<UserControl x:Class="RustPlusDesk.Views.AppSettingsOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:conv="clr-namespace:RustPlusDesk.Converters" xmlns:p="clr-namespace:RustPlusDesk.Properties" xmlns:views="clr-namespace:RustPlusDesk.Views" xmlns:windows="clr-namespace:RustPlusDesk.Views.Windows" xmlns:tutorials="clr-namespace:RustPlusDesk.Features.Tutorials" mc:Ignorable="d" Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}" tutorials:Tutorial.TargetId="Settings.Panel">

    <Grid ClipToBounds="True">
        <Grid.Resources>
            <conv:NotNullToBoolConverter x:Key="LocalNotNull" />
            <Style x:Key="SettingsMenuItem" TargetType="ListViewItem">
                <Setter Property="Margin" Value="12,0,12,8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="SettingsNativeCard" TargetType="materialDesign:Card">
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon  Kind="Cog" Margin="0,0,8,0" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" FontSize="14"  />
                    <TextBlock Text="{DynamicResource Settings}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>
                <Button x:Name="BtnCloseSettings" Content="✕" Width="26" Height="26" Padding="0" FontSize="12" Foreground="{DynamicResource TextSubtle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnCloseSettings_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="12,10,12,8" Background="{DynamicResource SurfaceAlt}">
            <TextBox x:Name="SettingsSearchBox" Height="34" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource UiSearchSettings}" TextChanged="SettingsSearchBox_TextChanged" materialDesign:HintAssist.Hint="{DynamicResource UiSearchSettings}" />
        </Border>

        <Grid Grid.Row="2">
            <Grid x:Name="SettingsCategoryPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="16,14,16,12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource UiChooseACategory}" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiSettingsAreGroupedByWhatTheyControl}" />
                </StackPanel>
                <ListView x:Name="SettingsCategoryList" Grid.Row="1" Padding="0,2,0,8" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SettingsMenuItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SettingsCategoryList_SelectionChanged">
                    <ListViewItem Tag="general">
                        <materialDesign:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon  Kind="Cog" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"  />
                                <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{DynamicResource General}" /><TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiLanguageStartupAndAppBehavior}" TextWrapping="Wrap" /></StackPanel>
                                <materialDesign:PackIcon Grid.Column="2"  Kind="ChevronRight" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"  />
                            </Grid>
                        </materialDesign:Card>
                    </ListViewItem>
                    <ListViewItem Tag="alerts">
                        <materialDesign:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon  Kind="Alert" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"  />
                                <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{DynamicResource Alerts}" /><TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiNotificationsSoundsAndOfflineDeath}" TextWrapping="Wrap" /></StackPanel>
                                <materialDesign:PackIcon Grid.Column="2"  Kind="ChevronRight" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"  />
                            </Grid>
                        </materialDesign:Card>
                    </ListViewItem>
                    <ListViewItem Tag="chat-commands">
                        <materialDesign:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon  Kind="Chat" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"  />
                                <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{DynamicResource ChatCommandsSettings}" /><TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" Text="Configure team chat commands and device bindings" TextWrapping="Wrap" /></StackPanel>
                                <materialDesign:PackIcon Grid.Column="2"  Kind="ChevronRight" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"  />
                            </Grid>
                        </materialDesign:Card>
                    </ListViewItem>
                    <ListViewItem Tag="alert-templates">
                        <materialDesign:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon  Kind="Pencil" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"  />
                                <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{DynamicResource CustomAlertsHeader}" /><TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource CustomAlertsDesc}" TextWrapping="Wrap" /></StackPanel>
                                <materialDesign:PackIcon Grid.Column="2"  Kind="ChevronRight" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"  />
                            </Grid>
                        </materialDesign:Card>
                    </ListViewItem>
                    <ListViewItem Tag="map">
                        <materialDesign:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon  Kind="Earth" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"  />
                                <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{DynamicResource UiMap}" /><TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiPerformanceMarkersAnd3DData}" TextWrapping="Wrap" /></StackPanel>
                                <materialDesign:PackIcon Grid.Column="2"  Kind="ChevronRight" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"  />
                            </Grid>
                        </materialDesign:Card>
                    </ListViewItem>
                    <ListViewItem Tag="connected">
                        <materialDesign:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon  Kind="Cloud" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"  />
                                <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{DynamicResource UiConnectedServices}" /><TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiCloudDiscordAlexaChatAndSteam}" TextWrapping="Wrap" /></StackPanel>
                                <materialDesign:PackIcon Grid.Column="2"  Kind="ChevronRight" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"  />
                            </Grid>
                        </materialDesign:Card>
                    </ListViewItem>
                    <ListViewItem Tag="system">
                        <materialDesign:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon  Kind="Refresh" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"  />
                                <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{DynamicResource UiSystem}" /><TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiMaintenanceBackupResetAndCredits}" TextWrapping="Wrap" /></StackPanel>
                                <materialDesign:PackIcon Grid.Column="2"  Kind="ChevronRight" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"  />
                            </Grid>
                        </materialDesign:Card>
                    </ListViewItem>
                </ListView>
            </Grid>

            <Grid x:Name="SettingsDetailPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Padding="10,9" Background="#FF15191E" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Width="30" Height="30" Margin="0,0,10,0" Padding="0" ToolTip="{DynamicResource UiBackToSettingsCategories}" Click="SettingsBack_Click"><materialDesign:PackIcon  Kind="ArrowLeft"  /></Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SettingsDetailTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="SettingsDetailSubtitle" Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ListView x:Name="SettingsSectionList" Grid.Row="1" Margin="8" DisplayMemberPath="Title" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SettingsSectionList_SelectionChanged" />

                <ScrollViewer x:Name="SettingsSearchResultsScroller" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="SettingsSearchResults" Margin="12,12,12,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button MinHeight="54" Margin="0,0,0,8" Padding="12,8" HorizontalContentAlignment="Stretch" Tag="{Binding}" Click="SettingsSearchResult_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding BeforeMatch}" /><Run Background="#FF60CDFF" Foreground="#FF071218" FontWeight="Bold" Text="{Binding Match}" /><Run Text="{Binding AfterMatch}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource TextSubtle}"><Run Text="{Binding CategoryTitle}" /><Run Text="  ›  " /><Run Text="{Binding SectionTitle}" /></TextBlock>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="1"  Kind="ChevronRight" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"  />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsSectionsPanel" Margin="12">
                <!-- General Section -->
                <StackPanel x:Name="SectionGeneral">
                <TextBlock Text="{DynamicResource General}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <materialDesign:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Language}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                            <ComboBox Grid.Column="1" x:Name="CmbLanguage" tutorials:Tutorial.TargetId="Settings.Language" Width="150" SelectedValuePath="Code" SelectionChanged="CmbLanguage_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon  Kind="Cog" Width="20" Height="15" Margin="0,0,8,0" FontSize="14" Foreground="{DynamicResource TextSubtle}">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <Image Source="{Binding ImagePath}" Width="20" Height="15" Margin="0,0,8,0" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkAutoStart" Content="{DynamicResource LaunchWithWindows}" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkStartMinimized" Content="{DynamicResource StartMinimizedAlways}" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkAutoConnect" Content="{DynamicResource AutoConnectLastServer}" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource AutoConnectToolTip}" />
                    </StackPanel>
                </materialDesign:Card>
                </StackPanel>

                <!-- Behavior Section -->
                <StackPanel x:Name="SectionBehavior">
                <TextBlock Text="{DynamicResource Behavior}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <materialDesign:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkCloseToTray" Content="{DynamicResource MinimizeToTray}" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkStreamerMode" Content="{DynamicResource EnableStreamerMode}" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource StreamerModeToolTip}" />

                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkBackgroundTracking" Content="{DynamicResource BackgroundTracking}" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource BackgroundTrackingToolTip}" />

                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkHideConsole" Content="{DynamicResource HideSystemConsole}" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource HideConsoleToolTip}" />
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkCloudSync" Content="{DynamicResource CloudSync}" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource CloudSyncDesc}" />
                    </StackPanel>
                </materialDesign:Card>
                </StackPanel>

                <!-- Server Events Section -->
                <StackPanel x:Name="SectionServerEvents">
                <TextBlock Text="{DynamicResource ServerEventsSection}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <materialDesign:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkListenForServerEvents" Content="{DynamicResource ListenForServerEvents}" Margin="0,0,0,6" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        <TextBlock Text="{DynamicResource ListenForServerEventsDesc}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkTrustOwnDetections" Content="{DynamicResource TrustOwnDetections}" Margin="0,0,0,6" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        <TextBlock Text="{DynamicResource TrustOwnDetectionsDesc}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" />
                    </StackPanel>
                </materialDesign:Card>
                </StackPanel>

                <!-- Offline Death Section -->
                <StackPanel x:Name="SectionOfflineDeath">
                <TextBlock Text="{DynamicResource OfflineDeathNotifications}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <materialDesign:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <!-- Enable Offline Death alerts -->
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkOfflineDeathAlerts" Content="{DynamicResource EnableOfflineDeathAlerts}" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

                        <!-- Custom sound selector -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AlertSound}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                            
                            <Button Grid.Column="1" x:Name="BtnSelectOfflineDeathSound" Margin="8,0,0,0" Height="28" Click="BtnSelectOfflineDeathSound_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Folder" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource SelectEllipsis}" /></StackPanel></Button>
                            <Button Grid.Column="2" x:Name="BtnResetOfflineDeathSound" Margin="8,0,0,0" Height="28" Click="BtnResetOfflineDeathSound_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource Reset}" /></StackPanel></Button>
                        </Grid>

                        <TextBlock x:Name="TxtOfflineDeathSoundPath" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,8" TextWrapping="Wrap" />

                        <!-- Loop Alert Sound toggle -->
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkOfflineDeathSoundLoop" Content="{DynamicResource LoopAlertSound}" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

                        <!-- Discord advanced bot toggle (Supporter only) -->
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkOfflineDeathDiscord" Content="{DynamicResource SendToDiscordRaidAlerts}" Margin="0,0,0,12" Checked="OnSettingChanged" Unchecked="OnSettingChanged" PreviewMouseDown="PremiumFeature_PreviewMouseDown" />

                        <!-- Button to open offline deaths log popup -->
                        <Button x:Name="BtnOpenOfflineDeathsLog" HorizontalAlignment="Stretch" Height="36" Click="BtnOpenOfflineDeathsLog_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource OpenOfflineDeathsLog}" /></StackPanel></Button>
                    </StackPanel>
                </materialDesign:Card>
                </StackPanel>

                <!-- Notification Center Section -->
                <StackPanel x:Name="SectionNotifications">
                <TextBlock Text="{DynamicResource NotificationCenterSettings}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <materialDesign:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <!-- Enable Toast Notifications -->
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkNotificationsToast" Content="{DynamicResource ShowToastNotifications}" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

                        <!-- Enable Notification Sounds -->
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkNotificationsSounds" Content="{DynamicResource PlaySoundAlerts}" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

                        <!-- Notification Retention Period -->
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource NotificationRetentionPeriod}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" Margin="4,0,10,0" FontSize="12" />
                            <Slider Grid.Column="1" x:Name="SliderNotificationsRetention" Minimum="1" Maximum="90" Value="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="TxtRetentionDays" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextPrimary}" FontSize="12" Width="60" />
                        </Grid>

                        <!-- Muted Servers -->
                        <TextBlock Text="{DynamicResource MutedServers}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSubtle}" Margin="4,6,0,4" />
                        <materialDesign:Card MinHeight="60" MaxHeight="120" Margin="4,0" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PnlMutedServers" />
                            </ScrollViewer>
                        </materialDesign:Card>
                    </StackPanel>
                </materialDesign:Card>
                </StackPanel>

                <!-- Map Performance Section -->
                <StackPanel x:Name="SectionMapPerformance" tutorials:Tutorial.TargetId="Settings.Map">
                <TextBlock Text="{DynamicResource UiMapPerformanceQuality}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <materialDesign:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <!-- Image Scaling Quality Dropdown -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,8,0" Text="{DynamicResource UiImageScalingQuality}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" ToolTip="{DynamicResource UiControlsMapImageScalingFilteringMode}" />
                            <ComboBox Grid.Column="1" x:Name="CmbMapScalingMode" Width="200" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="{DynamicResource UiHighQualityBicubic}" Tag="0" />
                                <ComboBoxItem Content="{DynamicResource UiBalancedLinear}" Tag="1" />
                                <ComboBoxItem Content="{DynamicResource UiPerformanceNearestNeighbor}" Tag="2" />
                            </ComboBox>
                        </Grid>

                        <!-- GPU Caching Toggle -->
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkMapUseCacheMode" Content="{DynamicResource UiEnableGPUBitmapCaching}" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource UiCachesMapRenderingOnTheGPUExtremelyImprovesPanningAndZoomingSmoothness}" />

                        <!-- GPU Rendering Scale Dropdown -->
                        <Grid Margin="0,0,0,12" x:Name="GridMapRenderScale" IsEnabled="{Binding IsChecked, ElementName=ChkMapUseCacheMode}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,8,0" Text="{DynamicResource UiGPURenderingScale}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" ToolTip="{DynamicResource UiResolutionScaleOfTheCachedGPUBitmapLowerScalesImprovePerfo767E03E084}" />
                            <ComboBox Grid.Column="1" x:Name="CmbMapRenderScale" Width="200" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="{DynamicResource UiText50Fastest}" Tag="0.5" />
                                <ComboBoxItem Content="{DynamicResource UiText75Performance}" Tag="0.75" />
                                <ComboBoxItem Content="{DynamicResource UiText100Native}" Tag="1.0" />
                                <ComboBoxItem Content="{DynamicResource UiText125Sharp}" Tag="1.25" />
                                <ComboBoxItem Content="{DynamicResource UiText150HighResolution}" Tag="1.5" />
                                <ComboBoxItem Content="{DynamicResource UiText200UltraHighResolution}" Tag="2.0" />
                            </ComboBox>
                        </Grid>

                        <!-- Aliased Edge Mode Toggle -->
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkMapUseAliasedEdgeMode" Content="{DynamicResource UiDisableGridAntiAliasingAliasedEdgeMode}" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource UiDisablesAntiAliasingOnGridLinesAndMarkersImprovesRenderingC0D2589FE1}" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- Custom HD Map Image Card -->
                <TextBlock Text="Custom HD Map Image" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" Margin="0,8,0,0" />
                <materialDesign:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <TextBlock Text="Use a custom high-definition map image from a URL source instead of the map coming from the server. Cached locally and automatically wiped when a server wipe is detected." TextWrapping="Wrap" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,0,0,10" />
                        
                        <TextBlock Text="Custom Map Image URL" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
