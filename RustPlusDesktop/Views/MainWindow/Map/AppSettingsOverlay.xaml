                            </StackPanel>
                        </Expander>

                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" x:Name="ChkTelegramIntegration" Content="{DynamicResource UiTeamPathsTracking}" Margin="0,0,0,10" Opacity="0.45" IsEnabled="False" />
                    </StackPanel>
                </materialDesign:Card>
                <Button
                    HorizontalAlignment="Stretch"
                    Height="38"
                    Margin="0,10,0,0"
                    AutomationProperties.Name="{DynamicResource UiUpgradeToSupporter}"
                    Click="BtnUpgradeSupporter_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Star" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource UiUpgradeToSupporter}" /></StackPanel>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPremium}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                </StackPanel>

                <!-- Chat Commands Section -->
                <StackPanel x:Name="SectionChatCommands" tutorials:Tutorial.TargetId="Settings.ChatCommands">
                <TextBlock Text="{DynamicResource ChatCommandsSettings}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <views:ChatCommandsOverlay x:Name="ChatCommandsEditor" />
                </StackPanel>

                <!-- Chat Alert Templates Section -->
                <StackPanel x:Name="SectionChatAlertTemplates">
                <TextBlock Text="{DynamicResource CustomAlertsHeader}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <windows:CustomAlertsEditor />
                </StackPanel>

                <!-- Steam Account Section -->
                <StackPanel x:Name="SectionSteamAccount">
                <TextBlock Text="{DynamicResource SteamAccount}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <materialDesign:Card Style="{StaticResource SettingsNativeCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon  Kind="Account" Margin="0,0,10,0" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" FontSize="18"  />
                        <TextBlock Grid.Column="1" Text="{DynamicResource ManageSteamAccountInfo}" Foreground="{DynamicResource TextSubtle}" FontSize="12" FontStyle="Italic" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </materialDesign:Card>
                </StackPanel>

                <!-- Maintenance Section -->
                <StackPanel x:Name="SectionMaintenance" tutorials:Tutorial.TargetId="Settings.Maintenance">
                <TextBlock Text="{DynamicResource MaintenanceTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <materialDesign:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource MaintenanceDesc}" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap" />
                        
                        <Button x:Name="BtnShowResetDialog" HorizontalAlignment="Stretch" Height="36" Margin="0,0,0,8" Click="BtnShowResetDialog_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource ResetAppData}" /></StackPanel></Button>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnBackupData" Grid.Column="0" HorizontalAlignment="Stretch" Height="36" Margin="0,0,4,0" Click="BtnBackupData_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Upload" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource BackupData}" /></StackPanel></Button>
                            <Button x:Name="BtnRestoreData" Grid.Column="1" HorizontalAlignment="Stretch" Height="36" Margin="4,0,0,0" Click="BtnRestoreData_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Download" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource RestoreData}" /></StackPanel></Button>
                        </Grid>
                        
                        <!-- Purge Orphaned Cloud Data Button -->
                        <Button x:Name="BtnPurgeOrphanedCloudData" HorizontalAlignment="Stretch" Height="36" Margin="0,8,0,0" Click="BtnPurgeOrphanedCloudData_Click" ToolTip="{DynamicResource PurgeOrphanedCloudDataTooltip}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource PurgeOrphanedCloudData}" /></StackPanel></Button>
                    </StackPanel>
                </materialDesign:Card>
                </StackPanel>

                <!-- 3D Map Section -->
                <StackPanel x:Name="SectionThreeDMap">
                <TextBlock Text="{DynamicResource ThreeDMapSectionTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <materialDesign:Card Style="{StaticResource SettingsNativeCard}">
                    <WrapPanel>
                        <!-- Delete 3D Map Data button -->
                        <Button HorizontalAlignment="Left" Padding="12,6" Click="BtnDelete3DMapData_Click" ToolTip="{DynamicResource Delete3DMapDataTooltip}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource Settings3dMapDeleteData}" /></StackPanel></Button>
                        
                        <!-- Manually Parse Map button -->
                        <Button x:Name="BtnManuallyParseMap" HorizontalAlignment="Left" Padding="12,6" Margin="8,0,0,0" Click="BtnManuallyParseMap_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FolderOpen" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource UiParse3DMapManually}" /></StackPanel></Button>
                    </WrapPanel>
                </materialDesign:Card>
                </StackPanel>

                <!-- Credits Section -->
                <StackPanel x:Name="SectionCredits">
                <TextBlock Text="{DynamicResource CreditsTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <materialDesign:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <!-- rustmaps.com credit -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon  Kind="Heart" FontSize="15" Margin="0,0,8,0" Foreground="#E05070" VerticalAlignment="Center"  />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12">
                                <Run Text="{DynamicResource CreditsIconsPrefix}" Foreground="{DynamicResource TextSubtle}" />
                                <Hyperlink NavigateUri="https://rustmaps.com" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource Accent}">
                                    <Run Text="{DynamicResource UiRustmapsCom}" />
                                </Hyperlink>
                                <Run Text="{DynamicResource CreditsIconsSuffix}" Foreground="{DynamicResource TextSubtle}" />
                            </TextBlock>
                        </StackPanel>
                        <!-- legal note -->
                        <TextBlock Text="{DynamicResource CreditsIconsNote}" Foreground="{DynamicResource TextSubtle}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                </materialDesign:Card>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
