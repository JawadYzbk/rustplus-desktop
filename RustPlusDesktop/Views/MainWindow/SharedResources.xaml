<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:RustPlusDesk.Converters"
    xmlns:services="clr-namespace:RustPlusDesk.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Only main-window content resources live here. Visual styles are application-wide. -->
<conv:UpkeepBackgroundConverter x:Key="UpkeepBackgroundConverter" />

<conv:StorageChipConverter x:Key="StorageChipConverter" />

<conv:StorageUpkeepConverter x:Key="StorageUpkeepConverter" />

<conv:KindToStorageVisibilityConverter x:Key="KindToStorageVisibility" />

<conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

<conv:BoolToVisibilityConverter x:Key="BoolToVisibilityInv" Invert="True" />

<conv:LessThanConverter x:Key="LessThanConverter" />

<conv:DeviceTreeItemWidthConverter x:Key="DeviceTreeItemWidthConverter" />

<conv:SwitchCommandDisplayConverter x:Key="SwitchCommandDisplayConverter" />

<conv:DeviceHotkeyDisplayConverter x:Key="DeviceHotkeyDisplayConverter" />

<conv:DeviceFilterVisibilityConverter x:Key="DeviceFilterVisibilityConverter" />

<BitmapImage x:Key="IconStorageMonitor" UriSource="pack://application:,,,/Assets/icons/storagemonitor.png" />

<BitmapImage x:Key="IconSmartSwitch" UriSource="pack://application:,,,/Assets/icons/smartswitch.png" />

<BitmapImage x:Key="IconSmartAlarm" UriSource="pack://application:,,,/Assets/icons/smartalarm.png" />

<BitmapImage x:Key="IconGroup" UriSource="pack://application:,,,/Assets/icons/cabins.png" />

<Style x:Key="SidebarTabControl" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <ContentPresenter
                        x:Name="PART_SelectedContentHost"
                        ContentSource="SelectedContent"
                        KeyboardNavigation.TabNavigation="Local"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

<Style x:Key="PillToggleButton" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="#2AFFFFFF"
                        BorderThickness="1"
                        CornerRadius="0"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="First">
                            <Setter TargetName="Bd" Property="CornerRadius" Value="6,0,0,6" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Middle">
                            <Setter Property="Margin" Value="-1,0,0,0" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Last">
                            <Setter Property="Margin" Value="-1,0,0,0" />
                            <Setter TargetName="Bd" Property="CornerRadius" Value="0,6,6,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#40FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Panel.ZIndex" Value="1" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Bd" Property="Background" Value="#4B3D2B" />
                            <Setter Property="Foreground" Value="#FFCA00" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB900" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

<conv:NotNullToBoolConverter x:Key="NotNull" />
</ResourceDictionary>
