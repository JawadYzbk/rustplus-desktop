<Window x:Class="RustPlusDesk.Views.DeviceImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:RustPlusDesk.Controls"
        xmlns:p="clr-namespace:RustPlusDesk.Properties"
        Title="{DynamicResource ImportDevicesTitle}"
        Width="760"
        Height="580"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowsTransparency="False"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="48"
            CornerRadius="0"
            GlassFrameThickness="-1"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom TitleBar -->
        <Border Grid.Row="0"
                Background="#0F1013"
                BorderBrush="#1AFFFFFF"
                BorderThickness="0,0,0,1">
            <controls:MaterialTitleBar
                Height="48"
                Title="{DynamicResource ImportDevicesTitle}"
                IconSource="pack://application:,,,/Assets/rustplus-desktop-icon.ico"
                Background="Transparent" />
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="1"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius}"
                Padding="16"
                Margin="8">

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Probing Progress Panel -->
                    <RowDefinition Height="Auto" />
                    <!-- Search & List -->
                    <RowDefinition Height="*" />
                    <!-- Footer Actions -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header Section -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{DynamicResource ImportDevicesHeader}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="{Binding SourceDescription}"
                               Foreground="{DynamicResource Accent}"
                               FontSize="12"
                               FontWeight="Medium"
                               Margin="0,2,0,4"/>

                    <TextBlock Text="{DynamicResource ImportDevicesSelectPrompt}"
                               Foreground="{DynamicResource TextSubtle}"
                               FontSize="13"/>
                </StackPanel>

                <!-- Probing Progress Bar (Visible only when probing) -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource SurfaceAlt}" 
                        BorderBrush="{DynamicResource CardBorder}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="12" 
                        Margin="0,0,0,12"
                        Visibility="{Binding IsProbing, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                   Text="{Binding ProbingStatus}" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"
                                   FontSize="12"/>
                                   
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                   Text="{Binding ProbingProgressText}" 
                                   Foreground="{DynamicResource TextSubtle}" 
                                   VerticalAlignment="Center"
                                   FontSize="11"/>

                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" 
                                     Height="6" 
                                     Margin="0,8,0,0" 
                                     Minimum="0" 
                                     Maximum="{Binding ProbingMax}" 
                                     Value="{Binding ProbingProgress}" 
                                     Foreground="{DynamicResource Accent}"/>
                    </Grid>
                </Border>

                <!-- Search + Device List -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Search Bar -->
                        <RowDefinition Height="Auto" /> <!-- Summary Info -->
                        <RowDefinition Height="*" />    <!-- List -->
                    </Grid.RowDefinitions>

                    <!-- Search box -->
                    <TextBox Grid.Row="0"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,8" materialDesign:HintAssist.Hint="{DynamicResource UiSearchDevicesByNameTypeOwnerID}" />

                    <!-- Summary Text -->
                    <TextBlock Grid.Row="1" 
                               Text="{Binding SummaryText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSubtle}"
                               Margin="0,0,0,8" />

                    <!-- Scrollable Device list and Empty State -->
                    <Grid Grid.Row="2">
                        <!-- Scrollable Device list -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      ScrollViewer.PanningMode="VerticalOnly">

                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <materialDesign:Card Margin="0,0,8,8" Padding="12">
                                            <materialDesign:Card.Style>
                                                <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AlreadyPresent}" Value="True">
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FromPreviousWipe}" Value="True">
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:Card.Style>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Selection checkbox -->
                                                <CheckBox Grid.Column="0" 
                                                          Style="{StaticResource DotCheckBox}"
                                                          IsChecked="{Binding IsSelected}"
                                                          IsEnabled="{Binding IsSelectable}"                                    
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0" />

                                                <!-- Device icon -->
                                                <Border Grid.Column="1"
                                                        Width="36"
                                                        Height="36"
                                                        Background="#14FFFFFF"
                                                        CornerRadius="6"
                                                        Padding="6"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center">
                                                    <Image Stretch="Uniform">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Source" Value="/Assets/icons/smartswitch.png" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="SmartAlarm">
                                                                        <Setter Property="Source" Value="/Assets/icons/smartalarm.png" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="SmartSwitch">
                                                                        <Setter Property="Source" Value="/Assets/icons/smartswitch.png" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="StorageMonitor">
                                                                        <Setter Property="Source" Value="/Assets/icons/storagemonitor.png" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Border>

                                                <!-- Device main info -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ExistsState}" Value="missing">
                                                                        <Setter Property="Foreground" Value="Tomato" />
                                                                        <Setter Property="FontStyle" Value="Italic" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <materialDesign:PackIcon  Kind="Account" FontSize="12" Foreground="{DynamicResource TextSubtle}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Tagline}"
                                                                   Foreground="{DynamicResource TextSubtle}"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!--  Says why these are unselected, instead of leaving
                                                          the user to import them and find out later.  -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                                Visibility="{Binding FromPreviousWipe, Converter={StaticResource BoolToVisConverter}}">
                                                        <materialDesign:PackIcon  Kind="Alert" FontSize="12" Foreground="#E8A33D" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource ImportFromPreviousWipe}"
                                                                   Foreground="#E8A33D"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="3" 
                                                        VerticalAlignment="Center" 
                                                        HorizontalAlignment="Right"
                                                        CornerRadius="6"
                                                        Padding="8,4"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#0FFFFFFF"/>
                                                            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ExistsState}" Value="ok">
                                                                    <Setter Property="Background" Value="#1A4CAF50"/>
                                                                    <Setter Property="BorderBrush" Value="#334CAF50"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ExistsState}" Value="missing">
                                                                    <Setter Property="Background" Value="#1AF44336"/>
                                                                    <Setter Property="BorderBrush" Value="#33F44336"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ExistsState}" Value="local">
                                                                    <Setter Property="Background" Value="#1A2196F3"/>
                                                                    <Setter Property="BorderBrush" Value="#332196F3"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Margin="0,0,4,0" FontSize="13" VerticalAlignment="Center">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Kind" Value="HelpCircle"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ExistsState}" Value="ok">
                                                                            <Setter Property="Kind" Value="Check"/>
                                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ExistsState}" Value="missing">
                                                                            <Setter Property="Kind" Value="Close"/>
                                                                            <Setter Property="Foreground" Value="#F44336"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ExistsState}" Value="local">
                                                                            <Setter Property="Kind" Value="Information"/>
                                                                            <Setter Property="Foreground" Value="#2196F3"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ExistsState}" Value="err">
                                                                            <Setter Property="Kind" Value="Alert"/>
                                                                            <Setter Property="Foreground" Value="#FFA500"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>
                                                        
                                                        <TextBlock Text="{Binding ExtraInfo}"
                                                                   FontSize="11"
                                                                   FontWeight="Medium"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ExistsState}" Value="ok">
                                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ExistsState}" Value="missing">
                                                                            <Setter Property="Foreground" Value="#F44336"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ExistsState}" Value="local">
                                                                            <Setter Property="Foreground" Value="#2196F3"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ExistsState}" Value="err">
                                                                            <Setter Property="Foreground" Value="#FFA500"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </materialDesign:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <TextBlock Text="{DynamicResource UiNoDevicesMatchYourSearch}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSubtle}"
                                   FontSize="14"
                                   FontStyle="Italic"
                                   Visibility="{Binding NoDevicesVisible, Converter={StaticResource BoolToVisConverter}}" />
                    </Grid>
                </Grid>

                <!-- Footer command bar -->
                <Border Grid.Row="3"
                        Padding="0,12,0,0"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left actions: Selection helpers + Probing -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button
                                       Click="BtnSelectAll_Click"
                                       IsEnabled="{Binding IsNotProbing}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CheckboxMarkedOutline" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource SelectAll}" /></StackPanel></Button>
                            
                            <Button
                                       Margin="8,0,0,0"
                                       Click="BtnDeselectAll_Click"
                                       IsEnabled="{Binding IsNotProbing}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CropSquare" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource DeselectAll}" /></StackPanel></Button>
                                       
                            <Button
                                       Margin="16,0,0,0"
                                       Click="BtnCheckStatus_Click"
                                       IsEnabled="{Binding IsNotProbing}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Heart" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource CheckDeviceStatus}" /></StackPanel></Button>
                        </StackPanel>

                        <!-- Right actions: Cancel + Import -->
                        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                            <Button
                                       IsCancel="True"
                                       Click="BtnCancel_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Close" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource Cancel}" /></StackPanel></Button>
                                       
                            <Button
                                       IsDefault="True"
                                       Click="BtnImport_Click"
                                       Margin="8,0,0,0"
                                       IsEnabled="{Binding CanImport}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Download" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource ImportSelected}" /></StackPanel></Button>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
