<Window x:Class="RustPlusDesk.Views.Windows.PlayerWipeTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player Wipe Tracker"
        Width="1180" Height="820" MinWidth="960" MinHeight="650"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TrackerListView" TargetType="ListView">
            <Setter Property="Background" Value="#151B23" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1C2A35" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#203B4A" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrackerColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#1D2630" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="4" Height="46" Background="{DynamicResource Accent}" CornerRadius="2" Margin="0,0,12,0" />
                <StackPanel>
                    <TextBlock Text="WIPE / FIELD NOTES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="Player Wipe Tracker" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="A local-first route console for the hours that matter." Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Refresh" Click="Refresh_Click" Padding="16,7" Margin="0,0,8,0" />
                <Button Content="Cloud restore" Click="CloudRestoreTab_Click" Padding="16,7" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="PremiumBanner" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,0,0,12" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PLAYER" Style="{StaticResource MetricLabel}" />
                        <ComboBox x:Name="PlayerSelector" Margin="0,4,16,0" SelectionChanged="PlayerSelector_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="COVERAGE" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="CoverageText" Style="{StaticResource MetricValue}" /></StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock Text="UNKNOWN" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="UnknownText" Style="{StaticResource MetricValue}" /></StackPanel>
                    <StackPanel Grid.Column="3" Margin="12,0,0,0"><TextBlock Text="DISTANCE" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="DistanceText" Style="{StaticResource MetricValue}" /></StackPanel>
                    <StackPanel Grid.Column="4" Margin="12,0,0,0"><TextBlock Text="DEATHS" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="DeathsText" Style="{StaticResource MetricValue}" /></StackPanel>
                    <StackPanel Grid.Column="5" Margin="12,0,0,0"><TextBlock Text="POINTS" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="PointCountText" Style="{StaticResource MetricValue}" /></StackPanel>
                    <StackPanel Grid.Column="6" Margin="12,0,0,0"><TextBlock Text="LOCAL STORE" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="StorageText" Style="{StaticResource MetricValue}" /></StackPanel>
                </Grid>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" x:Name="TrackerTabs">
            <TabItem Header="Overview">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.2*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.RowSpan="2" Style="{StaticResource Panel}" Margin="0,0,10,0" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="Observation timeline" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,8" />
                            <ListView Grid.Row="1" x:Name="TimelineList" Style="{StaticResource TrackerListView}">
                                <ListView.View><GridView ColumnHeaderContainerStyle="{StaticResource TrackerColumnHeader}">
                                    <GridViewColumn Header="Start" DisplayMemberBinding="{Binding Start}" Width="145" />
                                    <GridViewColumn Header="End" DisplayMemberBinding="{Binding End}" Width="145" />
                                    <GridViewColumn Header="State" DisplayMemberBinding="{Binding State}" Width="90" />
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="170" />
                                </GridView></ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="Monument visits" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,8" />
                            <ListView Grid.Row="1" x:Name="VisitsList" Style="{StaticResource TrackerListView}">
                                <ListView.View><GridView ColumnHeaderContainerStyle="{StaticResource TrackerColumnHeader}">
                                    <GridViewColumn Header="Monument" DisplayMemberBinding="{Binding Name}" Width="160" />
                                    <GridViewColumn Header="Duration" DisplayMemberBinding="{Binding Duration}" Width="120" />
                                </GridView></ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Panel}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Read the signal" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Unknown periods are gaps in Rust+ visibility, not an inferred route. Distances are measured only across short, valid snapshots." TextWrapping="Wrap" Foreground="{DynamicResource TextSubtle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ReplayTab" Header="Route replay · Premium">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource Panel}" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="ReplayPlayButton" Content="Play" Click="ReplayPlay_Click" Padding="16,6" Margin="0,0,12,0" />
                            <Slider Grid.Column="1" x:Name="ReplayProgress" Minimum="0" Maximum="0" ValueChanged="ReplayProgress_ValueChanged" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="ReplayTimeText" MinWidth="150" TextAlignment="Right" VerticalAlignment="Center" Margin="14,0,12,0" />
                            <ComboBox Grid.Column="3" x:Name="ReplaySpeedSelector" Width="74" SelectionChanged="ReplaySpeed_Changed">
                                <ComboBoxItem Content="1×" Tag="1" IsSelected="True" />
                                <ComboBoxItem Content="2×" Tag="2" />
                                <ComboBoxItem Content="4×" Tag="4" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="10">
                        <Grid>
                            <Canvas x:Name="ReplayCanvas" Background="#101820" SizeChanged="Canvas_SizeChanged" />
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC101820" BorderBrush="#335A7482" BorderThickness="1" CornerRadius="5" Padding="8" Margin="12">
                                <StackPanel><TextBlock Text="ROUTE REPLAY" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="ReplayStateText" Margin="0,3,0,0" /></StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="HeatmapTab" Header="Heatmap · Premium">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Panel}" Padding="10" Margin="0,0,10,0"><Canvas x:Name="HeatmapCanvas" Background="#101820" SizeChanged="Canvas_SizeChanged" /></Border>
                    <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Movement density" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Every glow is a valid coordinate observation. Hotter cells mean more revisits, not more certainty." TextWrapping="Wrap" Foreground="{DynamicResource TextSubtle}" Margin="0,8,0,18" />
                            <TextBlock Text="LEGEND" Style="{StaticResource MetricLabel}" />
                            <Grid Margin="0,8,0,0" Height="16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#163F6A" /><Border Grid.Column="1" Background="#0B86A4" /><Border Grid.Column="2" Background="#27C8B2" /><Border Grid.Column="3" Background="#FFB340" /><Border Grid.Column="4" Background="#FF5A36" /></Grid>
                            <TextBlock x:Name="HeatmapText" Foreground="{DynamicResource TextSubtle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="CompareTab" Header="Compare · Premium">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource Panel}" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PLAYER A" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CompareASelector" Width="190" SelectionChanged="CompareSelector_Changed" />
                            <TextBlock Text="PLAYER B" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" Margin="22,0,8,0" />
                            <ComboBox x:Name="CompareBSelector" Width="190" SelectionChanged="CompareSelector_Changed" />
                            <TextBlock x:Name="CompareSummaryText" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" Margin="24,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,10">
                        <TextBlock Text="Cyan is Player A · amber is Player B. Comparison stays honest: it overlays only recorded coordinates and leaves missing periods blank." Foreground="{DynamicResource TextSubtle}" />
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="10"><Canvas x:Name="CompareCanvas" Background="#101820" SizeChanged="Canvas_SizeChanged" /></Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ExportTab" Header="Export · Premium">
                <Grid Margin="0,12,0,0">
                    <Border Style="{StaticResource Panel}" Padding="18" MaxWidth="720" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Take the wipe with you" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Export the selected player’s recorded observations, derived summary, route segments, and monument visits. JSON is lossless; CSV is ready for a spreadsheet or a quick handoff." TextWrapping="Wrap" Foreground="{DynamicResource TextSubtle}" Margin="0,8,0,20" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ExportJsonButton" Content="Export JSON" Click="ExportJson_Click" Padding="18,8" Margin="0,0,8,0" />
                                <Button x:Name="ExportCsvButton" Content="Export CSV" Click="ExportCsv_Click" Padding="18,8" />
                            </StackPanel>
                            <TextBlock x:Name="ExportStatusText" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="CloudTab" Header="Cloud restore · Premium">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Panel}" Padding="12" Margin="0,0,10,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="Cloud archives" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,8" />
                            <ListView Grid.Row="1" x:Name="CloudArchiveSelector" Style="{StaticResource TrackerListView}" SelectionChanged="CloudArchive_Changed" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Restore importer" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Downloads the selected archive day by day and merges it into the same local JSONL store used by live tracking. Repeating a restore is safe." TextWrapping="Wrap" Foreground="{DynamicResource TextSubtle}" Margin="0,8,0,18" />
                            <TextBlock x:Name="CloudArchiveDetailsText" TextWrapping="Wrap" />
                            <Button x:Name="RestoreCloudButton" Content="Restore selected archive" Click="RestoreCloud_Click" Padding="18,8" HorizontalAlignment="Left" Margin="0,20,0,0" />
                            <Button Content="Refresh cloud archives" Click="RefreshCloud_Click" Padding="18,8" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <TextBlock x:Name="CloudStatusText" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
