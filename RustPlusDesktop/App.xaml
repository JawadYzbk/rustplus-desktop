<Application x:Class="RustPlusDesk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:RustPlusDesk.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Themes/FluentControls.xaml" />
                <ResourceDictionary Source="Views/Themes/MenuFlyout.xaml" />
                <ResourceDictionary Source="Views/Themes/PanelHeader.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:TimerRemainingConverter x:Key="TimerRemainingConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
