<Window
    x:Class="RustPlusDesk.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:RustPlusDesk.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="clr-namespace:RustPlusDesk.Properties"
    xmlns:services="clr-namespace:RustPlusDesk.Services"
    xmlns:tutorials="clr-namespace:RustPlusDesk.Features.Tutorials"
    xmlns:tutorialControls="clr-namespace:RustPlusDesk.Features.Tutorials.Controls"
    xmlns:tutorialViews="clr-namespace:RustPlusDesk.Features.Tutorials.Views"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:controls="clr-namespace:RustPlusDesk.Controls"
    xmlns:views="clr-namespace:RustPlusDesk.Views"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="{DynamicResource AppTitle}"
    Width="1750"
    Height="814"
    MinWidth="1000"
    MinHeight="700"
    Background="{DynamicResource AppBg}"
    Foreground="{DynamicResource TextPrimary}"
    ResizeMode="CanResize"
    WindowStyle="None"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="48"
            CornerRadius="0"
            GlassFrameThickness="-1"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/MainWindow/SharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- WPF-UI Snackbar style removed: Material Design snackbars come from Helpers/MaterialSnackbar -->

        <DataTemplate x:Key="TrackedPlayerTemplate" DataType="{x:Type services:TrackedPlayer}">
            <Grid
                x:Name="PlayerRow"
                Margin="0,2"
                Background="Transparent">
                <Grid.ContextMenu>
                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                        <MenuItem
                            Click="BtnViewTracked_Click"
                            Header="{DynamicResource ViewProfile}"
                           ><MenuItem.Icon><materialDesign:PackIcon Kind="Eye" /></MenuItem.Icon>
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBMOnly}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>

                        <MenuItem
                            Click="BtnGroupTracked_Click"
                            Header="{DynamicResource ChangeGroup}"
                            ><MenuItem.Icon><materialDesign:PackIcon Kind="Folder" /></MenuItem.Icon></MenuItem>
                        <MenuItem
                            Click="BtnRenameTracked_Click"
                            Header="{DynamicResource Rename}"
                            ><MenuItem.Icon><materialDesign:PackIcon Kind="Pencil" /></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem
                            Click="BtnRemoveTracked_Click"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Header="{DynamicResource RemoveTracked}"
                            ><MenuItem.Icon><materialDesign:PackIcon Kind="Delete" /></MenuItem.Icon></MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Player Info  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        x:Name="StatusDot"
                        Width="8"
                        Height="8"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Fill="#666666" />
                    <TextBlock
                        x:Name="TxtName"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Name}" />
                </StackPanel>

                <!--  Timestamp / Playtime  -->
                <TextBlock
                    x:Name="TxtPlayTime"
                    Grid.Column="1"
                    Margin="8,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding PlayTimeStr}"
                    Visibility="Collapsed" />

                <!--  Actions  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="BtnViewAction"
                        Padding="8,2"
                        Click="BtnViewTracked_Click"
                        Content="{DynamicResource View}"
                        FontSize="11"
                        Tag="{Binding BMId}" />

                    <Button
                        x:Name="BtnMore"
                        Padding="4"
                        Click="BtnMore_Click"
                        Opacity="0"
                        ToolTip="{DynamicResource MoreOptions}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter TargetName="StatusDot" Property="Fill" Value="#62D38B" />
                    <Setter TargetName="TxtName" Property="Foreground" Value="White" />
                    <Setter TargetName="TxtPlayTime" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger SourceName="PlayerRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnMore" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding IsBMOnly}" Value="True">
                    <Setter TargetName="BtnViewAction" Property="Content" Value="View on BM" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <conv:BoolToVisibilityConverter x:Key="Vis" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Custom TitleBar for Guaranteed Visibility in Mica/Dark Mode  -->
        <Border
            Grid.Row="0"
            Background="#0F1013"
            BorderBrush="#1AFFFFFF"
            BorderThickness="0,0,0,1">
            <Grid x:Name="AppTitleBar" Height="48" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Grid.Column="0"
                    Width="16"
                    Height="16"
                    Margin="14,0,8,0"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="pack://application:,,,/Assets/rustplus-desktop-icon.ico" />
                <TextBlock
                    x:Name="AppTitleText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Medium"
                    Foreground="White"
                    Text="{DynamicResource AppTitle}" />
                <StackPanel Grid.Column="3" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        x:Name="BtnDiscord"
                        tutorials:Tutorial.TargetId="Navigation.Discord"
                        Width="36"
                        Height="36"
                        Margin="2,6"
                        Padding="0"
                        Click="BtnDiscord_Click"
                        ToolTip="{DynamicResource JoinDiscord}">
                        <Image
                            Width="16"
                            Height="16"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="pack://application:,,,/Assets/icons/discord.png" />
                    </Button>
                    <Button
                        x:Name="BtnPatchNotes"
                        Width="36"
                        Height="36"
                        Margin="2,6"
                        Padding="0"
                        Click="BtnPatchNotes_Click"
                        ToolTip="{DynamicResource PatchNotes}" />
                    <Button
                        x:Name="BtnDeaths"
                        Width="36"
                        Height="36"
                        Margin="2,6"
                        Padding="0"
                        Click="BtnDeaths_Click"
                        ToolTip="Death stats" />
                    <Button
                        x:Name="BtnSettings"
                        tutorials:Tutorial.TargetId="Navigation.Settings"
                        Width="36"
                        Height="36"
                        Margin="2,6"
                        Padding="0"
                        Click="BtnSettings_Click"
                        ToolTip="{DynamicResource Settings}" />
                    <Border
                        Height="36"
                        tutorials:Tutorial.TargetId="Updates.Status"
                        Margin="6,6,8,6"
                        HorizontalAlignment="Right"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdateStatusExpanded}" Value="True">
                                        <Setter Property="Background" Value="#181D22" />
                                        <Setter Property="BorderBrush" Value="#2AFFFFFF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                        <Setter Property="Background" Value="#162F37" />
                                        <Setter Property="BorderBrush" Value="#6600CCFF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                        <Setter Property="Background" Value="#122A31" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="BtnCheckUpdates"
                                tutorials:Tutorial.TargetId="Updates.Check"
                                MinWidth="34"
                                Height="34"
                                Padding="7,3"
                                Click="BtnCheckUpdates_Click"
                                ToolTip="{Binding UpdateStatusText}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon
                                            Foreground="{DynamicResource Accent}"
                                             Kind="Download"  />
                                        <Ellipse
                                            Width="5"
                                            Height="5"
                                            Margin="0,-3,-4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Fill="#62D38B"
                                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <Grid
                                        Grid.Column="1"
                                        MinWidth="210"
                                        Margin="9,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsUpdateStatusExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding UpdateStatusText}" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                HorizontalAlignment="Right"
                                                FontSize="10"
                                                Foreground="#CCFFFFFF"
                                                Text="{Binding UpdateDownloadPercentage}"
                                                Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibility}}" />
                                        </DockPanel>
                                        <TextBlock
                                            Grid.Row="1"
                                            HorizontalAlignment="Right"
                                            FontSize="8"
                                            Foreground="#99FFFFFF"
                                            Text="{Binding UpdateDownloadSpeed}"
                                            Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibility}}" />
                                        <ProgressBar
                                            Grid.Row="2"
                                            Height="3"
                                            Margin="0,1,0,0"
                                            IsIndeterminate="{Binding IsUpdateProcessing}"
                                            Value="{Binding UpdateDownloadProgress}"
                                            Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Grid>
                            </Button>
                            <Button
                                Grid.Column="1"
                                Width="46"
                                Height="30"
                                Padding="0"
                                Click="PauseResumeDownload_Click"
                                Content="{Binding PauseResumeButtonText}"
                                FontSize="9"
                                Visibility="{Binding CanControlUpdateDownload, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                Grid.Column="2"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Click="CancelDownload_Click"
                                ToolTip="{DynamicResource UiCancelDownload}"
                                Visibility="{Binding CanControlUpdateDownload, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                    </StackPanel>
                <controls:MaterialCaptionButtons Grid.Column="4" />
            </Grid>
        </Border>

        <Grid
            x:Name="Root"
            Grid.Row="1"
            Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="ColSidebar"
                    Width="64"
                    MinWidth="64"
                    MaxWidth="480" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <GridSplitter
                x:Name="SidebarSplitter"
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                DragCompleted="SidebarSplitter_DragCompleted"
                MouseEnter="LeftPanelBorder_MouseEnter"
                MouseLeave="LeftPanelBorder_MouseLeave"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns"
                ShowsPreview="False" />

            <!--  Left Panel  -->
            <Border
                x:Name="LeftPanelBorder"
                tutorials:Tutorial.TargetId="Navigation.Main"
                Grid.Column="0"
                MinWidth="64"
                MaxWidth="480"
                Margin="0,0,0,0"
                Padding="0"
                Background="{DynamicResource Surface}"
                BorderBrush="#1AFFFFFF"
                BorderThickness="0,0,1,0"
                ClipToBounds="True"
                CornerRadius="0"
                MouseEnter="LeftPanelBorder_MouseEnter"
                MouseLeave="LeftPanelBorder_MouseLeave"
                TextElement.FontFamily="Segoe UI Variable Display, Segoe UI">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="24"
                        Opacity="0.35"
                        ShadowDepth="0"
                        Color="#000000" />
                </Border.Effect>
                <Grid>
                    <DockPanel
                        x:Name="LeftPanelContent"
                        Margin="72,16,12,16"
                        LastChildFill="True"
                        Visibility="Collapsed">

                    <!--  TOP: Account + Serverliste  -->
                    <StackPanel x:Name="ServerContextPanel" DockPanel.Dock="Top" tutorials:Tutorial.TargetId="Servers.Current">
                        <!--  Header  -->
                        <Border
                            Margin="0,0,0,10"
                            Padding="9,7"
                            Background="{DynamicResource SurfaceAlt}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Profile Picture / Icon  -->
                                <Grid
                                    Grid.Column="0"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,8,0">
                                    <Border
                                        Background="#1AFFFFFF"
                                        ClipToBounds="True"
                                        CornerRadius="14">
                                        <Grid>
                                            <materialDesign:PackIcon
                                                FontSize="16"
                                                Foreground="White"
                                                Opacity="0.4"
                                                 Kind="Account"  />
                                            <Image
                                                x:Name="ImgSteam"
                                                Source="{Binding MyAvatar}"
                                                Stretch="UniformToFill"
                                                RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MyAvatar}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!--  Identity  -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            ToolTip="{DynamicResource UiRustCompanionConnection}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#68717D" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRustCompanionConnected}" Value="True">
                                                            <Setter Property="Fill" Value="#57C979" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock
                                            FontSize="8"
                                            FontWeight="Bold"
                                            Foreground="#E8612C"
                                            Text="{DynamicResource UiRUSTCOMPANION}" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="TxtSteamName"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{DynamicResource SteamAccount}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="TxtSteamId"
                                        FontSize="8"
                                        Foreground="White"
                                        Opacity="0.6"
                                        Text="{DynamicResource NotLoggedIn}" />
                                </StackPanel>

                                <!--  Action Buttons  -->
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="BtnPinSidebar"
                                        Width="32"
                                        Height="28"
                                        Margin="2,0,0,0"
                                        Padding="0"
                                        Click="BtnToggleSidebarPin_Click"
                                        ToolTip="{DynamicResource UiKeepSidebarUnfolded}">
                                        <materialDesign:PackIcon x:Name="PinSidebarIcon" Kind="Pin" Width="16" Height="16" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Margin="0,6,0,0" Padding="0,5,0,0" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="28" Height="28">
                                        <materialDesign:PackIcon FontSize="16" Foreground="{DynamicResource Accent}"  Kind="Cloud"  />
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Stroke="{DynamicResource SurfaceAlt}"
                                            StrokeThickness="1.5"
                                            ToolTip="{Binding CloudAccountStatusText}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#68717D" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCloudConnected}" Value="True">
                                                            <Setter Property="Fill" Value="#57C979" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="6,0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="8"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Accent}"
                                            Text="{DynamicResource CloudAccountTitle}" />
                                        <TextBlock
                                            FontSize="8"
                                            Foreground="#CCFFFFFF"
                                            Text="{Binding CloudAccountStatusText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        x:Name="BtnCloudAccount"
                                        tutorials:Tutorial.TargetId="Account.Cloud"
                                        Grid.Column="2"
                                        MinWidth="62"
                                        Height="26"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{DynamicResource UiOpenCloudAccount}"
                                        Click="BtnCloudAccount_Click"
                                        Content="{Binding CloudAccountActionText}" />
                                </Grid>
                            </Border>
                            </StackPanel>
                        </Border>

                        <!--  FCM Token Expiry Banner (Material)  -->
                        <Border
                            x:Name="FcmExpiryInfoBar"
                            Margin="0,0,0,10"
                            Padding="12,8"
                            CornerRadius="8"
                            Background="#1A60CDFF">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FcmExpiryDays, Converter={StaticResource LessThanConverter}, ConverterParameter=30}" Value="True">
                                            <Setter Property="Background" Value="#26E8A33D" />
                                            <Setter Property="BorderBrush" Value="#E8A33D" />
                                            <Setter Property="TextElement.Foreground" Value="#FFC978" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FcmExpiryDays}" Value="-1">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Kind="InformationOutline"
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="InformationOutline" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FcmExpiryDays, Converter={StaticResource LessThanConverter}, ConverterParameter=30}" Value="True">
                                                    <Setter Property="Kind" Value="AlertOutline" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Text="{DynamicResource UiRustCompanionSession}"
                                     />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Text="{Binding FcmExpiryText}"
                                     />
                            </StackPanel>
                        </Border>

                        <Border
                            Height="1"
                            Margin="0,0,0,12"
                            Background="#12FFFFFF" />

                        <Grid Margin="0,4,0,6">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextSubtle}"
                                Text="{DynamicResource UiSERVERS}" />
                            <Button
                                x:Name="BtnToggleServerArea"
                                HorizontalAlignment="Right"
                                Padding="8,3"
                                Click="BtnToggleServerArea_Click"
                                ToolTip="{DynamicResource ToggleServerArea}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,4,0" FontSize="11" Text="{DynamicResource UiChange}" />
                                    <materialDesign:PackIcon x:Name="IconToggleServerArea"  Kind="ChevronDown"  />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel x:Name="PanelServerArea" Visibility="Collapsed">

                        <Grid x:Name="ServerListGrid" tutorials:Tutorial.TargetId="Servers.ConnectionStatus">
                            <ListBox
                                x:Name="ListServers"
                                tutorials:Tutorial.TargetId="Servers.List"
                                MinHeight="60"
                                MaxHeight="100"
                                DisplayMemberPath="Name"
                                Foreground="White"
                                ItemsSource="{Binding Servers}"
                                SelectedItem="{Binding Selected, Mode=TwoWay}"
                                SelectionChanged="ListServers_SelectionChanged">

                                <ListBox.Resources>
                                    <conv:NotNullToBoolConverter x:Key="LocalNotNull" />
                                    <ContextMenu
                                        x:Key="ServerCtx"
                                        Foreground="White"
                                        Style="{StaticResource DarkContextMenu}">
                                        <MenuItem
                                            Click="Server_Delete_Click"
                                            Foreground="Black"
                                            Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Header>
                                                <TextBlock>
                                                    <Run Text="🗑️ " /><Run Text="{DynamicResource DeleteServerEllipsis}" />
                                                </TextBlock>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem
                                            Click="Server_CopyMap_Click"
                                            Foreground="Black"
                                            Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PlacementTarget.DataContext.LocalMapFilePath, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource LocalNotNull}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                            <MenuItem.Header>
                                                <TextBlock>
                                                    <Run Text="🗺️ " /><Run Text="{DynamicResource UiCopyMapToServer}" />
                                                </TextBlock>
                                            </MenuItem.Header>
