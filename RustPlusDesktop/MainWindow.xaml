                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Agriculture & Food -->
                                                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CategoryCard}" Margin="0,0,6,0">
                                                                <StackPanel>
                                                                    <TextBlock FontSize="14" Foreground="#9AA4B6" Margin="6,6,0,8">
    <Run Text="🌾" /><Run Text="{DynamicResource UiAgricultureFood}" FontSize="11" />
</TextBlock>
                                                                    <UniformGrid Columns="3">
