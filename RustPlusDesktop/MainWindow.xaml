                                                                        <Border x:Name="CheckBadge" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                                                Width="14" Height="14" CornerRadius="7" Background="#FF8A00"
                                                                                Margin="0,-3,-3,0" IsHitTestVisible="False" Opacity="0">
                                                                            <TextBlock Text="✓" FontSize="9" Foreground="White"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <!-- HOVER: glow + scale-up -->
                                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                                            <EventTrigger.Actions>
                                                                                <BeginStoryboard Name="HoverOn">
                                                                                    <Storyboard>
                                                                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0:0:0.15" />
                                                                                        <DoubleAnimation Storyboard.TargetName="IconContent" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.15" />
                                                                                        <DoubleAnimation Storyboard.TargetName="IconContent" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.15" />
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </EventTrigger.Actions>
                                                                        </EventTrigger>
                                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                                            <EventTrigger.Actions>
                                                                                <BeginStoryboard Name="HoverOff">
                                                                                    <Storyboard>
                                                                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                                                        <DoubleAnimation Storyboard.TargetName="IconContent" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.2" />
                                                                                        <DoubleAnimation Storyboard.TargetName="IconContent" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.2" />
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </EventTrigger.Actions>
                                                                        </EventTrigger>
                                                                        <!-- PRESSED: subtle scale down -->
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="IconContent" Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Trigger>
                                                                        <!-- DISABLED: dim -->
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter TargetName="IconContent" Property="Opacity" Value="0.35" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>

                                                    <!-- ════════════════════════════════════════════ -->
                                                    <!--  CATEGORY CARD CONTAINER                   -->
                                                    <!-- ════════════════════════════════════════════ -->
                                                    <Style x:Key="CategoryCard" TargetType="Border">
                                                        <Setter Property="Background" Value="#121824" />
                                                        <Setter Property="BorderBrush" Value="#22FFFFFF" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="CornerRadius" Value="10" />
                                                        <Setter Property="Padding" Value="8" />
                                                    </Style>

                                                    <!-- ════════════════════════════════════════════ -->
                                                    <!--  ACTIVE HEATMAP TITLE BADGE                -->
                                                    <!-- ════════════════════════════════════════════ -->
                                                    <Style x:Key="ActiveBadge" TargetType="Border">
                                                        <Setter Property="Padding" Value="8,4" />
                                                        <Setter Property="CornerRadius" Value="10" />
                                                        <Setter Property="Background" Value="#1422C55E" />
                                                        <Setter Property="BorderBrush" Value="#3322C55E" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Style>

                                                </materialDesign:Card.Resources>

                                                <!-- ════════════════════════════════════════════ -->
                                                <!--  MAIN LAYOUT                                -->
                                                <!-- ════════════════════════════════════════════ -->
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <!-- ── ROW 0: HEADER ── -->
                                                    <Grid Grid.Row="0" Margin="14,12,14,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Title area -->
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="◉" FontSize="14" Foreground="#FF8A00" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{DynamicResource UiProceduralHeatmaps}" FontSize="14" FontWeight="Bold" Foreground="#F2F2F2" />
                                                                <TextBlock Text="{DynamicResource UiSelectALayerToViewSpawnDensity}" FontSize="10" Foreground="#9AA4B6" Margin="0,1,0,0" />
                                                            </StackPanel>
                                                            <!-- Active heatmap indicator -->
                                                            <Border x:Name="ActiveHeatmapBadge" Grid.Column="2" Style="{StaticResource ActiveBadge}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                    <TextBlock x:Name="ActiveHeatmapLabel" Text="{DynamicResource UiNoHeatmapActive}" FontSize="10" Foreground="#9CA3AF" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Clear button -->
                                                        <Button Grid.Column="1" Padding="8,6" Tag="clear"
                                                                   Click="BtnHeatmapIcon_Click" Height="30" VerticalAlignment="Top">
