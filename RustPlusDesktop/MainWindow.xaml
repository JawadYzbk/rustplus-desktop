                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/Food/potato.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                        <Border x:Name="Bento_wheat" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="wheat" ToolTip="{DynamicResource UiWheat}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/Food/wheat.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                    </UniformGrid>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- ──── RIGHT COLUMN ──── -->

                                                            <!-- Loot & Transport -->
                                                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CategoryCard}" Margin="6,0,0,8">
                                                                <StackPanel>
                                                                    <TextBlock FontSize="14" Foreground="#9AA4B6" Margin="6,6,0,8">
    <Run Text="📦" /><Run Text="{DynamicResource UiLootTransport}" FontSize="11" />
</TextBlock>
                                                                    <UniformGrid Columns="3">
                                                                        <Border x:Name="Bento_junkpiles" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="junkpiles" ToolTip="{DynamicResource UiJunkpiles}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/loot-barrel-1.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                        <Border x:Name="Bento_rowboat" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="rowboat" ToolTip="{DynamicResource UiRowboats}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/rowboat.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                        <Border x:Name="Bento_modularcar" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="modularcar" ToolTip="{DynamicResource UiModularCars}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/modular-car.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                        <Border x:Name="Bento_horse" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="horse" ToolTip="{DynamicResource UiHorses}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/animals icons/horse.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                        <Border x:Name="Bento_pedalbike" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="pedalbike" ToolTip="{DynamicResource UiBicycles}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/bicycle.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                        <Border x:Name="Bento_hab" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="hab" ToolTip="{DynamicResource UiHotAirBalloons}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/hab.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                    </UniformGrid>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Fauna & Wildlife -->
                                                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CategoryCard}" Margin="6,0,0,0">
                                                                <StackPanel>
                                                                    <TextBlock FontSize="14" Foreground="#9AA4B6" Margin="6,6,0,8">
    <Run Text="🐾" /><Run Text="{DynamicResource UiFaunaWildlife}" FontSize="11" />
</TextBlock>
                                                                    <UniformGrid Columns="4">
                                                                        <Border x:Name="Bento_bear" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="bear" ToolTip="{DynamicResource UiBears}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/animals icons/bear.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                        <Border x:Name="Bento_boar" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="boar" ToolTip="{DynamicResource UiBoars}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/animals icons/boar.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                        <Border x:Name="Bento_chicken" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="chicken" ToolTip="{DynamicResource UiChickens}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/animals icons/chicken.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                        <Border x:Name="Bento_wolf" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="wolf" ToolTip="{DynamicResource UiWolves}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/animals icons/wolf.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                        <Border x:Name="Bento_stag" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="stag" ToolTip="{DynamicResource UiDeers}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/animals icons/stag.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                        <Border x:Name="Bento_crocodile" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="crocodile" ToolTip="{DynamicResource UiCrocodiles}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/animals icons/crocodile.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                        <Border x:Name="Bento_tiger" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="tiger" ToolTip="{DynamicResource UiTigers}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/animals icons/tiger.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                        <Border x:Name="Bento_snake" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="snake" ToolTip="{DynamicResource UiSnakes}" Style="{StaticResource HeatmapTileButton}"
                                                                                    Click="BtnHeatmapIcon_Click">
                                                                                <Image Source="pack://application:,,,/Assets/heatmap icons/animals icons/snake.png" Stretch="Uniform"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            </Button>
                                                                        </Border>
                                                                    </UniformGrid>
                                                                </StackPanel>
                                                            </Border>

                                                        </Grid>
                                                    </ScrollViewer>
                                                </Grid>
                                            </materialDesign:Card>
                                        </Popup>

                                    </WrapPanel>
                                </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!--  SUBSCRIPTION DOCK  -->
                                <materialDesign:Card
                                    x:Name="SubscriptionDock"
                                    Margin="0,6,0,0"
                                    Padding="6"
                                    Background="#AA16181C"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Vertical">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="SubscriptionStack" Orientation="Vertical" />
                                        </ScrollViewer><Button
                                            x:Name="DockEditSubscriptionsButton"
                                            Margin="0,4,0,0"
                                            Padding="4"
                                            Width="36"
                                            Height="36"
                                            HorizontalAlignment="Center"
                                            Click="DockEditSubscriptionsButton_Click"
                                            ToolTip="{DynamicResource UiEditSubscriptionsDrawingOverlay}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=SubscriptionDock}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <materialDesign:PackIcon  Kind="Pencil" Foreground="White" FontSize="18"  />
                                        </Button>
                                    </StackPanel>
                                </materialDesign:Card>
                            </StackPanel>

                            <materialDesign:Card
                                x:Name="FollowOverlay"
                                Margin="8,0,0,0"
                                Padding="0"
                                Height="38"
                                Background="#AA16181C"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Top">
                                <Grid>
                                    <!--  Active Glow  -->
                                    <Ellipse
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Fill="#4000C8FF">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="15" />
                                        </Ellipse.Effect>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFollowing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <Button
                                        x:Name="BtnFollowPlayer"
                                        Height="36"
                                        Padding="4,0"
                                        Click="BtnFollowPlayer_Click"
                                        IsEnabled="{Binding Selected.IsFullConnected, FallbackValue=False}"
                                        ToolTip="{DynamicResource FollowPlayer}">
                                        <StackPanel Orientation="Horizontal">
                                            <!--  Avatar or Default Icon  -->
                                            <Grid Width="24" Height="24">
                                                <!--  Default Icon (Placeholder)  -->
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="14"
                                                    Foreground="#8D98A8"
                                                    Text="&#xE77B;">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFollowing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!--  Real Avatar  -->
                                                <Image
                                                    Width="24"
                                                    Height="24"
                                                    ClipToBounds="True"
                                                    Source="{Binding FollowingPlayerAvatar}"
                                                    Stretch="UniformToFill"
                                                    RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Clip>
                                                        <EllipseGeometry
                                                            Center="12,12"
                                                            RadiusX="12"
                                                            RadiusY="12" />
                                                    </Image.Clip>
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFollowing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect
                                                                                BlurRadius="8"
                                                                                Opacity="0.8"
                                                                                ShadowDepth="0"
                                                                                Color="Cyan" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>

                                                <!--  Active Icon Overlay (small dot or similar if needed)  -->
                                            </Grid>

                                            <TextBlock
                                                x:Name="IconFollow"
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="10"
                                                Foreground="#8D98A8"
                                                Text="&#xE70D;" />
                                        </StackPanel>
                                        <Button.ContextMenu>
                                            <ContextMenu x:Name="MenuFollowPlayer">
                                                <!--  Dynamically filled  -->
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </materialDesign:Card>

                            <materialDesign:Card
                                x:Name="MonumentsToggleOverlay"
                                Margin="8,0,0,0"
                                Padding="0"
                                Height="38"
                                Background="#AA16181C"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Top">
                                <Grid>
                                    <Button
                                        x:Name="BtnToggleMonumentsPanel"
                                        Height="36"
                                        Padding="4,0"
                                        Click="BtnToggleMonumentsPanel_Click"
                                        IsEnabled="{Binding Selected.IsFullConnected, FallbackValue=False}"
                                        ToolTip="{DynamicResource UiToggleMonumentList}">
                                        <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="14"
                                                Foreground="#8D98A8"
                                                Text="&#xE707;" 
                                                VerticalAlignment="Center"/>
                                            <TextBlock
                                                Text="{DynamicResource Monuments}"
                                                Margin="6,0,4,0"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </materialDesign:Card>
                            
                            <materialDesign:Card
                                x:Name="WipeDeathMarkersOverlay"
                                Margin="8,0,0,0"
                                Padding="0"
                                Height="38"
                                Background="#AA16181C"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Top"
                                Visibility="Collapsed">
                                <Grid>
                                    <Button
                                        x:Name="BtnWipeDeathMarkers"
                                        Height="36"
                                        Padding="4,0"
                                        Click="BtnWipeDeathMarkers_Click"
                                        ToolTip="{DynamicResource WipeDeathMarkers}">
                                        <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                                            <Grid Width="14" Height="16" Margin="0,0,4,0">
                                                <Path Width="14" Height="16" Data="M20,0 C31,0 40,9 40,20 C40,33 20,56 20,56 C20,56 0,33 0,20 C0,9 9,0 20,0 Z" Fill="IndianRed" Stretch="Uniform" Stroke="Black" StrokeThickness="1" />
                                            </Grid>
                                            <materialDesign:PackIcon  Kind="Delete" Foreground="IndianRed" FontSize="14"  />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </materialDesign:Card>
                        </StackPanel>


                        <!--  LIVE EVENT DOCK & TIMER DOCK (Top Right)  -->
                        <StackPanel
                            Margin="15,45,15,15"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Panel.ZIndex="100"
                            Orientation="Vertical">
                            
                            <StackPanel
                                x:Name="EventDock"
                                tutorials:Tutorial.TargetId="Events.Dock"
                                Orientation="Vertical" />
                            
                            <Button
                                x:Name="BtnCustomTimer"
                                tutorials:Tutorial.TargetId="Events.Timer"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0"
                                Padding="8"
                                Background="#AA16181C"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                Click="BtnCustomTimer_Click"
                                ToolTip="{DynamicResource HoverCustomTimer}">
                                <materialDesign:PackIcon x:Name="IconCustomTimer"  Kind="Timer" FontSize="20" Foreground="{DynamicResource TextPrimary}"  />
                            </Button>
                            
                            <Popup x:Name="PopupCustomTimer" AllowsTransparency="True" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnCustomTimer}" Placement="Left" HorizontalOffset="-10">
                                <materialDesign:Card Margin="0,0,10,10" Padding="16" MinWidth="320" MaxWidth="360" Background="#AA16181C" BorderBrush="#40FFFFFF" BorderThickness="1">
                                    <materialDesign:Card.Resources>
                                        <Style x:Key="MaterialIconToggleStyle" TargetType="ToggleButton">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            <Setter Property="Background" Value="#12FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#16FFFFFF"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Width" Value="32"/>
                                            <Setter Property="Height" Value="32"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Bd"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="5">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#40FFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsChecked" Value="True"/>
                                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="Bd" Property="Background" Value="#80CDFF"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#80CDFF"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                            </MultiTrigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </materialDesign:Card.Resources>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ActiveTimersCategory}" FontWeight="SemiBold" Margin="0,0,0,12" FontSize="13" />
                                        
                                        <!-- List of active timers -->
                                        <ItemsControl x:Name="ListActiveTimers">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="4,0,8,0">
                                                            <Run Text="{Binding Name}" />
                                                            <Run Text=" (" Foreground="{DynamicResource TextSubtle}" FontSize="11" />
                                                            <Run Text="{Binding PlacementTarget.DataContext.Selected.ChatCommandPrefix, RelativeSource={RelativeSource AncestorType=Popup}}" Foreground="{DynamicResource TextSubtle}" FontSize="11" />
                                                            <Run Text="{Binding Command}" Foreground="{DynamicResource TextSubtle}" FontSize="11" />
                                                            <Run Text=")" Foreground="{DynamicResource TextSubtle}" FontSize="11" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" Text="{Binding RemainingTimeText}" VerticalAlignment="Center" Margin="0,0,12,0" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <ToggleButton IsChecked="{Binding EnableCountdownAudio}" Style="{StaticResource MaterialIconToggleStyle}" ToolTip="{DynamicResource UiPlay1minCountdownAudio}">
                                                                <materialDesign:PackIcon  Kind="Hourglass" FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"  />
                                                            </ToggleButton>
                                                            <ToggleButton IsChecked="{Binding EnableAlarmAudio}" Style="{StaticResource MaterialIconToggleStyle}" ToolTip="{DynamicResource UiPlayLoudAlarmAt0000}">
                                                                <materialDesign:PackIcon  Kind="Alert" FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"  />
                                                            </ToggleButton>
                                                            <Button Width="32" Height="32" Padding="0" Tag="{Binding Id}" Click="BtnDeleteTimer_Click" ToolTip="{DynamicResource UiDeleteTimer}">
                                                                <materialDesign:PackIcon  Kind="Close" Foreground="IndianRed" FontSize="14"  />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Add Timer Section -->
                                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeDefault}" Margin="0,8,0,12" Padding="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource AddTimer}" FontWeight="SemiBold" Margin="0,0,0,12" FontSize="13" />
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TxtTimerName" TextChanged="TxtTimerName_TextChanged" Height="32" Padding="8,4" VerticalContentAlignment="Center" materialDesign:HintAssist.Hint="{DynamicResource TimerName}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBox x:Name="TxtTimerHours" MaxLength="2" Width="42" Height="32" Padding="0,4" TextAlignment="Center" VerticalContentAlignment="Center" materialDesign:HintAssist.Hint="hh" />
                                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0,2,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSubtle}" />
                                                        <TextBox x:Name="TxtTimerMinutes" MaxLength="2" Width="42" Height="32" Padding="0,4" TextAlignment="Center" VerticalContentAlignment="Center" materialDesign:HintAssist.Hint="mm" />
                                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0,2,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSubtle}" />
                                                        <TextBox x:Name="TxtTimerSeconds" MaxLength="2" Width="42" Height="32" Padding="0,4" TextAlignment="Center" VerticalContentAlignment="Center" materialDesign:HintAssist.Hint="ss" />
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <TextBlock x:Name="TxtTimerValidation" Foreground="IndianRed" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                                <Trigger Property="Text" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding PlacementTarget.DataContext.Selected.ChatCommandPrefix, RelativeSource={RelativeSource AncestorType=Popup}}" Foreground="{DynamicResource TextSubtle}" FontWeight="Bold" Margin="0,0,2,0" />
                                                        <TextBlock x:Name="TxtTimerCommandPreview" Text="" Foreground="{DynamicResource TextSubtle}" />
                                                    </StackPanel>
                                                    
                                                    <ToggleButton x:Name="TglAddTimerCountdown" Grid.Column="1" IsChecked="True" Style="{StaticResource MaterialIconToggleStyle}" ToolTip="{DynamicResource UiPlay1minCountdownAudio}">
                                                        <materialDesign:PackIcon  Kind="Hourglass" FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"  />
                                                    </ToggleButton>
                                                    <ToggleButton x:Name="TglAddTimerAlarm" Grid.Column="2" IsChecked="False" Style="{StaticResource MaterialIconToggleStyle}" ToolTip="{DynamicResource UiPlayLoudAlarmAt0000}" Margin="0,0,10,0">
                                                        <materialDesign:PackIcon  Kind="Alert" FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"  />
                                                    </ToggleButton>

                                                    <Button Grid.Column="3" x:Name="BtnAddTimer" Content="{DynamicResource AddTimer}" Padding="14,6" Height="32" Click="BtnAddTimer_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Timer Alarm Controls -->
                                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeDefault}" Margin="0,8,0,0" Padding="0,12,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="BtnStopTimerAlarm" Visibility="Collapsed" Padding="12,6" Margin="0,0,6,0" Height="32" Click="BtnStopTimerAlarm_Click" ToolTip="{DynamicResource UiStopAlarmSound}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon  Kind="VolumeOff" Foreground="IndianRed" FontSize="16"  />
                                                            <TextBlock Text="{DynamicResource Stop}" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="IndianRed" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Name="BtnSnoozeTimerAlarm" Grid.Column="1" Visibility="Collapsed" Padding="12,6" Margin="0,0,6,0" Height="32" Click="BtnSnoozeTimerAlarm_Click" ToolTip="{DynamicResource UiSnoozeAlarm}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon  Kind="Alarm" Foreground="#FFA500" FontSize="16"  />
                                                            <TextBlock Text="{DynamicResource UiSnooze}" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#FFA500" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>
                                                    
                                                    <!-- Spacer Column (Column 2) -->
                                                    
                                                    <Button Grid.Column="3" Padding="8,6" Margin="0,0,6,0" Height="32" Click="BtnSelectTimerCountdownAudio_Click" ToolTip="{DynamicResource UiSelectCustom1MinuteCountdownSound}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <materialDesign:PackIcon  Kind="Hourglass" FontSize="16"  />
                                                            <TextBlock Text="1min" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="4" Padding="8,6" Margin="0,0,6,0" Height="32" Width="32" Click="BtnSelectTimerAlarmAudio_Click" ToolTip="{DynamicResource UiSelectCustomAlarmSound0000}">
                                                        <materialDesign:PackIcon  Kind="MusicNote" FontSize="16"  />
                                                    </Button>
                                                    <Button Grid.Column="5" Padding="8,6" Height="32" Width="32" Click="BtnResetTimerAlarmAudio_Click" ToolTip="{DynamicResource UiResetSoundsToDefault}">
                                                        <materialDesign:PackIcon  Kind="Refresh" FontSize="16"  />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </materialDesign:Card>
                            </Popup>
                        </StackPanel>

                        <Canvas x:Name="GridLayer" IsHitTestVisible="False" />
                        <Canvas x:Name="Overlay" IsHitTestVisible="True" />

                        <!-- Monument Navigation Panel -->
                        <Border
                            x:Name="MonumentNavPanel"
                            Width="280"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Margin="15,70,0,15"
                            Panel.ZIndex="1050"
                            Background="#E5101217"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="0"
                            CornerRadius="12"
                            Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="15"
                                    Opacity="0.6"
                                    ShadowDepth="0"
                                    Color="Black" />
                            </Border.Effect>
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                
                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock
                                        Text="{DynamicResource Monuments}"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        VerticalAlignment="Center"/>
                                    <Button
                                        x:Name="BtnCloseMonumentNav"
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Right"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Style="{StaticResource GhostButton}"
                                        Click="BtnToggleMonumentsPanel_Click"
                                        Content="&#x2715;"
                                        Foreground="#8D98A8"
                                        FontSize="12"/>
                                </Grid>
                                
                                <!-- Search Box -->
                                <TextBox
                                    x:Name="TxtMonumentSearch"
                                    Grid.Row="1"
                                    Margin="0,0,0,10"
                                    TextChanged="TxtMonumentSearch_TextChanged" materialDesign:HintAssist.Hint="{DynamicResource UiSearchMonument}" />
                                    
                                <!-- Monument List -->
                                <ScrollViewer
                                    Grid.Row="2"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="MonumentListContainer" />
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!--  Shop Details Panel (Clamped to Map Container)  -->
                        <Border
                            x:Name="ShopDetailsPopup"
                            Width="340"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Panel.ZIndex="1100"
                            Background="#1E2126"
                            BorderBrush="#60FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="15"
                                    Opacity="0.6"
                                    ShadowDepth="0"
                                    Color="Black" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Button
                                    x:Name="BtnCloseShopDetails"
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    Panel.ZIndex="10"
                                    Click="BtnCloseShopDetails_Click"
                                    Content="&#x2715;"
                                    FontSize="14"
                                    Foreground="Gray"
                                    Style="{StaticResource GhostButton}" />

                                <ScrollViewer
                                    x:Name="ShopDetailsScroll"
                                    Grid.Row="1"
                                    MaxHeight="600"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ShopDetailsContent" Margin="12,4,12,12" />
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Base Hover Preview Popup -->
                        <Border
                            x:Name="BaseHoverPopup"
                            Width="260"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Panel.ZIndex="1100"
                            Background="#1A1D21"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Collapsed"
                            MouseEnter="BaseHoverPopup_MouseEnter"
                            MouseLeave="BaseHoverPopup_MouseLeave">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Opacity="0.5" ShadowDepth="0" Color="Black"/>
                            </Border.Effect>
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <Button
                                    x:Name="BtnCloseBaseHover"
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="BtnCloseBaseHover_Click"
                                    Content="&#x00D7;"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="Gray"
                                    Style="{StaticResource GhostButton}" />

                                <StackPanel Grid.Row="0" Margin="0,0,24,0">
                                    <TextBlock x:Name="TxtBaseHoverNote"
                                               Foreground="White"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               MaxHeight="60"/>
                                </StackPanel>

                                <Border Grid.Row="1" x:Name="BorderBaseHoverImage" Margin="0,8,0,0" CornerRadius="6" ClipToBounds="True" Background="#10FFFFFF" Visibility="Collapsed">
                                    <Image x:Name="ImgBaseHoverScreenshot" Stretch="Uniform" MaxHeight="150"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Base Detailed Gallery Popup -->
                        <Border
                            x:Name="BaseGalleryPopup"
                            Width="540"
                            Height="480"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Panel.ZIndex="1200"
                            Background="#1A1D21"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            CornerRadius="14"
                            Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Opacity="0.7" ShadowDepth="0" Color="Black"/>
                            </Border.Effect>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Title / Close -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="{DynamicResource UiBaseDetails}" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    <Button
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Right"
                                        Click="BtnCloseBaseGallery_Click"
                                        Content="&#x00D7;"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="Gray"
                                        Style="{StaticResource GhostButton}" />
                                </DockPanel>

                                <!-- Mid Panel (Gallery & Active Image Zoom Container) -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <!-- Thumbnail Strip (left) -->
                                        <ColumnDefinition Width="70"/>
                                        <!-- Main Image View (right) -->
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnails List -->
                                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,6,0">
                                        <StackPanel x:Name="BaseGalleryThumbsPanel" Orientation="Vertical"/>
                                    </ScrollViewer>

                                    <!-- Main Image Zoom Area -->
                                    <Grid Grid.Column="1" x:Name="BaseGalleryMainImageArea" Background="#0C0D0F" ClipToBounds="True"
                                          MouseMove="MainImage_MouseMove" MouseLeave="MainImage_MouseLeave" MouseEnter="MainImage_MouseEnter">
                                        <Image x:Name="ImgBaseGalleryMain" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        
                                        <!-- Loupe Magnifying circular Border (lens) -->
                                        <Canvas IsHitTestVisible="False">
                                            <Border x:Name="BaseGalleryMagnifierLens" Width="150" Height="150" CornerRadius="75" BorderBrush="White" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <VisualBrush x:Name="BaseGalleryMagnifierBrush" Visual="{Binding ElementName=ImgBaseGalleryMain}" ViewboxUnits="Absolute" ViewportUnits="RelativeToBoundingBox" Viewport="0,0,1,1"/>
                                                </Border.Background>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="8" Opacity="0.5" ShadowDepth="0" Color="Black"/>
                                                </Border.Effect>
                                            </Border>
                                        </Canvas>

                                        <!-- Placeholder when no screenshots exist -->
                                        <StackPanel x:Name="BaseGalleryNoImagePlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                            <materialDesign:PackIcon  Kind="Camera" FontSize="36" Foreground="Gray" Margin="0,0,0,8" />
                                            <TextBlock Text="{DynamicResource BaseNoScreenshotsYet}" Foreground="Gray" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Bottom Note Area -->
                                <Border Grid.Row="2" Margin="0,12,0,0" Padding="10" Background="#121417" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8">
                                    <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock x:Name="TxtBaseGalleryNote" Foreground="White" FontSize="13" TextWrapping="Wrap" LineHeight="18"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="ShopSearchPanel"
                            Width="450"
                            Margin="0,0,12,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Panel.ZIndex="1000"
                            Background="Transparent">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    x:Name="ShopSearchContent"
                                    tutorials:Tutorial.TargetId="Shops.Panel"
                                    Grid.Row="0"
                                    Panel.ZIndex="5"
                                    Height="540"
                                    Background="#D916181C"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    RenderTransformOrigin="0.5,1"
                                    Visibility="Collapsed"
                                    UseLayoutRounding="True"
                                    SnapsToDevicePixels="True"
                                    RenderOptions.ClearTypeHint="Enabled">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.55" Color="#000000" />
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="ShopSearchScale" ScaleY="1" />
                                            <TranslateTransform x:Name="ShopSearchTranslate" Y="0" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!--  Header / Drag / Close Area  -->
                                        <Border Grid.Row="0" Background="#401E2126" CornerRadius="12,12,0,0" BorderThickness="0,0,0,1" BorderBrush="#15FFFFFF">
                                            <Grid>
                                                <StackPanel Margin="12,0,0,0" Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center" FontSize="11" Text="&#x1F6D2; " />
                                                    <TextBlock
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="#80FFFFFF"
                                                        Text="{DynamicResource ShopSearchTitle}" />
                                                </StackPanel>
                                                <Button
                                                    x:Name="BtnCloseShopSearch"
                                                    Width="26"
                                                    Height="26"
                                                    Margin="0,0,4,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Click="BtnCloseShopSearch_Click"
                                                    Content="&#x2715;"
                                                    Cursor="Hand"
                                                    FontSize="12"
                                                    Foreground="#99FFFFFF"
                                                    Style="{StaticResource GhostButton}"
                                                    ToolTip="{DynamicResource UiCloseShopsPanel}"
                                                    AutomationProperties.Name="{DynamicResource UiCloseShopsPanel}">
                                                    <Button.Resources>
                                                        <Style BasedOn="{StaticResource GhostButton}" TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                    <Setter Property="Background" Value="#20FFFFFF" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Row="1">
                                            <views:ShopSearchControl 
                                                x:Name="EmbeddedShopSearch"
                                                UseLayoutRounding="True"
                                                SnapsToDevicePixels="True"
                                                RenderOptions.ClearTypeHint="Enabled" />

                                            <Grid x:Name="ShopSearchWarning" Background="#F216181C" Visibility="Collapsed">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Margin="0,0,0,20"
                                                        HorizontalAlignment="Center"
                                                        FontSize="14"
                                                        Foreground="#CCFFFFFF"
                                                        Text="{DynamicResource ActivateShopsFirst}" />
                                                    <Button
                                                        x:Name="BtnActivateShopPolling"
                                                        Padding="20,8"
                                                        Click="BtnActivateShopPolling_Click"
                                                        Content="{DynamicResource ActivateShopPolling}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Style="{StaticResource DonateButton}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border
                                    x:Name="BtnShopToggleBorder"
                                    Grid.Row="1"
                                    Width="160"
                                    Height="26"
                                    HorizontalAlignment="Right"
                                    Background="#16181C"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="8,8,0,0">
                                    <Button
                                        x:Name="BtnShopToggle"
                                        tutorials:Tutorial.TargetId="Shops.Open"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="BtnShopSearch_Click"
                                        ToolTip="{DynamicResource UiOpenOrCloseShopsPanelCtrlShiftS}"
                                        AutomationProperties.Name="{DynamicResource UiOpenOrCloseShopsPanel}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8,8,0,0">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#30FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Text="&#xE721;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="{DynamicResource Shops}" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>

                        <!--  Integrated Chat Overlay (Roll-up)  -->
                        <Border
                            x:Name="ChatOverlayPanel"
                            Width="450"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Panel.ZIndex="1000"
                            Background="Transparent">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    x:Name="ChatContentBorder"
                                    Grid.Row="0"
                                    Height="420"
                                    Background="#14171C"
                                    BorderBrush="#1F242E"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    RenderTransformOrigin="0.5,1"
                                    Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="ChatScale" ScaleY="1" />
                                            <TranslateTransform x:Name="ChatTranslate" Y="0" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="38" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  Header / Drag / Close Area  -->
                                        <Grid Grid.Row="0" Background="#1B1E24">
                                            <Grid.Resources>
                                                <Style x:Key="ChatTabPillStyle" TargetType="RadioButton">
                                                    <Setter Property="Padding" Value="9,4" />
                                                    <Setter Property="FontSize" Value="10" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="RadioButton">
                                                                <Border
                                                                    x:Name="PillBorder"
                                                                    Background="Transparent"
                                                                    CornerRadius="10"
                                                                    Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="PillBorder" Property="Background" Value="#26FFFFFF" />
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="PillBorder" Property="Background" Value="#16FFFFFF" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Grid.Resources>
                                            <StackPanel Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon  Kind="Chat" Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource Accent}"  />
                                                <RadioButton
                                                    x:Name="TabTeamChat"
                                                    GroupName="ChatTabsGroup"
                                                    IsChecked="True"
                                                    Tag="Team"
                                                    Style="{StaticResource ChatTabPillStyle}"
                                                    Checked="ChatTab_Checked"
                                                    Content="{DynamicResource TeamChatTitle}" />
                                                <RadioButton
                                                    x:Name="TabClanChat"
                                                    GroupName="ChatTabsGroup"
                                                    Margin="4,0,0,0"
                                                    Tag="Clan"
                                                    Style="{StaticResource ChatTabPillStyle}"
                                                    Checked="ChatTab_Checked"
                                                    Content="{DynamicResource ClanChatTitle}" />
                                            </StackPanel>
                                            <Button
                                                x:Name="BtnCloseChatOverlay"
                                                Width="28"
                                                Height="28"
                                                Margin="0,0,6,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Click="BtnCloseChatOverlay_Click"
                                                Foreground="{DynamicResource TextSubtle}"
                                                ToolTip="{DynamicResource UiCloseTeamPanel}"
                                                AutomationProperties.Name="{DynamicResource UiCloseTeamPanel}"
                                                Padding="0" />
                                        </Grid>

                                        <!--  Chat-History  -->
                                        <ListBox
                                            x:Name="ChatList"
                                            tutorials:Tutorial.TargetId="Chat.History"
                                            Grid.Row="1"
                                            ScrollViewer.ScrollChanged="ChatScrollViewer_ScrollChanged"
                                            PreviewMouseWheel="ChatList_PreviewMouseWheel"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ItemsSource="{Binding ChatMessages, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            Padding="4,8">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2">
                                                        <!--  Day Separator  -->
                                                        <Border
                                                            Margin="0,8"
                                                            Padding="10,4"
                                                            HorizontalAlignment="Center"
                                                            Background="#1B1E24"
                                                            BorderBrush="#10FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock
                                                                FontSize="10"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource TextSubtle}"
                                                                Text="{Binding SeparatorText}" />
                                                        </Border>

                                                        <!--  Message Bubble Grid  -->
                                                        <Grid x:Name="MsgGrid" Margin="6,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Column 0: Left Avatar (for Me) -->
                                                            <Border x:Name="LeftAvatarBorder" Grid.Column="0" Width="26" Height="26" Margin="0,0,8,0" CornerRadius="13" ClipToBounds="True" Background="#2B303C" VerticalAlignment="Top" Visibility="Visible">
                                                                <Grid>
                                                                    <materialDesign:PackIcon  Kind="Account" FontSize="14" Foreground="{DynamicResource TextSubtle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                </Grid>
                                                            </Border>

                                                            <!-- Column 1: Bubble Content -->
                                                            <StackPanel Grid.Column="1" x:Name="BubbleStack" VerticalAlignment="Top">
                                                                <!-- Sender Name & Time Metadata -->
                                                                <StackPanel x:Name="MetaStack" Orientation="Horizontal" Margin="4,0,4,2">
                                                                    <TextBlock x:Name="SenderText" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Accent}" Text="{Binding Author}" />
                                                                    <TextBlock x:Name="TimeText" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="9" Foreground="{DynamicResource TextSubtle}" Text="{Binding Timestamp, StringFormat=HH:mm}" />
                                                                </StackPanel>

                                                                <!-- Actual Message Bubble -->
                                                                <Border x:Name="MsgBubble" Padding="10,6" CornerRadius="12,12,12,2" BorderThickness="1" Background="#22252C" BorderBrush="#323846" HorizontalAlignment="Left">
                                                                    <TextBlock Foreground="{DynamicResource TextPrimary}" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" LineHeight="16"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Column 2: Right Avatar (for Teammates) -->
                                                            <Border x:Name="RightAvatarBorder" Grid.Column="2" Width="26" Height="26" Margin="8,0,0,0" CornerRadius="13" ClipToBounds="True" Background="#2B303C" VerticalAlignment="Top" Visibility="Collapsed">
                                                                <Grid>
                                                                    <materialDesign:PackIcon  Kind="Account" FontSize="14" Foreground="{DynamicResource TextSubtle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Triggers to shift layout to Left vs Right based on IsMe -->
                                                    <DataTemplate.Triggers>
                                                        <!-- ME: Left Sided -->
                                                        <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                            <Setter TargetName="LeftAvatarBorder" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="RightAvatarBorder" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="BubbleStack" Property="HorizontalAlignment" Value="Left" />
                                                            <Setter TargetName="MetaStack" Property="HorizontalAlignment" Value="Left" />
                                                            <Setter TargetName="MsgBubble" Property="HorizontalAlignment" Value="Left" />
                                                            <Setter TargetName="MsgBubble" Property="Background" Value="#22252C" />
                                                            <Setter TargetName="MsgBubble" Property="BorderBrush" Value="#323846" />
                                                            <Setter TargetName="MsgBubble" Property="CornerRadius" Value="12,12,12,2" />
                                                            <Setter TargetName="SenderText" Property="Foreground" Value="{DynamicResource Accent}" />
                                                        </DataTrigger>
                                                        
                                                        <!-- TEAMMATE: Right Sided -->
                                                        <DataTrigger Binding="{Binding IsMe}" Value="False">
                                                            <Setter TargetName="LeftAvatarBorder" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="RightAvatarBorder" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="BubbleStack" Property="HorizontalAlignment" Value="Right" />
                                                            <Setter TargetName="MetaStack" Property="HorizontalAlignment" Value="Right" />
                                                            <Setter TargetName="MetaStack" Property="FlowDirection" Value="RightToLeft" />
                                                            <Setter TargetName="MsgBubble" Property="HorizontalAlignment" Value="Right" />
                                                            <Setter TargetName="MsgBubble" Property="Background" Value="#1A4D6B" />
                                                            <Setter TargetName="MsgBubble" Property="BorderBrush" Value="#2C6B91" />
                                                            <Setter TargetName="MsgBubble" Property="CornerRadius" Value="12,12,2,12" />
                                                            <Setter TargetName="SenderText" Property="Foreground" Value="#60CDFF" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>

                                        <!--  Input-Bar  -->
                                        <StackPanel
                                            Grid.Row="2"
                                            Margin="0"
                                            Background="#111317">
                                            <!--  Inline Error Box  -->
                                            <Border
                                                x:Name="ChatErrorBox"
                                                Margin="12,8,12,0"
                                                Padding="8"
                                                Background="#33FF0000"
                                                BorderBrush="Red"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Visibility="Collapsed">
                                                <TextBlock
                                                    x:Name="ChatErrorText"
                                                    FontSize="11"
                                                    Foreground="White"
                                                    Text="{DynamicResource ChatErrorPlaceholder}"
                                                    TextWrapping="Wrap" />
                                            </Border>

                                            <DockPanel Margin="12,10,12,4">
                                                <Button
                                                    x:Name="BtnSendChat"
                                                    tutorials:Tutorial.TargetId="Chat.Send"
                                                    Width="Auto"
                                                    Padding="12,0"
                                                    Height="36"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Bottom"
                                                    DockPanel.Dock="Right"
                                                    Click="BtnSendChat_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Send" VerticalAlignment="Center" /><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" Content="{DynamicResource Send}" /></StackPanel></Button>

                                                <TextBox
                                                    x:Name="TxtChatInput"
                                                    tutorials:Tutorial.TargetId="Chat.Input"
                                                    VerticalContentAlignment="Center"
                                                    KeyDown="TxtChatInput_KeyDown"
                                                    MaxLength="128"
                                                    MaxLines="1" materialDesign:HintAssist.Hint="{DynamicResource ChatMessagePlaceholder}" />
                                            </DockPanel>

                                            <Button
                                                x:Name="BtnOpenChatCommands"
                                                tutorials:Tutorial.TargetId="Chat.Commands"
                                                Margin="12,0,0,8"
                                                Padding="6,4"
                                                HorizontalAlignment="Left"
                                                Click="BtnOpenChatCommands_Click"
                                                ToolTip="{DynamicResource ChatCommandsSettings}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon  Kind="Cog" Margin="0,0,6,0" FontSize="14" Foreground="{DynamicResource TextSubtle}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource TextSubtle}"
                                                        Text="{DynamicResource ChatCommands}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                    </Grid>
                                </Border>

                                <Border
                                    x:Name="BtnChatToggleBorder"
                                    Grid.Row="1"
                                    Width="160"
                                    Height="26"
                                    HorizontalAlignment="Left"
                                    Background="#16181C"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="8,8,0,0">
                                    <Button
                                        x:Name="BtnChatToggle"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="BtnToggleChat_Click"
                                        ToolTip="{DynamicResource UiOpenOrCloseTeamPanelCtrlShiftT}"
                                        AutomationProperties.Name="{DynamicResource UiOpenOrCloseTeamPanel}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8,8,0,0">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#30FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Text="&#xE8F2;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="{DynamicResource TeamTab}" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>

                                                <Border
                            x:Name="OverlayToolbox"
                            Grid.Row="1"
                            Margin="8"
                            Padding="8,6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Panel.ZIndex="9000"
                            Background="#CC1E1E1E"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!--  Zeichnen  -->
                                    <Button
                                        x:Name="ToolDrawButton"
                                        tutorials:Tutorial.TargetId="Map.Drawing"
                                        Width="32"
                                        Height="32"
                                        Margin="2,0"
                                        Click="ToolDrawButton_Click"
                                        ToolTip="{DynamicResource DrawToolTip}">
                                        <Image Source="pack://application:,,,/Assets/icons/pen.png" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Button>

                                    <!--  Text  -->
                                    <Button
                                        x:Name="ToolTextButton"
                                        Width="32"
                                        Height="32"
                                        Margin="2,0"
                                        Click="ToolTextButton_Click"
                                        ToolTip="{DynamicResource PlaceTextToolTip}">
                                        <Image Source="pack://application:,,,/Assets/icons/text.png" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Button>

                                    <!--  Icons  -->
                                    <Button
                                        x:Name="ToolIconButton"
                                        Width="32"
                                        Height="32"
                                        Margin="2,0"
                                        Click="ToolIconButton_Click"
                                        ToolTip="{DynamicResource PlaceIconToolTip}">
                                        <Image Source="pack://application:,,,/Assets/icons/pin.png" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Button>

                                    <!--  Radierer  -->
                                    <Button
                                        x:Name="ToolEraseButton"
                                        Width="32"
                                        Height="32"
                                        Margin="2,0"
                                        Click="ToolEraseButton_Click"
                                        ToolTip="{DynamicResource EraserToolTip}">
                                        <Image Source="pack://application:,,,/Assets/icons/eraser.png" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Button>

                                    <Rectangle Width="1" Height="20" Margin="6,0" Fill="#40FFFFFF" VerticalAlignment="Center" />

                                    <!--  LÃƒÂ¶schen  -->
                                    <Button
                                        x:Name="ToolTrashButton"
                                        Width="32"
                                        Height="32"
                                        Margin="2,0"
                                        Click="ToolTrashButton_Click"
                                        ToolTip="{DynamicResource DeleteOverlayToolTip}">
                                        <Image Source="pack://application:,,,/Assets/icons/trash.png" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Button>

                                    <Button
                                        x:Name="ToolUploadButton"
                                        Width="32"
                                        Height="32"
                                        Margin="2,0"
                                        Click="ToolUploadButton_Click"
                                        ToolTip="{DynamicResource UploadOverlayToolTip}">
                                        <materialDesign:PackIcon  Kind="Cloud" Foreground="White" FontSize="18"  />
                                    </Button>

                                    <!--  Manual Refresh  -->
                                    <Button
                                        x:Name="ToolRefreshOverlayButton"
                                        Width="32"
                                        Height="32"
                                        Margin="2,0"
                                        Click="ToolRefreshOverlayButton_Click"
                                        ToolTip="{DynamicResource UiForceRefreshAllSubscriptions}">
                                        <materialDesign:PackIcon  Kind="Undo" Foreground="White" FontSize="18"  />
                                    </Button>

                                    <Button
                                        x:Name="BtnPremiumInfoMap"
                                        Width="32"
                                        Height="32"
                                        Margin="2,0"
                                        Foreground="#e03131"
                                        Visibility="Collapsed"
                                        Click="BtnPremiumInfoMap_Click"
                                        ToolTip="{DynamicResource PremiumFeatures}" />

                                    <Button
                                        x:Name="BtnAdminPanel"
                                        Width="32"
                                        Height="32"
                                        Margin="2,0"
                                        Visibility="Collapsed"
                                        Click="BtnAdminPanel_Click"
                                        ToolTip="{DynamicResource UiAdminPanel}" />
                                </StackPanel>

                                <!-- Options Panel (Inline below) -->
                                <Grid x:Name="OverlayToolOptionsPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <Grid.Resources>
                                        <!-- Shared circular color button style -->
                                        <Style x:Key="ColorCircleButton" TargetType="Button">
                                            <Setter Property="Width" Value="16"/>
                                            <Setter Property="Height" Value="16"/>
                                            <Setter Property="Margin" Value="2,0"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <!-- Shared square icon selector style -->
                                        <Style x:Key="IconSelectorButton" TargetType="Button">
                                            <Setter Property="Width" Value="32"/>
                                            <Setter Property="Height" Value="32"/>
                                            <Setter Property="Margin" Value="2"/>
                                            <Setter Property="Padding" Value="3"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Style>

                                         <!-- Custom marker color button style for better UI/UX -->
                                         <Style x:Key="MarkerColorCircleButton" TargetType="Button">
                                             <Setter Property="Width" Value="24"/>
                                             <Setter Property="Height" Value="24"/>
                                             <Setter Property="Margin" Value="3,0"/>
                                             <Setter Property="BorderThickness" Value="1"/>
                                             <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                                             <Setter Property="Cursor" Value="Hand"/>
                                             <Setter Property="Template">
                                                 <Setter.Value>
                                                     <ControlTemplate TargetType="Button">
                                                         <Border Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"/>
                                                     </ControlTemplate>
                                                 </Setter.Value>
                                             </Setter>
                                         </Style>
                                    </Grid.Resources>

                                    <!-- Draw Options -->
                                    <StackPanel x:Name="DrawOptionsPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource Thickness}" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,6,0"/>
                                        <Slider x:Name="SliderDrawThickness" Width="100" Minimum="1" Maximum="20" Value="3" VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderDrawThickness_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=SliderDrawThickness, Path=Value, StringFormat={}{0:F0}px}" Width="35" VerticalAlignment="Center" Foreground="White" FontSize="11" Margin="4,0,10,0"/>
                                        <Rectangle Width="1" Height="14" Fill="#30FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        
                                        <Button Style="{StaticResource ColorCircleButton}" Background="#EF5350" Click="DrawColorButton_Click" Tag="#EF5350"/>
                                        <Button Style="{StaticResource ColorCircleButton}" Background="#66BB6A" Click="DrawColorButton_Click" Tag="#66BB6A"/>
                                        <Button Style="{StaticResource ColorCircleButton}" Background="#42A5F5" Click="DrawColorButton_Click" Tag="#42A5F5"/>
                                        <Button Style="{StaticResource ColorCircleButton}" Background="#FFCA28" Click="DrawColorButton_Click" Tag="#FFCA28"/>
                                        <Button Style="{StaticResource ColorCircleButton}" Background="#FFFFFF" Click="DrawColorButton_Click" Tag="#FFFFFF"/>
                                        <Button Style="{StaticResource ColorCircleButton}" Background="#212121" Click="DrawColorButton_Click" Tag="#212121"/>
                                    </StackPanel>

                                    <!-- Text Options -->
                                    <StackPanel x:Name="TextOptionsPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource UiSize}" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,6,0"/>
                                        <Slider x:Name="SliderTextSize" Width="100" Minimum="10" Maximum="60" Value="16" VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderTextSize_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=SliderTextSize, Path=Value, StringFormat={}{0:F0}pt}" Width="35" VerticalAlignment="Center" Foreground="White" FontSize="11" Margin="4,0,10,0"/>
                                        <Rectangle Width="1" Height="14" Fill="#30FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        
                                        <Button Style="{StaticResource ColorCircleButton}" Background="#FFFFFF" Click="TextColorButton_Click" Tag="#FFFFFF"/>
                                        <Button Style="{StaticResource ColorCircleButton}" Background="#EF5350" Click="TextColorButton_Click" Tag="#EF5350"/>
                                        <Button Style="{StaticResource ColorCircleButton}" Background="#66BB6A" Click="TextColorButton_Click" Tag="#66BB6A"/>
                                        <Button Style="{StaticResource ColorCircleButton}" Background="#42A5F5" Click="TextColorButton_Click" Tag="#42A5F5"/>
                                        <Button Style="{StaticResource ColorCircleButton}" Background="#FFCA28" Click="TextColorButton_Click" Tag="#FFCA28"/>
                                        <Button Style="{StaticResource ColorCircleButton}" Background="#212121" Click="TextColorButton_Click" Tag="#212121"/>
                                    </StackPanel>

                                    <!-- Icon Options -->
                                    <StackPanel x:Name="IconOptionsPanel" Orientation="Vertical" VerticalAlignment="Center" Visibility="Collapsed">
                                         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                             <TextBlock Text="{DynamicResource UiSize}" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,6,0"/>
                                             <Slider x:Name="SliderIconSize" Width="100" Minimum="12" Maximum="64" Value="24" VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderIconSize_ValueChanged"/>
                                             <TextBlock Text="{Binding ElementName=SliderIconSize, Path=Value, StringFormat={}{0:F0}px}" Width="35" VerticalAlignment="Center" Foreground="White" FontSize="11" Margin="4,0,10,0"/>
                                             <Rectangle Width="1" Height="14" Fill="#30FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                             
                                             <Button x:Name="BtnIconBase1" Style="{StaticResource IconSelectorButton}" Click="IconSelection_Click" Tag="pack://application:,,,/Assets/icons/map-icons/base1.png" ToolTip="{DynamicResource UiOwnBaseBlack}">
                                                 <Image Source="pack://application:,,,/Assets/icons/map-icons/base1.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                                             </Button>
                                             <Button x:Name="BtnIconBase2" Style="{StaticResource IconSelectorButton}" Click="IconSelection_Click" Tag="pack://application:,,,/Assets/icons/map-icons/base2.png" ToolTip="{DynamicResource UiEnemyBaseRed}">
                                                 <Image Source="pack://application:,,,/Assets/icons/map-icons/base2.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                                             </Button>
                                             <Button x:Name="BtnIconSam" Style="{StaticResource IconSelectorButton}" Click="IconSelection_Click" Tag="pack://application:,,,/Assets/icons/map-icons/sam-site.png" ToolTip="{DynamicResource UiSAMSite}">
                                                 <Image Source="pack://application:,,,/Assets/icons/map-icons/sam-site.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                                             </Button>
                                             <Button x:Name="BtnIconTurret" Style="{StaticResource IconSelectorButton}" Click="IconSelection_Click" Tag="pack://application:,,,/Assets/icons/map-icons/turret.png" ToolTip="{DynamicResource UiTurret}">
                                                 <Image Source="pack://application:,,,/Assets/icons/map-icons/turret.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                                             </Button>
                                         </StackPanel>

                                         <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                             <TextBlock Text="{DynamicResource UiMarker}" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,6,0"/>
                                             <UniformGrid x:Name="RustMarkerSelectorPanel" Rows="2" Columns="6" Height="72" VerticalAlignment="Center">
                                                 <Button Style="{StaticResource IconSelectorButton}" Click="RustMarkerSelection_Click" Tag="pin" ToolTip="{DynamicResource UiPin}"/>
                                                 <Button Style="{StaticResource IconSelectorButton}" Click="RustMarkerSelection_Click" Tag="dollar" ToolTip="{DynamicResource UiDollar}"/>
                                                 <Button Style="{StaticResource IconSelectorButton}" Click="RustMarkerSelection_Click" Tag="gun" ToolTip="{DynamicResource UiGun}"/>
                                                 <Button Style="{StaticResource IconSelectorButton}" Click="RustMarkerSelection_Click" Tag="home" ToolTip="{DynamicResource UiHome}"/>
                                                 <Button Style="{StaticResource IconSelectorButton}" Click="RustMarkerSelection_Click" Tag="loot" ToolTip="{DynamicResource UiLoot}"/>
                                                 <Button Style="{StaticResource IconSelectorButton}" Click="RustMarkerSelection_Click" Tag="parachute" ToolTip="{DynamicResource UiParachute}"/>
                                                 <Button Style="{StaticResource IconSelectorButton}" Click="RustMarkerSelection_Click" Tag="rock" ToolTip="{DynamicResource UiRock}"/>
                                                 <Button Style="{StaticResource IconSelectorButton}" Click="RustMarkerSelection_Click" Tag="scope" ToolTip="{DynamicResource UiScope}"/>
                                                 <Button Style="{StaticResource IconSelectorButton}" Click="RustMarkerSelection_Click" Tag="shield" ToolTip="{DynamicResource UiShield}"/>
                                                 <Button Style="{StaticResource IconSelectorButton}" Click="RustMarkerSelection_Click" Tag="skull" ToolTip="{DynamicResource UiSkull}"/>
                                                 <Button Style="{StaticResource IconSelectorButton}" Click="RustMarkerSelection_Click" Tag="sleep" ToolTip="{DynamicResource UiSleep}"/>
                                                 <Button Style="{StaticResource IconSelectorButton}" Click="RustMarkerSelection_Click" Tag="zzz" ToolTip="{DynamicResource UiZZZ}"/>
                                             </UniformGrid>
                                             <Rectangle Width="1" Height="56" Fill="#30FFFFFF" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                             <TextBlock Text="{DynamicResource UiColor}" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,6,0"/>
                                             <StackPanel x:Name="RustColorSelectorPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                                 <Button Style="{StaticResource MarkerColorCircleButton}" Background="#CDD054" Click="RustColorSelection_Click" Tag="yellow" ToolTip="{DynamicResource UiYellow}"/>
                                                 <Button Style="{StaticResource MarkerColorCircleButton}" Background="#2F71C4" Click="RustColorSelection_Click" Tag="blue" ToolTip="{DynamicResource UiBlue}"/>
                                                 <Button Style="{StaticResource MarkerColorCircleButton}" Background="#76A739" Click="RustColorSelection_Click" Tag="green" ToolTip="{DynamicResource UiGreen}"/>
                                                 <Button Style="{StaticResource MarkerColorCircleButton}" Background="#BD3838" Click="RustColorSelection_Click" Tag="red" ToolTip="{DynamicResource UiRed}"/>
                                                 <Button Style="{StaticResource MarkerColorCircleButton}" Background="#B65CC4" Click="RustColorSelection_Click" Tag="purple" ToolTip="{DynamicResource UiPurple}"/>
                                                 <Button Style="{StaticResource MarkerColorCircleButton}" Background="#06EDC2" Click="RustColorSelection_Click" Tag="cyan" ToolTip="{DynamicResource UiCyan}"/>
                                             </StackPanel>
                                         </StackPanel>
                                     </StackPanel>

                                    <!-- Eraser Options -->
                                    <StackPanel x:Name="EraserOptionsPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource UiSize}" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,6,0"/>
                                        <Slider x:Name="SliderEraserSize" Width="100" Minimum="5" Maximum="40" Value="20" VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderEraserSize_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=SliderEraserSize, Path=Value, StringFormat={}{0:F0}px}" Width="35" VerticalAlignment="Center" Foreground="White" FontSize="11" Margin="4,0,10,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="OverlayTeamBar"
                            Grid.Row="1"
                            Margin="0,0,0,8"
                            Padding="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Panel.ZIndex="9000"
                            Background="#801E1E1E"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <StackPanel
                                x:Name="OverlayTeamStack"
                                Margin="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <!--  Buttons fÃƒÂ¼r Team-Mitglieder werden dynamisch in CodeBehind eingefÃƒÂ¼gt  -->
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid
                        x:Name="LogPanel"
                        tutorials:Tutorial.TargetId="Diagnostics.Logs"
                        Grid.Row="2"
                        Height="200">
                        <Border
                            Padding="8"
                            Background="#1F2026"
                            BorderBrush="#454953"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        x:Name="TxtLogFilter"
                                        Height="36"
                                        TextChanged="TxtLogFilter_TextChanged" materialDesign:HintAssist.Hint="{DynamicResource UiFilterLogs}" />

                                    <Button
                                        x:Name="BtnToggleLogExpand"
                                        Grid.Column="1"
                                        Height="36"
                                        Margin="6,0,0,0"
                                        Padding="12,0"
                                        Click="BtnToggleLogExpand_Click"
                                        Content="{DynamicResource UiExpand}" />
                                </Grid>

                                <TextBox
                                    x:Name="TxtLog"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <!--  Premium Busy Overlay (Single)  -->
            <Grid
                Panel.ZIndex="9999"
                Background="#AA000000"
                IsHitTestVisible="True"
                Visibility="{Binding IsGlobalBusyOverlayVisible, Converter={StaticResource BoolToVisibility}}">
                <Border
                    Width="340"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="60"
                            Width="48"
                            Height="48"
                            Margin="0,0,0,20"
                            IsIndeterminate="True" />
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{Binding BusyText}"
                            TextAlignment="Center" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextSubtle}"
                            Text="{DynamicResource MayTakeAMoment}"
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Dedicated Login & Pairing Overlay  -->
            <Grid
                Grid.ColumnSpan="3"
                Panel.ZIndex="30000"
                Background="#DD0F1115"
                IsHitTestVisible="True"
                Visibility="{Binding ShowLoginOverlay, Converter={StaticResource BoolToVisibility}}">

                <Border
                    Width="450"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="20">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="50"
                            Opacity="0.5"
                            ShadowDepth="0"
                            Color="Black" />
                    </Border.Effect>

                    <StackPanel>
                        <!--  Icon / Brand  -->
                        <Border
                            Width="80"
                            Height="80"
                            Margin="0,0,0,24"
                            Background="{DynamicResource AccentDark}"
                            CornerRadius="40">
                            <materialDesign:PackIcon
                                FontSize="40"
                                Foreground="{DynamicResource Accent}"
                                 Kind="ShieldLock"  />
                        </Border>

                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{DynamicResource UiConnectRustCompanion}"
                            TextAlignment="Center" />

                        <TextBlock
                            Margin="0,0,0,32"
                            FontSize="14"
                            Foreground="{DynamicResource TextSubtle}"
                            LineHeight="20"
                            Text="{DynamicResource UiThisConnectionIsForTheRustCompanionAPIItEnablesFCMPairingIE31DB5764D}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="TxtLoginOverlayMessage"
                            Margin="0,-16,0,24"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#FFFF4B4B"
                            Text="{Binding LoginOverlayMessage}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasLoginOverlayMessage, Converter={StaticResource Vis}}" />

                        <Button
                            x:Name="BtnOverlayPair"
                            Height="50"
                            HorizontalAlignment="Stretch"
                            Click="BtnOverlayPair_Click"
                            FontSize="16"
                            FontWeight="SemiBold">
                            <Button.Content>
                                <TextBlock Margin="8,0,0,0" Text="{DynamicResource UiConnectRustCompanion}" />
                            </Button.Content>
                        </Button>

                        <Button
                            x:Name="BtnOverlayRestore"
                            Height="40"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Stretch"
                            Click="BtnOverlayRestore_Click"
                            FontSize="14">
                            <Button.Content>
                                <TextBlock Margin="8,0,0,0" Text="{DynamicResource UiRestoreLocalBackup}" />
                            </Button.Content>
                        </Button>

                        <Button
                            x:Name="BtnOverlayFcmInfo"
                            Height="36"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Stretch"
                            Click="BtnFcmInfo_Click"
                            FontSize="13"
                            ToolTip="{DynamicResource FcmInfoToolTip}">
                            <Button.Content>
                                <TextBlock Margin="8,0,0,0" Text="{DynamicResource FcmInfoToolTip}" />
                            </Button.Content>
                        </Button>

                        <TextBlock
                            Margin="0,20,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextCaption}"
                            Text="{DynamicResource UiUsesYourRustSteamLoginInTheBrowserCloudSignInIsNotRequired}"
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Raid Calculator Overlay  -->
            <Border
                x:Name="RaidCalculatorPanel"
                Grid.ColumnSpan="3"
                Padding="12"
                Background="{DynamicResource AppBg}"
                Panel.ZIndex="9000"
                Visibility="Collapsed">
                <views:RaidCalculatorView CloseRequested="RaidCalculator_CloseRequested" />
            </Border>

            <!--  Genetics Lab Overlay  -->
            <Border
                x:Name="GeneticsLabPanel"
                Grid.ColumnSpan="3"
                Padding="12"
                Background="{DynamicResource AppBg}"
                Panel.ZIndex="9000"
                Visibility="Collapsed">
                <views:GeneticsLabTabContent x:Name="GeneticsLabTabControl" CloseRequested="GeneticsLab_CloseRequested" />
            </Border>

            <!--  Delete Confirmation Overlay  -->
            <Grid
                x:Name="DeleteConfirmationOverlay"
                Panel.ZIndex="10000"
                Background="#AA000000"
                IsHitTestVisible="True"
                Visibility="Collapsed">
                <Border
                    Width="400"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <StackPanel>
                        <!--  Header with Icon  -->
                        <Grid Margin="0,0,0,24">
                            <Ellipse
                                Width="64"
                                Height="64"
                                Fill="#26FF4B4B" />
                            <materialDesign:PackIcon
                                FontSize="32"
                                Foreground="#FFFF4B4B"
                                 Kind="Delete"  />
                        </Grid>

                        <TextBlock
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{DynamicResource DeleteServerHeader}"
                            TextAlignment="Center" />

                        <TextBlock
                            x:Name="TxtDeleteConfirmation"
                            Margin="0,12,0,32"
                            FontSize="14"
                            LineHeight="20"
                            Foreground="{DynamicResource TextSubtle}"
                            Text="{DynamicResource DeleteServerConfirm}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Padding="12"
                                HorizontalAlignment="Stretch"
                                Click="BtnCancelDelete_Click"
                                Content="{DynamicResource Cancel}" />

                            <Button
                                Grid.Column="2"
                                Padding="12"
                                HorizontalAlignment="Stretch"
                                Background="#FFFF4B4B"
                                BorderBrush="#FFFF4B4B"
                                Click="BtnConfirmDelete_Click"
                                Content="{DynamicResource DeleteAction}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Custom Smart Alarm Overlay  -->
            <Border
                x:Name="AlarmOverlayBorder"
                Grid.ColumnSpan="3"
                Margin="20,20,20,130"
                Padding="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#EE660000"
                BorderBrush="#FFFF5555"
                BorderThickness="1"
                CornerRadius="8"
                Panel.ZIndex="9998"
                Visibility="Collapsed"
                Width="360">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.3" ShadowDepth="2" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="18" Height="18" Margin="0,0,8,0" Source="pack://application:,,,/Assets/icons/smartalarm.png" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{DynamicResource SmartAlarm}" />

                        <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button x:Name="AlarmOverlayPrevBtn" Padding="4" Click="AlarmOverlayPrev_Click" />
                            <TextBlock x:Name="AlarmOverlayPagingTxt" Margin="6,0" VerticalAlignment="Center" Text="1/1" />
                            <Button x:Name="AlarmOverlayNextBtn" Padding="4" Click="AlarmOverlayNext_Click" />
                        </StackPanel>

                        <Button Grid.Column="3" Padding="4" Click="AlarmOverlayClose_Click" />
                    </Grid>

                    <TextBlock x:Name="AlarmOverlayServerTxt" Grid.Row="1" Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{DynamicResource UiServerName1430}" />
                    <TextBlock x:Name="AlarmOverlayNameTxt" Grid.Row="2" Margin="0,0,0,2" FontSize="16" FontWeight="Bold" Text="{DynamicResource UiCustomAlarmName}" TextWrapping="Wrap" />
                    <TextBlock x:Name="AlarmOverlayMsgTxt" Grid.Row="3" Margin="0,0,0,12" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{DynamicResource AlarmActivated}" TextWrapping="Wrap" />

                    <CheckBox x:Name="AlarmOverlayAutoHideChk" Grid.Row="4" Content="{DynamicResource AutoHideAfter3s}" FontSize="12" IsChecked="False" Checked="AlarmOverlayAutoHideChk_Changed" Unchecked="AlarmOverlayAutoHideChk_Changed" PreviewMouseLeftButtonDown="OnAutoHideCheckBoxClick"/>
                </Grid>
            </Border>

            <!-- Upload Consent Overlay -->
            <Grid x:Name="UploadConsentOverlay" Visibility="Collapsed" Background="#C0000000" Grid.ColumnSpan="3" Panel.ZIndex="10000">
                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="450">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource UploadConsentTitle}" FontWeight="Bold" FontSize="18" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource UploadConsentText}" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Decline}" Margin="0,0,8,0" Padding="16,6" Click="BtnDeclineUploadConsent_Click" Background="#404040" Foreground="White" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="{DynamicResource Accept}" Padding="24,6" Click="BtnAcceptUploadConsent_Click" Cursor="Hand" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Server Info Backdrop Overlay -->
            <Grid x:Name="ServerInfoBackdrop"
                  Grid.ColumnSpan="3"
                  Background="#990D0E11"
                  Visibility="Collapsed"
                  Panel.ZIndex="9990"
                  MouseLeftButtonDown="ServerInfoBackdrop_MouseLeftButtonDown" />

            <tutorialViews:TutorialsPage
                x:Name="TutorialsPagePanel"
                Grid.ColumnSpan="3"
                Panel.ZIndex="18000"
                Visibility="Collapsed" />

            <tutorialControls:TutorialOverlay
                x:Name="TutorialOverlay"
                Grid.ColumnSpan="3"
                Panel.ZIndex="20000" />

            <!--  Material Design snackbar hosts (driven by Helpers/MaterialSnackbar)  -->
            <materialDesign:Snackbar
                x:Name="RootSnackbar"
                Grid.ColumnSpan="3"
                Margin="20,0,20,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                MaxWidth="550"
                Panel.ZIndex="9999" />

            <materialDesign:Snackbar
                x:Name="GuideSnackbar"
                Grid.ColumnSpan="3"
                Margin="20,0,20,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                MaxWidth="420"
                Panel.ZIndex="9998" />

        </Grid>
    </Grid>
</Window>





