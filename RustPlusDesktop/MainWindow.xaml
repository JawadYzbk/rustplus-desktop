                                                                <materialDesign:PackIcon  Kind="Close" FontSize="12" Foreground="#FF8A00" Margin="0,0,4,0"  />
                                                                <TextBlock Text="{DynamicResource Clear}" FontSize="11" FontWeight="SemiBold" Foreground="#FF8A00" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <!-- ── ROW 1: BENTO CATEGORY GRID ── -->
                                                    <ScrollViewer Grid.Row="1" Margin="14,10,14,14" VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1*" />
                                                                <ColumnDefinition Width="1*" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- ──── LEFT COLUMN ──── -->

                                                            <!-- Resources & Forestry -->
                                                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CategoryCard}" Margin="0,0,6,8">
                                                                <StackPanel>
                                                                    <TextBlock FontSize="14" Foreground="#9AA4B6" Margin="6,6,0,8">
    <Run Text="⛏" /><Run Text="{DynamicResource UiResourcesForestry}" FontSize="11" />
</TextBlock>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border x:Name="Bento_ores" Grid.Column="0" Style="{StaticResource HeatmapTileContainer}">
                                                                            <Button Tag="ores" ToolTip="{DynamicResource UiOres}" Style="{StaticResource HeatmapTileButton}"
