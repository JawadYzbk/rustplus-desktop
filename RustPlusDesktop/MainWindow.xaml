                                        <TextBox
                                            x:Name="TxtDeviceFilter"
                                            tutorials:Tutorial.TargetId="Devices.Search"
                                            Grid.Column="0"
                                            Height="30"
                                            Margin="0,0,8,0"
                                            Padding="8,3"
                                            FontSize="11" materialDesign:HintAssist.Hint="{DynamicResource UiSearchDevices}" />

                                        <ComboBox
                                            x:Name="CmbDeviceTypeFilter"
                                            tutorials:Tutorial.TargetId="Devices.TypeFilter"
                                            Grid.Column="1"
                                            Height="30"
                                            FontSize="11"
                                            SelectedIndex="0">
                                            <ComboBoxItem Content="{DynamicResource NotificationsAll}" Tag="all" />
                                            <ComboBoxItem Content="{DynamicResource UiSwitch}" Tag="switch" />
                                            <ComboBoxItem Content="{DynamicResource UiAlarm}" Tag="alarm" />
                                            <ComboBoxItem Content="{DynamicResource UiStorage}" Tag="storage" />
                                        </ComboBox>
                                    </Grid>

                                    <TreeView
                                        x:Name="ListDevices"
                                        tutorials:Tutorial.TargetId="Devices.List"
                                        Grid.Row="1"
                                        Margin="-20,0,-20,0"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{Binding CurrentDevices}"
                                        ScrollViewer.CanContentScroll="False"
                                        SelectedItemChanged="ListDevices_SelectedItemChanged"
                                        VirtualizingPanel.IsVirtualizing="False"
                                        VirtualizingPanel.ScrollUnit="Pixel">

                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="AllowDrop" Value="True" />
                                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeViewItem_PreviewMouseLeftButtonDown" />
                                                <EventSetter Event="PreviewMouseMove" Handler="TreeViewItem_PreviewMouseMove" />
                                                <EventSetter Event="DragEnter" Handler="TreeViewItem_DragEnter" />
                                                <EventSetter Event="DragOver" Handler="TreeViewItem_DragOver" />
                                                <EventSetter Event="DragLeave" Handler="TreeViewItem_DragLeave" />
                                                <EventSetter Event="Drop" Handler="TreeViewItem_Drop" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Visibility">
                                                    <Setter.Value>
                                                        <MultiBinding Converter="{StaticResource DeviceFilterVisibilityConverter}">
                                                            <Binding />
                                                            <Binding ElementName="TxtDeviceFilter" Path="Text" />
                                                            <Binding ElementName="CmbDeviceTypeFilter" Path="SelectedItem.Tag" />
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Resources>
                                                    <!-- Nullify default highlight brushes so our card layout handles highlights -->
                                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F2F2F2" />
                                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F2F2F2" />
                                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
                                                </Style.Resources>
                                            </Style>
                                        </TreeView.ItemContainerStyle>

                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <HierarchicalDataTemplate.Resources>
                                                    <!-- Custom style for borderless checkboxes that behave like WinUI toggle buttons -->
                                                    <Style x:Key="DeviceActionCheckBox" TargetType="CheckBox">
                                                        <Setter Property="Width" Value="28"/>
                                                        <Setter Property="Height" Value="28"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="CheckBox">
                                                                    <Border x:Name="Bd"
                                                                            Background="Transparent"
                                                                            BorderBrush="Transparent"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            SnapsToDevicePixels="True">
                                                                        <ContentPresenter x:Name="Content"
                                                                                          HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"
                                                                                          Opacity="0.6"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#1F60CDFF"/>
                                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                            <Setter TargetName="Content" Property="Opacity" Value="1.0"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </HierarchicalDataTemplate.Resources>

                                                <!--  Row + Details teilen sich den gleichen DataContext (SmartDevice)  -->
                                                <StackPanel Margin="0,2,0,0">

                                                    <!--  ===== Zeile =====  -->
                                                    <Border
                                                        x:Name="DeviceRowCard"
                                                        tutorials:Tutorial.TargetId="Devices.Item.FirstAvailable"
                                                        Margin="0,2,0,2"
                                                        Padding="8,7"
                                                        CornerRadius="8"
                                                        HorizontalAlignment="Left">
                                                        <Border.ContextMenu>
                                                            <ContextMenu Opened="DeviceContextMenu_Opened"
                                                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                                         Style="{StaticResource DarkContextMenu}">
                                                                <MenuItem Click="Device_Rename_Click" Header="{DynamicResource RenameDevice}" />
                                                                <MenuItem x:Name="MenuSetSmallOilRig" Click="Device_SetSmallOilRig_Click" Header="{DynamicResource UiSetAsSmallOilRigTrigger}" />
                                                                <MenuItem x:Name="MenuSetLargeOilRig" Click="Device_SetLargeOilRig_Click" Header="{DynamicResource UiSetAsLargeOilRigTrigger}" />
                                                                <MenuItem x:Name="MenuEditAlarmTitle" Click="Device_EditAlarmTitle_Click" Header="{DynamicResource UiInGameAlarmTitle}">
                                                                    <MenuItem.Style>
                                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="SmartAlarm">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </MenuItem.Style>
                                                                </MenuItem>
                                                                <MenuItem Click="SwitchCommand_Edit_Click" Header="{DynamicResource UiChangeCommand}">
                                                                    <MenuItem.Style>
                                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="SmartSwitch">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="Smart Switch">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </MenuItem.Style>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource DeviceTreeItemWidthConverter}" ConverterParameter="36,26,220">
                                                                <Binding ElementName="ListDevices" Path="ActualWidth" />
                                                                <Binding RelativeSource="{RelativeSource AncestorType=TreeViewItem}" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Surface}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
                                                                        <Setter Property="BorderBrush" Value="#40FFFFFF" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.65" />
                                                                        <Setter Property="Background" Value="#121418" />
                                                                        <Setter Property="BorderBrush" Value="#1EFFFFFF" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                        <Setter Property="Background" Value="#14223C" />
                                                                        <Setter Property="BorderBrush" Value="#253A5A" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag}" Value="DropInto">
                                                                        <Setter Property="Background" Value="#263B5B" />
                                                                        <Setter Property="BorderBrush" Value="#FF60CDFF" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#1F60CDFF" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True" />
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Background" Value="#2D60CDFF" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Selection Indicator Line -->
                                                            <Border x:Name="SelectedLine" 
                                                                    Grid.ColumnSpan="3"
                                                                    Width="3" 
                                                                    HorizontalAlignment="Left" 
                                                                    Background="{DynamicResource Accent}" 
                                                                    CornerRadius="1.5" 
                                                                    Margin="-12,-8,0,-8">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>

                                                            <Border
                                                                x:Name="DropIntoOverlay"
                                                                Grid.ColumnSpan="3"
                                                                Margin="-6,-5,-6,-5"
                                                                Background="#1660CDFF"
                                                                BorderBrush="#AA60CDFF"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                IsHitTestVisible="False">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag}" Value="DropInto">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>

                                                            <Border
                                                                x:Name="DropBeforeRail"
                                                                Grid.ColumnSpan="3"
                                                                Height="3"
                                                                Margin="-8,-11,-8,0"
                                                                VerticalAlignment="Top"
                                                                Background="{DynamicResource Accent}"
                                                                CornerRadius="2"
                                                                IsHitTestVisible="False">
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="10" Color="#60CDFF" Opacity="0.8" ShadowDepth="0" />
                                                                </Border.Effect>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag}" Value="DropBefore">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>

                                                            <Border
                                                                x:Name="DropAfterRail"
                                                                Grid.ColumnSpan="3"
                                                                Height="3"
                                                                Margin="-8,0,-8,-11"
                                                                VerticalAlignment="Bottom"
                                                                Background="{DynamicResource Accent}"
                                                                CornerRadius="2"
                                                                IsHitTestVisible="False">
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="10" Color="#60CDFF" Opacity="0.8" ShadowDepth="0" />
                                                                </Border.Effect>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag}" Value="DropAfter">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>

                                                            <!--  Spalte 1: Icon  -->
                                                            <Border Grid.Column="0"
                                                                    x:Name="IconBorder"
                                                                    Width="36"
                                                                    Height="36"
                                                                    Background="#35FFFFFF"
                                                                    CornerRadius="8"
                                                                    Padding="0"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Cursor="Hand"
                                                                    ToolTip="{DynamicResource UiChangeIcon}"
                                                                    PreviewMouseLeftButtonDown="DeviceIcon_PreviewMouseLeftButtonDown">
                                                                <Grid>
                                                                        <Image
                                                                            x:Name="DeviceIconImg"
                                                                            Width="28"
                                                                            Height="28"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        RenderOptions.BitmapScalingMode="HighQuality">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Source" Value="{Binding CustomIcon}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding CustomIcon}" Value="{x:Null}">
                                                                                        <Setter Property="Source" Value="{StaticResource IconSmartSwitch}" />
                                                                                    </DataTrigger>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding CustomIcon}" Value="{x:Null}"/>
                                                                                            <Condition Binding="{Binding Kind}" Value="StorageMonitor"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Source" Value="{StaticResource IconStorageMonitor}"/>
                                                                                    </MultiDataTrigger>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding CustomIcon}" Value="{x:Null}"/>
                                                                                            <Condition Binding="{Binding Kind}" Value="Storage Monitor"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Source" Value="{StaticResource IconStorageMonitor}"/>
                                                                                    </MultiDataTrigger>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding CustomIcon}" Value="{x:Null}"/>
                                                                                            <Condition Binding="{Binding Kind}" Value="SmartAlarm"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Source" Value="{StaticResource IconSmartAlarm}"/>
                                                                                    </MultiDataTrigger>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding CustomIcon}" Value="{x:Null}"/>
                                                                                            <Condition Binding="{Binding Kind}" Value="Smart Alarm"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Source" Value="{StaticResource IconSmartAlarm}"/>
                                                                                    </MultiDataTrigger>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding CustomIcon}" Value="{x:Null}"/>
                                                                                            <Condition Binding="{Binding IsGroup}" Value="True"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Source" Value="{StaticResource IconGroup}"/>
                                                                                    </MultiDataTrigger>
                                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                                                                        <Setter Property="Opacity" Value="0.15"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                    
                                                                    <materialDesign:PackIcon
                                                                        x:Name="EditIcon"
                                                                         Kind="Pencil"
                                                                        Foreground="White"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                        <materialDesign:PackIcon.Style>
                                                                            <Style TargetType="materialDesign:PackIcon">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </materialDesign:PackIcon.Style>
                                                                    </materialDesign:PackIcon>

                                                                </Grid>
                                                            </Border>

                                                            <!--  Spalte 2: strukturierte Device-Infos  -->
                                                            <Grid
                                                                Grid.Column="1"
                                                                MinWidth="0"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <Grid Grid.Row="0" MinWidth="0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" MinWidth="0" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <!--  Oil rig trigger: this alarm's own notifications are suppressed  -->
                                                                    <Border
                                                                        Grid.Column="2"
                                                                        Margin="6,0,0,0"
                                                                        Padding="5,1"
                                                                        CornerRadius="3"
                                                                        Background="#302E9BD6"
                                                                        BorderBrush="#602E9BD6"
                                                                        BorderThickness="1"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip="{DynamicResource UiBadgeOilRigTooltip}"
                                                                        Visibility="{Binding HasOilRigBadge, Converter={StaticResource Vis}}">
                                                                        <TextBlock
                                                                            Text="{Binding OilRigBadge}"
                                                                            FontSize="10"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="#7FD3FF" />
                                                                    </Border>
                                                                    <materialDesign:PackIcon
                                                                        Grid.Column="0"
                                                                         Kind="Alert"
                                                                        Foreground="#F04747"
                                                                        Margin="0,0,6,0"
                                                                        VerticalAlignment="Center">
                                                                        <materialDesign:PackIcon.Style>
                                                                            <Style TargetType="materialDesign:PackIcon">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </materialDesign:PackIcon.Style>
                                                                    </materialDesign:PackIcon>
                                                                    <Grid Grid.Column="1" MinWidth="0" VerticalAlignment="Center">
                                                                        <TextBlock
                                                                            x:Name="TxtDeviceNameView"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="12"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{DynamicResource TextPrimary}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            Text="{Binding PureName, TargetNullValue=Device}"
                                                                            ToolTip="{DynamicResource RightClickRename}"
                                                                            MouseLeftButtonDown="DeviceName_MouseLeftButtonDown">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
                                                                                            <Setter Property="FontStyle" Value="Italic" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        
                                                                        <TextBox
                                                                            x:Name="TxtDeviceNameEdit"
                                                                            Text="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                                            FontSize="12"
                                                                            Height="24"
                                                                            Padding="4,2"
                                                                            VerticalAlignment="Center"
                                                                            MinWidth="80"
                                                                            MaxWidth="260"
                                                                            LostFocus="TxtRename_LostFocus"
                                                                            KeyDown="TxtRename_KeyDown"
                                                                            IsVisibleChanged="TxtRename_IsVisibleChanged">
                                                                            <TextBox.Style>
                                                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBox.Style>
                                                                        </TextBox>
                                                                    </Grid>
                                                                </Grid>

                                                                <WrapPanel Grid.Row="1"
                                                                           Margin="0,3,0,0"
                                                                           Orientation="Horizontal">
                                                                    <TextBlock
                                                                        Margin="0,2,8,0"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="10"
                                                                        Foreground="{DynamicResource TextSubtle}"
                                                                        Text="{Binding EntityId, StringFormat=#\{0\}}" />

                                                                    <Border
                                                                    Margin="0,0,6,0"
                                                                    Padding="7,2"
                                                                    VerticalAlignment="Center"
                                                                    CornerRadius="7"
                                                                    BorderThickness="1">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#1AFFFFFF" />
                                                                            <Setter Property="BorderBrush" Value="#1EFFFFFF" />
                                                                            <Style.Triggers>
                                                                                <!--  ON / ACTIVE / ONLINE Status (GrÃ¼n)  -->
                                                                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                                    <Setter Property="Background" Value="#1A4EB887" />
                                                                                    <Setter Property="BorderBrush" Value="#334EB887" />
                                                                                </DataTrigger>

                                                                                <!--  Storage Monitor & Others: Immer grÃ¼n wenn da  -->
                                                                                <DataTrigger Binding="{Binding Kind}" Value="StorageMonitor">
                                                                                    <Setter Property="Background" Value="#1A4EB887" />
                                                                                    <Setter Property="BorderBrush" Value="#334EB887" />
                                                                                </DataTrigger>

                                                                                <!--  MISSING / DISCONNECTED (Rot)  -->
                                                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                                    <Setter Property="Background" Value="#1AF04747" />
                                                                                    <Setter Property="BorderBrush" Value="#33F04747" />
                                                                                </DataTrigger>
                                                                                
                                                                                <!--  Group  -->
                                                                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                                    <Setter Property="Background" Value="#1A60CDFF" />
                                                                                    <Setter Property="BorderBrush" Value="#3360CDFF" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>

                                                                    <TextBlock
                                                                        FontSize="9"
                                                                        FontWeight="SemiBold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="{DynamicResource Online}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
                                                                                <Style.Triggers>
                                                                                    <!--  ON Status colors (GrÃ¼n)  -->
                                                                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                                        <Setter Property="Foreground" Value="#4EB887" />
                                                                                    </DataTrigger>
                                                                                    <!--  Storage Monitor color  -->
                                                                                    <DataTrigger Binding="{Binding Kind}" Value="StorageMonitor">
                                                                                        <Setter Property="Foreground" Value="#4EB887" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Kind}" Value="Storage Monitor">
                                                                                        <Setter Property="Foreground" Value="#4EB887" />
                                                                                    </DataTrigger>

                                                                                    <!--  MISSING  -->
                                                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                                        <Setter Property="Text" Value="{DynamicResource Offline}" />
                                                                                        <Setter Property="Foreground" Value="#F04747" />
                                                                                    </DataTrigger>

